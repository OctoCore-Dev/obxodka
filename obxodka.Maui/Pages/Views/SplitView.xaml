<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.SplitView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:obxodka.Client.Models;assembly=obxodka.Client"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:views="clr-namespace:obxodka.Views"
    x:Name="ThisView">

    <Grid
        Padding="{OnIdiom Desktop='32,24',
                          Default='16,16'}"
        RowDefinitions="Auto, *"
        RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label
                FontFamily="CommissionerExtraBold"
                FontSize="{OnIdiom Desktop=20,
                                   Default=22}"
                HorizontalOptions="Center"
                Text="Разделение трафика"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                            Dark={StaticResource TextPrimary}}" />

            <Border Padding="10,4" Style="{StaticResource NeoInput}">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                    <mi:MauiIcon
                        Grid.Column="0"
                        Icon="{mi:Fluent Icon=Search24}"
                        IconColor="{AppThemeBinding Light=#9CA3AF,
                                                    Dark=#6B7280}"
                        IconSize="18"
                        VerticalOptions="Center" />
                    <Entry
                        x:Name="SplitSearchEntry"
                        Grid.Column="1"
                        FontSize="13"
                        Placeholder="Поиск по названию или пакету..."
                        TextChanged="OnSplitSearchTextChanged" />
                    <Border
                        x:Name="ClearSearchBtn"
                        Grid.Column="2"
                        Padding="4"
                        IsVisible="False"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearSearchClicked" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon
                            Icon="{mi:Fluent Icon=Dismiss24}"
                            IconColor="{AppThemeBinding Light=#9CA3AF,
                                                        Dark=#6B7280}"
                            IconSize="16" />
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="8">
                <Border
                    x:Name="ChipFilterAll"
                    Grid.Column="0"
                    Padding="8,6"
                    BackgroundColor="{AppThemeBinding Light=#207C3AED,
                                                      Dark=#307C3AED}"
                    Stroke="#7C3AED"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterAllClicked" />
                    </Border.GestureRecognizers>
                    <Label
                        x:Name="FilterAllLabel"
                        FontFamily="RobotoBold"
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Все"
                        TextColor="{AppThemeBinding Light=#7C3AED,
                                                    Dark=#9F6FF0}" />
                </Border>

                <Border
                    x:Name="ChipFilterBypassed"
                    Grid.Column="1"
                    Padding="8,6"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BgSurfaceLight},
                                                      Dark={StaticResource BgSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight},
                                             Dark={StaticResource BorderSubtle}}"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterBypassedClicked" />
                    </Border.GestureRecognizers>
                    <Label
                        x:Name="FilterBypassedLabel"
                        FontFamily="RobotoBold"
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="В обходе (0)"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                    Dark={StaticResource TextSecondary}}" />
                </Border>

                <Border
                    x:Name="ChipResetAll"
                    Grid.Column="2"
                    Padding="10,6"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BgSurfaceLight},
                                                      Dark={StaticResource BgSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight},
                                             Dark={StaticResource BorderSubtle}}"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnResetAllBypassedClickedAsync" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="RobotoMedium"
                        FontSize="11"
                        Text="Сброс"
                        TextColor="#EF4444" />
                </Border>
            </Grid>

            <VerticalStackLayout
                x:Name="ActiveBypassedSection"
                Margin="0,4,0,0"
                IsVisible="False"
                Spacing="6">
                <Grid ColumnDefinitions="*, Auto">
                    <Label
                        Grid.Column="0"
                        FontFamily="RobotoBold"
                        FontSize="11"
                        Text="ВКЛЮЧЕННЫЕ В ОБХОД (БЫСТРОЕ ОТКЛЮЧЕНИЕ)"
                        TextColor="{StaticResource Primary}" />
                    <Label
                        x:Name="ActiveBypassedCountLabel"
                        Grid.Column="1"
                        FontSize="11"
                        Style="{StaticResource LabelMuted}" />
                </Grid>

                <ScrollView
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal"
                    VerticalScrollBarVisibility="Never">
                    <HorizontalStackLayout
                        x:Name="ActiveBypassedChipsLayout"
                        Margin="0,2,0,4"
                        Spacing="8" />
                </ScrollView>
            </VerticalStackLayout>

            <Border
                Margin="0,2,0,0"
                Padding="10,8"
                BackgroundColor="#2D1A1A"
                Stroke="#EF4444"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    Text="Изменение списка возможно только при выключенном VPN."
                    TextColor="#FCA5A5"
                    VerticalTextAlignment="Center" />
                <Border.Triggers>
                    <DataTrigger
                        Binding="{Binding IsSplitEditingAllowed, Source={x:Reference ThisView}, x:DataType=views:SplitView}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <ActivityIndicator
                x:Name="SplitLoadingOverlay"
                HorizontalOptions="Center"
                IsRunning="True"
                IsVisible="False"
                VerticalOptions="Center" />

            <Label
                x:Name="SplitAppsErrorLabel"
                HorizontalOptions="Center"
                IsVisible="False"
                Opacity="0"
                Style="{StaticResource LabelError}"
                VerticalOptions="Center" />

            <CollectionView
                x:Name="SplitAppsList"
                ItemSizingStrategy="MeasureFirstItem"
                VerticalScrollBarVisibility="Never">
                <CollectionView.Footer>
                    <ContentView HeightRequest="{OnIdiom Phone=110, Default=32}" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:AppInfoItem">
                        <Grid
                            Margin="0,2"
                            Padding="14,8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BgSurfaceLight},
                                                              Dark={StaticResource BgSurface}}"
                            ColumnDefinitions="38, *, Auto"
                            ColumnSpacing="12"
                            HeightRequest="62">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAppRowTapped" />
                            </Grid.GestureRecognizers>

                            <Image
                                Grid.Column="0"
                                Aspect="AspectFit"
                                HeightRequest="36"
                                HorizontalOptions="Center"
                                Source="{Binding IconSource}"
                                VerticalOptions="Center"
                                WidthRequest="36" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="RobotoBold"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Name}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                Dark={StaticResource TextPrimary}}" />
                                <Label
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    Style="{StaticResource LabelMuted}"
                                    Text="{Binding PackageName}" />
                            </VerticalStackLayout>

                            <Switch
                                Grid.Column="2"
                                IsEnabled="{Binding IsSplitEditingAllowed, Source={x:Reference ThisView}, x:DataType=views:SplitView}"
                                IsToggled="{Binding IsBypassed, Mode=TwoWay}"
                                Toggled="OnSplitAppToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>
</ContentView>
