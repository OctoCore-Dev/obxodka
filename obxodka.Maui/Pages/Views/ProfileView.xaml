<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:views="clr-namespace:obxodka.Views"
    x:Name="ThisProfileView">
    <Grid
        x:Name="RootLayoutGrid"
        Padding="{OnIdiom Desktop='32,28',
                          Phone='16,20,16,0',
                          Default='16,20'}"
        SafeAreaEdges="None">
        <ScrollView
            x:Name="ProfileScrollView"
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never"
            Orientation="Vertical"
            VerticalScrollBarVisibility="Never">
            <Grid
                x:Name="ContentGrid"
                Padding="{OnIdiom Desktop='0',
                                  Phone='0,0,0,140',
                                  Default='0'}"
                ColumnDefinitions="{OnIdiom Desktop='*, *',
                                            Default='*'}"
                ColumnSpacing="28"
                HorizontalOptions="Start"
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                RowSpacing="20"
                VerticalOptions="Start">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="{OnIdiom Desktop='2',
                                              Default='1'}"
                    Margin="0,0,0,4"
                    FontFamily="{DynamicResource AppFontBold}"
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="Профиль" />

                <Border
                    x:Name="CardProfile"
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="20"
                    Style="{StaticResource NeoCard}"
                    VerticalOptions="Fill">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16">
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource PrimaryDim}"
                            HeightRequest="56"
                            StrokeShape="RoundRectangle 28"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="56">
                            <mi:MauiIcon
                                HorizontalOptions="Center"
                                Icon="{mi:Fluent Icon=Person24}"
                                IconColor="{DynamicResource Primary}"
                                IconSize="28"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4"
                            VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Image
                                    x:Name="ProfileProviderIcon"
                                    HeightRequest="14"
                                    Source="google_logo.png"
                                    VerticalOptions="Center"
                                    WidthRequest="14" />
                                <Label
                                    x:Name="ProfileProviderLabel"
                                    CharacterSpacing="1"
                                    FontSize="10"
                                    Style="{StaticResource LabelMuted}"
                                    Text="GOOGLE АККАУНТ"
                                    TextTransform="Uppercase"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label
                                x:Name="ProfileEmailLabel"
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="16"
                                LineBreakMode="TailTruncation"
                                Text="email@example.com" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border
                    x:Name="CardAdBlock"
                    Grid.Row="{OnIdiom Desktop='2',
                                       Default='3'}"
                    Grid.Column="0"
                    Grid.ColumnSpan="{OnIdiom Desktop='2',
                                              Default='1'}"
                    Padding="16"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Shield24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="24"
                                VerticalOptions="Center" />
                            <Grid
                                Grid.Column="1"
                                Margin="12,0"
                                RowDefinitions="Auto, Auto"
                                RowSpacing="4"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Row="0"
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="15"
                                    Text="Блокировка рекламы" />
                                <Label
                                    Grid.Row="1"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Использовать DNS AdGuard для блокировки рекламы и трекеров" />
                            </Grid>
                            <Switch
                                x:Name="AdBlockSwitch"
                                Grid.Column="2"
                                Toggled="OnAdBlockToggled"
                                VerticalOptions="Center">
                                <Switch.IsEnabled>
                                    <Binding
                                        x:DataType="views:ProfileView"
                                        Path="IsEditingAllowed"
                                        Source="{x:Reference ThisProfileView}" />
                                </Switch.IsEnabled>
                            </Switch>
                        </Grid>

                        <Border Margin="0,8,0,0" Style="{StaticResource WarningBanner}">
                            <Label
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="Изменение настройки возможно только при выключенном VPN."
                                TextColor="{DynamicResource Error}"
                                VerticalTextAlignment="Center" />
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsEditingAllowed, Source={x:Reference ThisProfileView}, x:DataType=views:ProfileView}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </VerticalStackLayout>
                </Border>
                <Border
                    x:Name="CardBalance"
                    Grid.Row="{OnIdiom Desktop='1',
                                       Default='2'}"
                    Grid.Column="{OnIdiom Desktop='1',
                                          Default='0'}"
                    Padding="20"
                    Style="{StaticResource NeoCard}"
                    VerticalOptions="Fill">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <Grid
                            Grid.Column="0"
                            ColumnDefinitions="Auto, Auto"
                            ColumnSpacing="24"
                            VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    FontSize="10"
                                    Style="{StaticResource LabelMuted}"
                                    Text="БАЛАНС" />
                                <Label
                                    x:Name="ProfileTokenLabel"
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="18"
                                    Text="0ч 00м"
                                    TextColor="{DynamicResource Accent}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                x:Name="SubscriptionContainer"
                                Grid.Column="1"
                                Spacing="2">
                                <Label
                                    FontSize="10"
                                    Style="{StaticResource LabelMuted}"
                                    Text="ПОДПИСКА" />
                                <Label
                                    x:Name="ProfileSubLabel"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="до 01.01.2026"
                                    TextColor="{DynamicResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button
                            Grid.Column="1"
                            Clicked="OnBuyTokensClicked"
                            HeightRequest="40"
                            Text="Пополнить"
                            VerticalOptions="Center"
                            WidthRequest="110" />
                    </Grid>
                </Border>

                <Border
                    x:Name="CardTelemetry"
                    Grid.Row="{OnIdiom Desktop='3',
                                       Default='4'}"
                    Grid.Column="0"
                    Grid.ColumnSpan="{OnIdiom Desktop='2',
                                              Default='1'}"
                    Padding="16"
                    Style="{StaticResource NeoCard}"
                    VerticalOptions="Start">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=DataUsage24}"
                            IconColor="{DynamicResource Accent}"
                            IconSize="24"
                            VerticalOptions="Center" />
                        <Grid
                            Grid.Column="1"
                            Margin="12,0"
                            RowDefinitions="Auto, Auto"
                            RowSpacing="4"
                            VerticalOptions="Center">
                            <Label
                                Grid.Row="0"
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="15"
                                Text="Телеметрия" />
                            <Label
                                Grid.Row="1"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource LabelMuted}"
                                Text="Отправлять анонимную статистику ошибок" />
                        </Grid>
                        <Switch
                            x:Name="TelemetrySwitch"
                            Grid.Column="2"
                            Toggled="OnTelemetryToggled"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border
                    x:Name="CardMesh"
                    Grid.Row="{OnIdiom Desktop='4',
                                       Default='5'}"
                    Grid.Column="0"
                    Grid.ColumnSpan="{OnIdiom Desktop='2',
                                              Default='1'}"
                    Padding="16"
                    IsVisible="{OnIdiom Phone=True,
                                        Default=False}"
                    Style="{StaticResource NeoCard}"
                    VerticalOptions="Start">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Globe24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="24"
                                VerticalOptions="Center" />
                            <Grid
                                Grid.Column="1"
                                Margin="12,0"
                                RowDefinitions="Auto, Auto"
                                RowSpacing="4"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Row="0"
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="15"
                                    Text="Mesh-режим (Сеть ПК)" />
                                <Label
                                    Grid.Row="1"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Передавать трафик через компьютеры других пользователей для обхода строгих блокировок" />
                            </Grid>
                            <Switch
                                x:Name="MeshSwitch"
                                Grid.Column="2"
                                Toggled="OnMeshToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardFriends"
                    Grid.Row="{OnIdiom Desktop='5',
                                       Default='6'}"
                    Grid.Column="0"
                    Grid.ColumnSpan="{OnIdiom Desktop='2',
                                              Default='1'}"
                    Padding="16"
                    IsVisible="{OnIdiom Phone=True,
                                        Default=False}"
                    Style="{StaticResource NeoCard}"
                    VerticalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFriendsTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=PeopleCommunity24}"
                            IconColor="{DynamicResource Primary}"
                            IconSize="24"
                            VerticalOptions="Center" />
                        <Grid
                            Grid.Column="1"
                            Margin="12,0"
                            RowDefinitions="Auto, Auto"
                            RowSpacing="4"
                            VerticalOptions="Center">
                            <Label
                                Grid.Row="0"
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="15"
                                Text="Друзья и Бонусные часы" />
                            <Label
                                Grid.Row="1"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource LabelMuted}"
                                Text="Делитесь кодом с друзьями и получайте +5 часов за каждые 5 ГБ" />
                        </Grid>
                        <mi:MauiIcon
                            Grid.Column="2"
                            Icon="{mi:Fluent Icon=ChevronRight24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border
                    x:Name="CardLogout"
                    Grid.Row="{OnIdiom Desktop='6',
                                       Default='7'}"
                    Grid.Column="0"
                    Grid.ColumnSpan="{OnIdiom Desktop='2',
                                              Default='1'}"
                    Padding="16"
                    IsVisible="{OnIdiom Phone=True,
                                        Default=False}"
                    Style="{StaticResource NeoCard}"
                    VerticalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=SignOut24}"
                            IconColor="{DynamicResource Error}"
                            IconSize="24"
                            VerticalOptions="Center" />
                        <Grid
                            Grid.Column="1"
                            Margin="12,0"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="15"
                                Text="Выйти из аккаунта"
                                TextColor="{DynamicResource Error}" />
                        </Grid>
                        <mi:MauiIcon
                            Grid.Column="2"
                            Icon="{mi:Fluent Icon=ChevronRight24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border
                    x:Name="CardDeleteAccount"
                    Grid.Row="{OnIdiom Desktop='4',
                                       Default='8'}"
                    Grid.Column="0"
                    Grid.ColumnSpan="{OnIdiom Desktop='2',
                                              Default='1'}"
                    Padding="16"
                    Style="{StaticResource NeoCard}"
                    VerticalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteAccountClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=Delete24}"
                            IconColor="{DynamicResource Error}"
                            IconSize="24"
                            VerticalOptions="Center" />
                        <Grid
                            Grid.Column="1"
                            Margin="12,0"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="15"
                                Text="Удалить аккаунт"
                                TextColor="{DynamicResource Error}" />
                        </Grid>
                        <mi:MauiIcon
                            Grid.Column="2"
                            Icon="{mi:Fluent Icon=ChevronRight24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
