<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.MeshView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Grid
        x:Name="RootLayout"
        Padding="{OnIdiom Desktop='32,28',
                          Phone='16,20,16,120',
                          Default='16,20'}"
        RowDefinitions="Auto, *"
        RowSpacing="16">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <Label
                Grid.Column="0"
                FontFamily="CommissionerExtraBold"
                FontSize="{OnIdiom Desktop=22,
                                   Default=24}"
                Style="{StaticResource TitleMedium}"
                Text="Mesh Сеть"
                VerticalOptions="Center" />

            <HorizontalStackLayout
                x:Name="MeshStatusBadgeContainer"
                Grid.Column="1"
                HorizontalOptions="End"
                Spacing="6"
                VerticalOptions="Center">
                <BoxView
                    x:Name="MeshStatusDot"
                    CornerRadius="5"
                    HeightRequest="10"
                    VerticalOptions="Center"
                    WidthRequest="10"
                    Color="#EF4444" />
                <Label
                    x:Name="MeshStatusBadge"
                    FontFamily="RobotoBold"
                    FontSize="13"
                    LineBreakMode="TailTruncation"
                    Text="Релей неактивен"
                    TextColor="#EF4444"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <ScrollView
            x:Name="MeshScrollView"
            Grid.Row="1"
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                x:Name="MeshCardsStack"
                HorizontalOptions="Start"
                Spacing="16">

                <Border
                    x:Name="CardRelayServer"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#E0D4F5,
                                                                  Dark=#2A1B3D}"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="48">
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Server24}"
                                    IconColor="{AppThemeBinding Light=#7C3AED,
                                                                Dark=#9F6FF0}"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="RobotoBold"
                                    FontSize="16"
                                    Text="Релей-сервер (Раздача в фоне)" />
                                <Label
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Раздавайте трафик в фоне и получайте бонусные часы" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="RelayServerSwitch"
                                Grid.Column="2"
                                Toggled="OnRelayServerToggledAsync"
                                VerticalOptions="Center" />
                        </Grid>

                        <Border
                            Padding="14,10"
                            BackgroundColor="{AppThemeBinding Light=#F9FAFB,
                                                              Dark=#181822}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                        FontSize="10"
                                        Style="{StaticResource LabelMuted}"
                                        Text="КЛИЕНТЫ" />
                                    <Label
                                        x:Name="ActiveClientsCountLabel"
                                        FontFamily="RobotoBold"
                                        FontSize="20"
                                        Text="0"
                                        TextColor="#0078D4" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label
                                        FontSize="10"
                                        Style="{StaticResource LabelMuted}"
                                        Text="СКОРОСТЬ" />
                                    <Label
                                        x:Name="CurrentThroughputLabel"
                                        FontFamily="RobotoBold"
                                        FontSize="20"
                                        Text="0.0"
                                        TextColor="#10B981" />
                                    <Label
                                        FontSize="9"
                                        Style="{StaticResource LabelMuted}"
                                        Text="Мбит/с" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label
                                        FontSize="10"
                                        Style="{StaticResource LabelMuted}"
                                        Text="ПЕРЕДАНО" />
                                    <Label
                                        x:Name="TotalRelayedMbLabel"
                                        FontFamily="RobotoBold"
                                        FontSize="20"
                                        Text="0.0"
                                        TextColor="{AppThemeBinding Light=#7C3AED,
                                                                    Dark=#A78BFA}" />
                                    <Label
                                        FontSize="9"
                                        Style="{StaticResource LabelMuted}"
                                        Text="МБ" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardReward"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#E0D4F5,
                                                                  Dark=#2A1B3D}"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="48">
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Gift24}"
                                    IconColor="{AppThemeBinding Light=#7C3AED,
                                                                Dark=#9F6FF0}"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="RobotoBold"
                                    FontSize="16"
                                    Text="Награда за раздачу (+5 часов)" />
                                <Label
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Каждые 5 ГБ розданного трафика = +5 часов к подписке" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label
                                    x:Name="RelayRewardProgressLabel"
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="0.0 / 5.0 ГБ (0%)" />
                                <Label
                                    x:Name="TotalLifetimeRelayedLabel"
                                    Grid.Column="1"
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Всего: 0 ГБ" />
                            </Grid>
                            <ProgressBar
                                x:Name="RelayRewardProgressBar"
                                HeightRequest="8"
                                Progress="0.0"
                                ProgressColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <Button
                            x:Name="ClaimRewardButton"
                            Clicked="OnClaimRewardClickedAsync"
                            HeightRequest="42"
                            IsEnabled="False"
                            Style="{StaticResource NeoBtnPrimary}"
                            Text="Забрать награду (+5 часов)" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardLimits"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontFamily="RobotoBold"
                            FontSize="16"
                            Text="Ограничения ресурсов" />

                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label
                                    FontSize="13"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Максимальная скорость" />
                                <Label
                                    x:Name="SpeedLimitValueLabel"
                                    Grid.Column="1"
                                    FontFamily="RobotoBold"
                                    FontSize="13"
                                    Text="10 Мбит/с"
                                    TextColor="#0078D4" />
                            </Grid>
                            <Slider
                                x:Name="SpeedLimitSlider"
                                Maximum="100"
                                Minimum="1"
                                ValueChanged="OnSpeedLimitChanged"
                                Value="10" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label
                                FontSize="13"
                                Style="{StaticResource LabelMuted}"
                                Text="Макс. одновременных клиентов"
                                VerticalOptions="Center" />
                            <Picker
                                x:Name="MaxClientsPicker"
                                Grid.Column="1"
                                SelectedIndexChanged="OnMaxClientsChanged"
                                WidthRequest="90">
                                <Picker.Items>
                                    <x:String>1</x:String>
                                    <x:String>2</x:String>
                                    <x:String>3</x:String>
                                    <x:String>5</x:String>
                                    <x:String>10</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardMyCode"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#E0D4F5,
                                                                  Dark=#2A1B3D}"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="48">
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Share24}"
                                    IconColor="{AppThemeBinding Light=#7C3AED,
                                                                Dark=#9F6FF0}"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="RobotoBold"
                                    FontSize="16"
                                    Text="Мой код приглашения (+1 час)" />
                                <Label
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Друг получает +1 час, а вам — +1 час в подарок" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border
                            Padding="16,12"
                            BackgroundColor="{AppThemeBinding Light=#F3F0FA,
                                                              Dark=#1E162B}"
                            Stroke="{AppThemeBinding Light=#DDD6FE,
                                                     Dark=#4C1D95}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                                <Label
                                    x:Name="MyReferralCodeLabel"
                                    Grid.Column="0"
                                    CharacterSpacing="2"
                                    FontFamily="RobotoBold"
                                    FontSize="20"
                                    Text="OBX-......"
                                    TextColor="{AppThemeBinding Light=#7C3AED,
                                                                Dark=#A78BFA}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="1"
                                    Clicked="OnCopyMyCodeClickedAsync"
                                    HeightRequest="36"
                                    Style="{StaticResource NeoBtnPrimary}"
                                    Text="Копировать" />
                                <Button
                                    Grid.Column="2"
                                    Clicked="OnShareMyCodeClickedAsync"
                                    HeightRequest="36"
                                    Style="{StaticResource NeoBtnSecondary}"
                                    Text="Поделиться" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardFriendCode"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#E0D4F5,
                                                                  Dark=#2A1B3D}"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="48">
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=PersonAdd24}"
                                    IconColor="{AppThemeBinding Light=#7C3AED,
                                                                Dark=#9F6FF0}"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="RobotoBold"
                                    FontSize="16"
                                    Text="Активировать код друга" />
                                <Label
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Введите код — вам и другу начислят +1 час" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Border
                                Grid.Column="0"
                                Padding="12,0"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFA,
                                                                  Dark=#181822}"
                                HeightRequest="44"
                                Stroke="{AppThemeBinding Light=#E5E7EB,
                                                         Dark=#2A2A38}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    x:Name="FriendCodeEntry"
                                    CharacterSpacing="1"
                                    FontSize="14"
                                    Placeholder="OBX-XXXXXX"
                                    VerticalOptions="Center" />
                            </Border>
                            <Button
                                x:Name="ActivateFriendCodeButton"
                                Grid.Column="1"
                                Clicked="OnActivateFriendCodeClickedAsync"
                                HeightRequest="44"
                                Style="{StaticResource NeoBtnPrimary}"
                                Text="Применить" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardFriendsList"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label
                                FontFamily="RobotoBold"
                                FontSize="16"
                                Text="Приглашённые друзья"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="FriendsCountLabel"
                                Grid.Column="1"
                                FontFamily="RobotoBold"
                                FontSize="13"
                                Text="0 / 10"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="FriendsListContainer" Spacing="8">
                            <Label
                                x:Name="NoFriendsPlaceholder"
                                Margin="0,8"
                                FontSize="13"
                                HorizontalOptions="Center"
                                Style="{StaticResource LabelMuted}"
                                Text="Пока нет друзей. Поделитесь кодом!" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardSecurity"
                    Padding="14"
                    BackgroundColor="#1A10B981"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=ShieldCheckmark24}"
                            IconColor="#10B981"
                            IconSize="26"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="Сквозное шифрование: Релей пересылает только зашифрованные TLS 1.3 / TLS 1.2 байты. Личные данные и содержимое сайтов защищены ключами сервера."
                            TextColor="{AppThemeBinding Light=#065F46,
                                                        Dark=#6EE7B7}" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
