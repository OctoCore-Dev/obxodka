<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.VpnView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls">
    <Grid Padding="{OnIdiom Desktop='32,28', Phone='8,0,8,16', Default='24,24'}">

        <Grid
            x:Name="ContentGrid"
            ColumnDefinitions="{OnIdiom Desktop='5*, 4*',
                                        Default='*'}"
            ColumnSpacing="{OnIdiom Desktop=28,
                                    Default=0}"
            RowDefinitions="{OnIdiom Phone='4*, 6*',
                                     Default='*'}"
            RowSpacing="{OnIdiom Phone=20,
                                 Default=0}">

            <Grid
                Grid.Row="{OnIdiom Desktop=0,
                                   Default=0}"
                Grid.Column="{OnIdiom Desktop=1,
                                      Default=0}"
                RowDefinitions="{OnIdiom Desktop='Auto, 2*, *',
                                         Phone='*, 2*, *',
                                         Default='Auto, Auto, Auto'}"
                RowSpacing="16"
                VerticalOptions="Fill">

                <Grid
                    x:Name="CardIpWrapper"
                    Grid.Row="0"
                    Opacity="0"
                    TranslationY="28"
                    VerticalOptions="Fill">
                    <Border
                        x:Name="CardIp"
                        Padding="16"
                        Style="{StaticResource NeoCard}"
                        VerticalOptions="Fill">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                            <HorizontalStackLayout
                                Grid.Column="0"
                                Spacing="8"
                                VerticalOptions="Center">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent Icon=Earth24}"
                                    IconColor="{AppThemeBinding Light=#7C3AED,
                                                                Dark=#9F6FF0}"
                                    IconSize="15" />
                                <Label
                                    FontFamily="RobotoMedium"
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="IP Адрес" />
                            </HorizontalStackLayout>

                            <Label
                                x:Name="IpAddressLabel"
                                Grid.Column="1"
                                FontFamily="RobotoMedium"
                                FontSize="12"
                                HorizontalOptions="End"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Style="{StaticResource LabelMuted}"
                                Text="не назначен"
                                VerticalOptions="Center" />

                            <Border
                                x:Name="PingBadge"
                                Grid.Column="2"
                                Padding="7,2"
                                BackgroundColor="{AppThemeBinding Light=#1510B981,
                                                                  Dark=#2010B981}"
                                Stroke="#10B981"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <BoxView
                                        x:Name="PingDot"
                                        CornerRadius="3"
                                        HeightRequest="6"
                                        VerticalOptions="Center"
                                        WidthRequest="6"
                                        Color="#10B981" />
                                    <Label
                                        x:Name="PingValueLabel"
                                        FontFamily="RobotoBold"
                                        FontSize="11"
                                        Text="-- ms"
                                        TextColor="{AppThemeBinding Light=#065F46,
                                                                    Dark=#34D399}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    x:Name="Card2Wrapper"
                    Grid.Row="1"
                    Opacity="0"
                    TranslationY="28"
                    VerticalOptions="Fill">
                    <Border
                        x:Name="Card2"
                        Padding="16"
                        Style="{StaticResource NeoCard}"
                        VerticalOptions="Fill">
                        <Grid RowDefinitions="Auto, *">
                            <Grid
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                ColumnDefinitions="*, *">
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="1"
                                    VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4">
                                        <mi:MauiIcon
                                            Icon="{mi:Fluent Icon=ArrowUp24}"
                                            IconColor="{AppThemeBinding Light=#7C3AED,
                                                                        Dark=#9F6FF0}"
                                            IconSize="12" />
                                        <Label
                                            FontSize="10"
                                            Style="{StaticResource LabelMuted}"
                                            Text="Отправлено" />
                                    </HorizontalStackLayout>
                                    <Label
                                        x:Name="TrafficUpLabel"
                                        FontSize="16"
                                        Style="{StaticResource LabelValue}"
                                        Text="0 B/s" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="1"
                                    VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4">
                                        <mi:MauiIcon
                                            Icon="{mi:Fluent Icon=ArrowDown24}"
                                            IconColor="{AppThemeBinding Light=#0284C7,
                                                                        Dark=#00E5FF}"
                                            IconSize="12" />
                                        <Label
                                            FontSize="10"
                                            Style="{StaticResource LabelMuted}"
                                            Text="Получено" />
                                    </HorizontalStackLayout>
                                    <Label
                                        x:Name="TrafficDownLabel"
                                        FontSize="16"
                                        Style="{StaticResource LabelValue}"
                                        Text="0 B/s" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid
                                x:Name="GraphContainer"
                                Grid.Row="1"
                                Margin="0,4,0,0"
                                VerticalOptions="Fill">
                                <skia:SKCanvasView
                                    x:Name="TrafficGraphCanvas"
                                    HorizontalOptions="Fill"
                                    PaintSurface="OnPaintGraphSurface"
                                    VerticalOptions="Fill" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    x:Name="Card5Wrapper"
                    Grid.Row="2"
                    ColumnDefinitions="*, *"
                    ColumnSpacing="{OnIdiom Phone=10,
                                            Default=16}"
                    Opacity="0"
                    TranslationY="28"
                    VerticalOptions="Fill">
                    <Border
                        x:Name="Card5"
                        Grid.Column="0"
                        Padding="{OnIdiom Phone='12,10',
                                          Default='16'}"
                        HeightRequest="{OnIdiom Phone=82,
                                                Default=-1}"
                        Style="{StaticResource NeoCard}"
                        VerticalOptions="Fill">
                        <Grid RowDefinitions="Auto, *">
                            <HorizontalStackLayout
                                Grid.Row="0"
                                Margin="0,0,0,4"
                                Spacing="6">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent Icon=Clock24}"
                                    IconColor="{AppThemeBinding Light=#7C3AED,
                                                                Dark=#9F6FF0}"
                                    IconSize="14" />
                                <Label
                                    FontFamily="RobotoMedium"
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Время" />
                            </HorizontalStackLayout>
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="Auto, *"
                                ColumnSpacing="6"
                                VerticalOptions="Center">
                                <mi:MauiIcon
                                    Grid.Column="0"
                                    Icon="{mi:Fluent Icon=Timer24}"
                                    IconColor="{AppThemeBinding Light=#0284C7,
                                                                Dark=#00E5FF}"
                                    IconSize="{OnIdiom Phone=18,
                                                       Default=22}"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="TokenAmountLabel"
                                    Grid.Column="1"
                                    FontFamily="RobotoBold"
                                    FontSize="{OnIdiom Phone=15,
                                                       Default=18}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Style="{StaticResource LabelValue}"
                                    Text="Считаем..."
                                    VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="Card6"
                        Grid.Column="1"
                        Padding="{OnIdiom Phone='12,10',
                                          Default='16'}"
                        HeightRequest="{OnIdiom Phone=82,
                                                Default=-1}"
                        Style="{StaticResource NeoCard}"
                        VerticalOptions="Fill">
                        <Grid RowDefinitions="Auto, *">
                            <HorizontalStackLayout
                                Grid.Row="0"
                                Margin="0,0,0,4"
                                Spacing="6">
                                <mi:MauiIcon
                                    Icon="{mi:Fluent Icon=DataArea24}"
                                    IconColor="{AppThemeBinding Light=#7C3AED,
                                                                Dark=#9F6FF0}"
                                    IconSize="14" />
                                <Label
                                    FontFamily="RobotoMedium"
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Трафик" />
                            </HorizontalStackLayout>
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="Auto, *"
                                ColumnSpacing="6"
                                VerticalOptions="Center">
                                <mi:MauiIcon
                                    Grid.Column="0"
                                    Icon="{mi:Fluent Icon=ArrowDown24}"
                                    IconColor="{AppThemeBinding Light=#0284C7,
                                                                Dark=#00E5FF}"
                                    IconSize="{OnIdiom Phone=18,
                                                       Default=22}"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="TotalTrafficLabelMain"
                                    Grid.Column="1"
                                    FontFamily="RobotoBold"
                                    FontSize="{OnIdiom Phone=15,
                                                       Default=18}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Style="{StaticResource LabelValue}"
                                    Text="0 B"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <Border
                x:Name="Card1Wrapper"
                Grid.Row="{OnIdiom Desktop=0,
                                   Default=1}"
                Grid.Column="0"
                Opacity="0"
                Style="{StaticResource NeoCard}"
                TranslationY="28"
                VerticalOptions="Fill">

                <Grid
                    Padding="{OnIdiom Phone='20,24',
                                      Default='28,32'}"
                    HorizontalOptions="Center"
                    RowDefinitions="Auto, Auto, Auto"
                    RowSpacing="16"
                    VerticalOptions="Center">

                    <Border
                        x:Name="RayIndicatorBadge"
                        Grid.Row="0"
                        Padding="14,7"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BgElevatedLight},
                                                          Dark={StaticResource BgElevated}}"
                        HorizontalOptions="Center"
                        Stroke="{AppThemeBinding Light={StaticResource BorderMediumLight},
                                                 Dark={StaticResource BorderMedium}}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRayIndicatorBadgeTappedAsync" />
                            <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <mi:MauiIcon
                                x:Name="RayIndicatorIcon"
                                Icon="{mi:Fluent Icon=Scales24}"
                                IconColor="#3B82F6"
                                IconSize="16" />
                            <Label
                                x:Name="RayIndicatorLabel"
                                FontFamily="RobotoMedium"
                                FontSize="13"
                                Style="{StaticResource LabelValue}"
                                Text="Режим: Баланс (2 Луча)" />
                            <mi:MauiIcon
                                Icon="{mi:Fluent Icon=ChevronRight16}"
                                IconColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMuted}}"
                                IconSize="12"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Grid
                        Grid.Row="1"
                        HeightRequest="{OnIdiom Phone=280,
                                                Default=300}"
                        HorizontalOptions="Center"
                        WidthRequest="{OnIdiom Phone=280,
                                               Default=300}">

                        <skia:SKCanvasView
                            x:Name="OuterAura"
                            HorizontalOptions="Fill"
                            IgnorePixelScaling="True"
                            Opacity="0"
                            VerticalOptions="Fill" />

                        <skia:SKCanvasView
                            x:Name="LoaderCanvas"
                            HorizontalOptions="Fill"
                            IgnorePixelScaling="True"
                            Opacity="0"
                            PaintSurface="OnPaintLoaderSurface"
                            VerticalOptions="Fill" />

                        <Border
                            BackgroundColor="Transparent"
                            HeightRequest="{OnIdiom Phone=262,
                                                    Default=278}"
                            HorizontalOptions="Center"
                            Stroke="{AppThemeBinding Light=#1A7C3AED,
                                                     Dark=#1A9F6FF0}"
                            StrokeThickness="1"
                            VerticalOptions="Center"
                            WidthRequest="{OnIdiom Phone=262,
                                                   Default=278}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="131" />
                            </Border.StrokeShape>

                            <Border
                                BackgroundColor="Transparent"
                                HeightRequest="{OnIdiom Phone=232,
                                                        Default=240}"
                                HorizontalOptions="Center"
                                Stroke="{AppThemeBinding Light=#267C3AED,
                                                         Dark=#269F6FF0}"
                                StrokeThickness="1"
                                VerticalOptions="Center"
                                WidthRequest="{OnIdiom Phone=232,
                                                       Default=240}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="116" />
                                </Border.StrokeShape>

                                <Border
                                    x:Name="ConnectButtonCore"
                                    AutomationId="VpnConnectButton"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BgElevatedLight},
                                                                      Dark={StaticResource BgElevated}}"
                                    HeightRequest="{OnIdiom Phone=198,
                                                            Default=196}"
                                    HorizontalOptions="Center"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderMediumLight},
                                                             Dark={StaticResource BorderMedium}}"
                                    StrokeThickness="1"
                                    VerticalOptions="Center"
                                    WidthRequest="{OnIdiom Phone=198,
                                                           Default=196}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="99" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnConnectClickedAsync" />
                                    </Border.GestureRecognizers>
                                    <Grid>
                                        <VerticalStackLayout
                                            HorizontalOptions="Center"
                                            Spacing="7"
                                            VerticalOptions="Center">
                                            <mi:MauiIcon
                                                x:Name="ConnectIcon"
                                                HorizontalOptions="Center"
                                                Icon="{mi:Fluent Icon=Power24}"
                                                IconColor="{AppThemeBinding Light=#7C3AED,
                                                                            Dark=#9F6FF0}"
                                                IconSize="{OnIdiom Phone=40,
                                                                   Default=48}" />
                                            <Label
                                                x:Name="ConnectButtonText"
                                                FontFamily="RobotoBold"
                                                FontSize="{OnIdiom Phone=14,
                                                                   Default=16}"
                                                HorizontalOptions="Center"
                                                Text="СТАРТ"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                            Dark={StaticResource TextPrimary}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Border>
                        </Border>
                    </Grid>

                    <Label
                        x:Name="StatusLabel"
                        Grid.Row="2"
                        Margin="0,14,0,0"
                        AutomationId="VpnStatusLabel"
                        FontSize="{OnIdiom Phone=13,
                                           Default=15}"
                        HorizontalOptions="Center"
                        Style="{StaticResource LabelAccent}"
                        Text="Не в сети" />
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="QuickProtocolOverlay"
            BackgroundColor="#B0000000"
            HorizontalOptions="Fill"
            InputTransparent="False"
            IsVisible="False"
            Opacity="0"
            VerticalOptions="Fill"
            ZIndex="500">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseProtocolModalTappedAsync" />
            </Grid.GestureRecognizers>

            <Border
                x:Name="QuickProtocolModalCard"
                Padding="24,22"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                  Dark=#14141E}"
                HorizontalOptions="Center"
                MaximumWidthRequest="500"
                Stroke="{AppThemeBinding Light=#CBD5E1,
                                         Dark=#2A2A38}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1.5"
                VerticalOptions="Center"
                WidthRequest="{OnIdiom Desktop=460,
                                       Phone=340}">
                <Border.Shadow>
                    <Shadow
                        Brush="#000000"
                        Opacity="0.6"
                        Radius="24"
                        Offset="0,8" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontFamily="RobotoBold"
                                FontSize="17"
                                Style="{StaticResource LabelValue}"
                                Text="Протокол связи" />
                            <Label
                                FontSize="12"
                                Style="{StaticResource LabelMuted}"
                                Text="Быстрое переключение режима соединения" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="8"
                            BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                              Dark=#1E1E2C}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderMediumLight},
                                                     Dark={StaticResource BorderMedium}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseProtocolModalTappedAsync" />
                                <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                            </Border.GestureRecognizers>
                            <mi:MauiIcon
                                Icon="{mi:Fluent Icon=Dismiss24}"
                                IconColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMuted}}"
                                IconSize="18" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="10">
                        <Border
                            x:Name="ModalAutoCard"
                            Padding="14,12"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC,
                                                              Dark=#1C1C26}"
                            Stroke="{AppThemeBinding Light=#E2E8F0,
                                                     Dark=#2D2D3D}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnModalSelectAutoTapped" />
                                <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <mi:MauiIcon
                                    x:Name="ModalAutoIcon"
                                    Grid.Column="0"
                                    Icon="{mi:Fluent Icon=Sparkle24}"
                                    IconColor="#00E5FF"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="RobotoBold"
                                        FontSize="14"
                                        Style="{StaticResource LabelValue}"
                                        Text="AUTO" />
                                    <Label
                                        FontSize="11"
                                        Style="{StaticResource LabelMuted}"
                                        Text="Умный подбор и автоматический Fallback" />
                                </VerticalStackLayout>
                                <mi:MauiIcon
                                    x:Name="ModalAutoCheck"
                                    Grid.Column="2"
                                    Icon="{mi:Fluent Icon=CheckmarkCircle24}"
                                    IconColor="#00E5FF"
                                    IconSize="20"
                                    IsVisible="False"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ModalFechsueCard"
                            Padding="14,12"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC,
                                                              Dark=#1C1C26}"
                            Stroke="{AppThemeBinding Light=#E2E8F0,
                                                     Dark=#2D2D3D}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnModalSelectFechsueTapped" />
                                <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <mi:MauiIcon
                                    x:Name="ModalFechsueIcon"
                                    Grid.Column="0"
                                    Icon="{mi:Fluent Icon=Rocket24}"
                                    IconColor="#A855F7"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="RobotoBold"
                                        FontSize="14"
                                        Style="{StaticResource LabelValue}"
                                        Text="FHARCSUE" />
                                    <Label
                                        FontSize="11"
                                        Style="{StaticResource LabelMuted}"
                                        Text="Мульти-пинговый Watchdog UDP (0% потерь)" />
                                </VerticalStackLayout>
                                <mi:MauiIcon
                                    x:Name="ModalFechsueCheck"
                                    Grid.Column="2"
                                    Icon="{mi:Fluent Icon=CheckmarkCircle24}"
                                    IconColor="#A855F7"
                                    IconSize="20"
                                    IsVisible="False"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ModalHttp3Card"
                            Padding="14,12"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC,
                                                              Dark=#1C1C26}"
                            Stroke="{AppThemeBinding Light=#E2E8F0,
                                                     Dark=#2D2D3D}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnModalSelectHttp3Tapped" />
                                <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <mi:MauiIcon
                                    x:Name="ModalHttp3Icon"
                                    Grid.Column="0"
                                    Icon="{mi:Fluent Icon=ShieldLock24}"
                                    IconColor="#00E5FF"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="RobotoBold"
                                        FontSize="14"
                                        Style="{StaticResource LabelValue}"
                                        Text="HTTP/3" />
                                    <Label
                                        FontSize="11"
                                        Style="{StaticResource LabelMuted}"
                                        Text="QUIC (Маскировка под Chrome)" />
                                </VerticalStackLayout>
                                <mi:MauiIcon
                                    x:Name="ModalHttp3Check"
                                    Grid.Column="2"
                                    Icon="{mi:Fluent Icon=CheckmarkCircle24}"
                                    IconColor="#00E5FF"
                                    IconSize="20"
                                    IsVisible="False"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ModalHttp2Card"
                            Padding="14,12"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC,
                                                              Dark=#1C1C26}"
                            Stroke="{AppThemeBinding Light=#E2E8F0,
                                                     Dark=#2D2D3D}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnModalSelectHttp2Tapped" />
                                <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <mi:MauiIcon
                                    x:Name="ModalHttp2Icon"
                                    Grid.Column="0"
                                    Icon="{mi:Fluent Icon=Flash24}"
                                    IconColor="#0078D4"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="RobotoBold"
                                        FontSize="14"
                                        Style="{StaticResource LabelValue}"
                                        Text="HTTP/2" />
                                    <Label
                                        FontSize="11"
                                        Style="{StaticResource LabelMuted}"
                                        Text="Стандартный TLS (Стабильный TCP)" />
                                </VerticalStackLayout>
                                <mi:MauiIcon
                                    x:Name="ModalHttp2Check"
                                    Grid.Column="2"
                                    Icon="{mi:Fluent Icon=CheckmarkCircle24}"
                                    IconColor="#0078D4"
                                    IconSize="20"
                                    IsVisible="False"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>

