<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.FriendsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Grid
        Padding="{OnIdiom Desktop='32,28',
                          Phone='16,20,16,120',
                          Default='16,20'}"
        RowDefinitions="Auto, *"
        RowSpacing="16"
        SafeAreaEdges="None">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <Border
                x:Name="BackBtn"
                Grid.Column="0"
                HeightRequest="40"
                Style="{StaticResource NeoCard}"
                VerticalOptions="Center"
                WidthRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <mi:MauiIcon
                    HorizontalOptions="Center"
                    Icon="{mi:Fluent Icon=ArrowLeft24}"
                    IconColor="{DynamicResource TextPrimary}"
                    IconSize="20"
                    VerticalOptions="Center" />
            </Border>
            <Label
                Grid.Column="1"
                Margin="16,0,0,0"
                FontFamily="{DynamicResource AppFontTitle}"
                FontSize="{OnIdiom Desktop=22,
                                   Default=24}"
                Text="Друзья и Награды"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView
            x:Name="FriendsScrollView"
            Grid.Row="1"
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never"
            Orientation="Vertical"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                x:Name="FriendsCardsStack"
                HorizontalOptions="Start"
                Spacing="16">

                <Border
                    x:Name="CardPersonalCode"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Gift24}"
                                IconColor="{DynamicResource Primary}"
                                IconSize="26"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="16"
                                    Text="Ваш персональный код" />
                                <Label
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Поделитесь с друзьями для приоритета и бонусов" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border
                            Padding="16,12"
                            BackgroundColor="{DynamicResource BgElevated}"
                            Stroke="{DynamicResource BorderSubtle}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label
                                    x:Name="MyCodeLabel"
                                    Grid.Column="0"
                                    CharacterSpacing="3"
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="22"
                                    Text="OBX-849201"
                                    TextColor="{DynamicResource Primary}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="1"
                                    Clicked="OnCopyCodeClickedAsync"
                                    HeightRequest="36"
                                    Text="Копировать" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardActivate"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=PersonAdd24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="26"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="16"
                                    Text="Активировать код друга" />
                                <Label
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Привяжите друга для приоритетного Mesh-трафика" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Border
                                Grid.Column="0"
                                Padding="12,4"
                                BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource BorderSubtle}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry
                                    x:Name="FriendCodeEntry"
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="14"
                                    Placeholder="Введите код (например: OBX-123456)"
                                    PlaceholderColor="{DynamicResource TextMuted}" />
                            </Border>
                            <Button
                                x:Name="ActivateCodeBtn"
                                Grid.Column="1"
                                Clicked="OnActivateCodeClickedAsync"
                                HeightRequest="44"
                                Text="Применить" />
                        </Grid>
                        <Label
                            x:Name="ActivateFeedbackLabel"
                            FontSize="12"
                            IsVisible="False"
                            TextColor="{DynamicResource Success}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardReward"
                    Padding="20"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="16"
                                    Text="Награда за релей-трафик" />
                                <Label
                                    FontSize="12"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Каждые 5 ГБ трафика приносят +5 часов подписки" />
                            </VerticalStackLayout>
                            <Label
                                x:Name="ProgressTextLabel"
                                Grid.Column="1"
                                FontFamily="{DynamicResource AppFontBold}"
                                FontSize="14"
                                Text="0.0 / 5.0 ГБ"
                                TextColor="{DynamicResource Primary}"
                                VerticalOptions="Center" />
                        </Grid>

                        <ProgressBar
                            x:Name="RelayProgressBar"
                            HeightRequest="8"
                            Progress="0.0"
                            ProgressColor="{DynamicResource Primary}" />

                        <Button
                            x:Name="ClaimRewardBtn"
                            Clicked="OnClaimRewardClickedAsync"
                            HeightRequest="46"
                            IsEnabled="False"
                            Text="Забрать +5 часов" />

                        <Border
                            Padding="12"
                            BackgroundColor="{DynamicResource PrimaryDim}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <mi:MauiIcon
                                    Grid.Column="0"
                                    Icon="{mi:Fluent Icon=Lightbulb24}"
                                    IconColor="{DynamicResource Primary}"
                                    IconSize="18"
                                    VerticalOptions="Start" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="11"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="На смартфонах трафик только отправляется через ПК-сеть (без расхода батареи). На ПК включите релей в настройках, чтобы раздавать и зарабатывать часы." />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
