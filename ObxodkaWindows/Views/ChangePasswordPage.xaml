<Page x:Class="ObxodkaWindows.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля" Background="Transparent">

    <Grid>
        <StackPanel Margin="30,70,30,0">
            <TextBlock Text="Пароль" FontSize="42" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>

            <Border Background="#0D0D0F" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="20">
                <StackPanel>
                    <Grid Height="65">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="OldPasswordBox" VerticalAlignment="Center" Background="Transparent" 
                                     BorderThickness="0" Foreground="White" FontSize="16" Margin="20,0,0,0" 
                                     CaretBrush="White" PasswordChanged="OnOldPasswordChanged"/>

                        <TextBox x:Name="OldPasswordText" VerticalAlignment="Center" Background="Transparent" 
                                 BorderThickness="0" Foreground="White" FontSize="16" Margin="20,0,0,0" 
                                 CaretBrush="White" Visibility="Collapsed" TextChanged="OnOldTextChanged"/>

                        <TextBlock x:Name="OldPassPlaceholder" IsHitTestVisible="False" Text="Старый пароль" 
                                   VerticalAlignment="Center" Margin="22,0,0,0" Foreground="#44FFFFFF" FontSize="16"/>

                        <Button Grid.Column="1" Click="OnOldPasswordEyeClicked" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Image x:Name="OldEyeImg" Source="pack://application:,,,/Resources/eye_off.png" Width="25" Opacity="0.5"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="#10FFFFFF" Margin="15,0"/>

                    <Grid Height="65">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="NewPasswordBox" VerticalAlignment="Center" Background="Transparent" 
                                     BorderThickness="0" Foreground="White" FontSize="16" Margin="20,0,0,0" 
                                     CaretBrush="White" PasswordChanged="OnNewPasswordChanged"/>

                        <TextBox x:Name="NewPasswordText" VerticalAlignment="Center" Background="Transparent" 
                                 BorderThickness="0" Foreground="White" FontSize="16" Margin="20,0,0,0" 
                                 CaretBrush="White" Visibility="Collapsed" TextChanged="OnNewTextChanged"/>

                        <TextBlock x:Name="NewPassPlaceholder" IsHitTestVisible="False" Text="Новый пароль" 
                                   VerticalAlignment="Center" Margin="22,0,0,0" Foreground="#44FFFFFF" FontSize="16"/>

                        <Button Grid.Column="1" Click="OnNewPasswordEyeClicked" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Image x:Name="NewEyeImg" Source="pack://application:,,,/Resources/eye_off.png" Width="25" Opacity="0.5"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Height="60" CornerRadius="30" Margin="0,35,0,0">
                <Button Content="Сохранить" Click="OnSavePasswordClicked" Background="Transparent" 
                        BorderThickness="0" Foreground="White" FontWeight="Bold" FontSize="22" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="28">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0044" Offset="0.0" />
                                        <GradientStop Color="#660011" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </StackPanel>
    </Grid>
</Page>