<Page x:Class="ObxodkaWindows.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      Title="Регистрация" Background="Transparent"
      d:DesignHeight="520" d:DesignWidth="380"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="111*"/>
            <RowDefinition Height="149*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="30,50,30,0" Grid.RowSpan="2">
            <TextBlock x:Name="TitleLabel" Text="Регистрация" FontSize="37" FontWeight="Bold" 
                       Foreground="White" Opacity="0" Margin="0,0,0,15">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleTransform" Y="30"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Border x:Name="FormContainer" Background="#1AFFFFFF" BorderBrush="#22FFFFFF" 
                    BorderThickness="1" CornerRadius="20" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FormTransform" Y="30"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Height="65">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Resources/email_icon.png" Width="40" Height="40" Opacity="0.7" HorizontalAlignment="Center"/>

                        <TextBox x:Name="EmailEntry" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" 
                                 BorderThickness="0" Foreground="White" FontSize="15" Margin="5,0,20,0" CaretBrush="White"/>
                        <TextBlock IsHitTestVisible="False" Text="Email адрес" Grid.Column="1" VerticalAlignment="Center" 
                                   Margin="7,0,0,0" Foreground="#77FFFFFF" FontSize="15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=EmailEntry}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Rectangle Height="1" Fill="#15FFFFFF" Margin="15,0"/>

                    <Grid Height="65">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Resources/lock_icon.png" Width="40" Height="40" Opacity="0.7" HorizontalAlignment="Center"/>

                        <PasswordBox x:Name="PasswordEntry" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" 
                                     BorderThickness="0" Foreground="White" FontSize="15" Margin="5,0,0,0" CaretBrush="White"
                                     PasswordChanged="OnPasswordChanged"/>
                        <TextBox x:Name="PasswordTextEntry" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" 
                                 BorderThickness="0" Foreground="White" FontSize="15" Margin="5,0,0,0" CaretBrush="White" 
                                 Visibility="Collapsed" TextChanged="OnTextChanged"/>
                        <TextBlock x:Name="PassPlaceholder" IsHitTestVisible="False" Text="Введите пароль" Grid.Column="1" 
                                   VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#77FFFFFF" FontSize="15"/>
                        <Button Grid.Column="2" Click="TogglePasswordVisibility" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Image x:Name="EyeImg1" Source="pack://application:,,,/Resources/eye_off.png" Width="28" Opacity="0.5"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="#15FFFFFF" Margin="15,0"/>

                    <Grid Height="65">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Resources/lock_icon.png" Width="40" Height="40" Opacity="0.7" HorizontalAlignment="Center"/>

                        <PasswordBox x:Name="PasswordRepeatEntry" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" 
                                     BorderThickness="0" Foreground="White" FontSize="15" Margin="5,0,0,0" CaretBrush="White"
                                     PasswordChanged="OnPasswordChanged"/>
                        <TextBox x:Name="PasswordRepeatTextEntry" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" 
                                 BorderThickness="0" Foreground="White" FontSize="15" Margin="5,0,0,0" CaretBrush="White" 
                                 Visibility="Collapsed" TextChanged="OnTextChanged"/>
                        <TextBlock x:Name="PassRepeatPlaceholder" IsHitTestVisible="False" Text="Повторите пароль" Grid.Column="1" 
                                   VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#77FFFFFF" FontSize="15"/>
                        <Button Grid.Column="2" Click="ToggleRepeatPasswordVisibility" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Image x:Name="EyeImg2" Source="pack://application:,,,/Resources/eye_off.png" Width="28" Opacity="0.5"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <CheckBox x:Name="PolicyCheckBox" VerticalAlignment="Center" Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Grid Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="CheckBorder" Width="16" Height="16" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4">
                                                    <TextBlock x:Name="CheckMark" Text="✓" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Border>
                                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="CheckBorder" Property="Background" Value="#FF0044"/>
                                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FF0044"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Я согласен с " Foreground="#88FFFFFF" FontSize="11"/>
                        <TextBlock Text="условиями политики" Foreground="#FF0044" FontSize="11" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="OnPolicyLinkClick"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>

            <TextBlock x:Name="CommonErrorLabel" Foreground="#FF4444" FontSize="11" HorizontalAlignment="Center" Margin="0,5" Opacity="0"/>

            <Border x:Name="RegisterButtonBorder" Height="55" CornerRadius="25" Opacity="0" Margin="0,5,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ButtonTransform" Y="30"/>
                </Border.RenderTransform>
                <Button x:Name="MainRegisterButton" Content="Создать аккаунт" Click="OnRegisterClicked" 
                        Background="Transparent" BorderThickness="0" Foreground="White" FontWeight="Bold" FontSize="20" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="25">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8800EE" Offset="0.1" />
                                        <GradientStop Color="#FF0055" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <TextBlock x:Name="LoginLabel" Text="Уже есть аккаунт? Войти" Foreground="#88FFFFFF" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,10" Cursor="Hand" MouseLeftButtonDown="OnLoginLabelTapped"/>
        </StackPanel>
    </Grid>
</Page>