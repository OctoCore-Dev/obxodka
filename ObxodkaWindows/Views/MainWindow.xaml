<Window x:Class="ObxodkaWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ObxodkaWindow" 
        Height="520" Width="380"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True">

    <Grid>
        <Border Margin="15" Background="#0A0A0B" CornerRadius="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border x:Name="MainBorder" Margin="15" Background="#0A0A0B" CornerRadius="30" 
                BorderBrush="#22FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
        </Border>

        <StackPanel Orientation="Horizontal" 
                    VerticalAlignment="Top" 
                    HorizontalAlignment="Right" 
                    Margin="0,22,25,0">

            <Button x:Name="BackButton" 
                    Click="OnBackClicked"
                    Visibility="Collapsed" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    Width="40" Height="40">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <Image Source="pack://application:,,,/Resources/back_arrow.png" Width="40" Height="40"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Click="OnCloseClicked" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    Width="40" Height="40">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <Image Source="pack://application:,,,/Resources/plus_icon.png" Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>