<Page x:Class="ObxodkaWindows.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      Title="Вход" Background="Transparent"
      d:DesignHeight="520" d:DesignWidth="380"
      mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="30,60,30,0">
            <TextBlock x:Name="TitleLabel" Text="Вход" FontSize="42" FontWeight="Bold" 
                       Foreground="White" Opacity="0" Margin="0,0,0,20"/>

            <Border x:Name="FormContainer" Background="#1AFFFFFF" BorderBrush="#22FFFFFF" 
                    BorderThickness="1" CornerRadius="20" Padding="0" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FormShakeTransform" />
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Height="65">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Resources/email_icon.png" Width="40" Height="40" Opacity="0.7" HorizontalAlignment="Center"/>

                        <TextBox x:Name="EmailEntry" Grid.Column="1" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="White" 
                                 FontSize="15" Margin="5,0,20,0" CaretBrush="White"/>
                        <TextBlock IsHitTestVisible="False" Text="Email адрес" Grid.Column="1" 
                                   VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#77FFFFFF" FontSize="15">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=EmailEntry}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Rectangle Height="1" Fill="#15FFFFFF" Margin="15,0"/>

                    <Grid Height="65">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Resources/lock_icon.png" Width="40" Height="40" Opacity="0.7" HorizontalAlignment="Center"/>

                        <PasswordBox x:Name="PasswordEntry" Grid.Column="1" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="White" 
                                     FontSize="15" Margin="5,0,0,0" CaretBrush="White"
                                     PasswordChanged="OnPasswordChanged"/>
                        <TextBox x:Name="PasswordTextEntry" Grid.Column="1" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="White" 
                                 FontSize="15" Margin="5,0,0,0" CaretBrush="White" 
                                 Visibility="Collapsed" TextChanged="OnTextChanged"/>
                        <TextBlock x:Name="PassPlaceholder" IsHitTestVisible="False" Text="Введите пароль" Grid.Column="1" 
                                   VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#77FFFFFF" FontSize="15"/>

                        <Button Grid.Column="2" Click="OnPasswordEyeClicked" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Image x:Name="EyeImg" Source="pack://application:,,,/Resources/eye_off.png" Width="28" Opacity="0.5"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="CommonErrorLabel" Foreground="#FF4444" FontSize="14" 
                       HorizontalAlignment="Center" Margin="0,8" Opacity="0"/>

            <Border x:Name="LoginButtonBorder" Height="60" CornerRadius="35" Opacity="0" Margin="0,5,0,0">
                <Button x:Name="MainLoginButton" Content="Войти" Click="OnLoginClicked"
                        Background="Transparent" BorderThickness="0" Foreground="White" 
                        FontWeight="Bold" FontSize="23" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="25">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8800EE" Offset="0.1" />
                                        <GradientStop Color="#FF0055" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <TextBlock x:Name="RegisterLabel" Text="Нет аккаунта? Зарегистрироваться" 
                       Foreground="#88FFFFFF" FontSize="14" HorizontalAlignment="Center" Margin="0,15" 
                       Cursor="Hand" MouseLeftButtonDown="OnRegisterLabelTapped" Opacity="0"/>
        </StackPanel>
    </Grid>
</Page>