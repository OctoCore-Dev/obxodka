<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="obxodka.Pages.RegisterPage"
             x:ClassModifier="internal"
             Title="Регистрация"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource AppBackground}">

    <Grid>
        <VerticalStackLayout Margin="30,0" Spacing="15" VerticalOptions="Center">
            <Label x:Name="TitleLabel" Text="Регистрация" FontSize="50" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" Margin="0,0,0,5" Opacity="0" TranslationY="30" />

            <Border x:Name="FormContainer" Background="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Opacity="0" TranslationY="20" Padding="10,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="55, *" HeightRequest="65">
                        <Image Source="email_icon.png" WidthRequest="50" HeightRequest="50" Opacity="0.7" HorizontalOptions="Center"/>
                        <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="Email адрес" PlaceholderColor="{DynamicResource TextSecondary}" TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent" FontSize="15" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" Margin="15,0" />
                    <Grid ColumnDefinitions="55, *, 55" HeightRequest="65">
                        <Image Source="lock_icon.png" WidthRequest="50" HeightRequest="50" Opacity="0.7" HorizontalOptions="Center"/>
                        <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Введите пароль" PlaceholderColor="{DynamicResource TextSecondary}" TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent" FontSize="15" IsPassword="True" VerticalOptions="Center" />
                        <ImageButton x:Name="EyeImg1" Grid.Column="2" Source="eye_off.png" WidthRequest="50" HeightRequest="50" Opacity="0.5" BackgroundColor="Transparent" BorderColor="Transparent" Clicked="TogglePasswordVisibility" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" Margin="15,0" />
                    <Grid ColumnDefinitions="55, *, 55" HeightRequest="65">
                        <Image Source="lock_icon.png" WidthRequest="50" HeightRequest="50" Opacity="0.7" HorizontalOptions="Center"/>
                        <Entry x:Name="PasswordRepeatEntry" Grid.Column="1" Placeholder="Повторите пароль" PlaceholderColor="{DynamicResource TextSecondary}" TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent" FontSize="15" IsPassword="True" VerticalOptions="Center" />
                        <ImageButton x:Name="EyeImg2" Grid.Column="2" Source="eye_off.png" WidthRequest="50" HeightRequest="50" Opacity="0.5" BackgroundColor="Transparent" BorderColor="Transparent" Clicked="ToggleRepeatPasswordVisibility" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,5,0,0">
                <CheckBox x:Name="PolicyCheckBox" Color="{DynamicResource PrimaryAccent}" VerticalOptions="Center" Margin="0,0,-90,0" />
                <Label Text="Я согласен с " TextColor="{DynamicResource TextSecondary}" FontSize="12" VerticalOptions="Center" />
                <Label Text="условиями политики" TextColor="{DynamicResource PrimaryAccent}" FontSize="12" TextDecorations="Underline" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPolicyLinkClick" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <Label x:Name="CommonErrorLabel" TextColor="{DynamicResource ErrorColor}" FontSize="13" HorizontalOptions="Center" Margin="0,-5,0,0" Opacity="0" />

            <Border x:Name="RegisterButtonBorder" BackgroundColor="{DynamicResource PrimaryAccent}" StrokeThickness="0" HeightRequest="60" Opacity="0" TranslationY="30">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource PrimaryAccent}" Radius="15" Opacity="0.3" Offset="0,5" />
                </Border.Shadow>
                <Button x:Name="MainRegisterButton" Text="СОЗДАТЬ АККАУНТ" Clicked="OnRegisterClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="18" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>