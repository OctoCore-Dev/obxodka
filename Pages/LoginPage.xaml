<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="obxodka.Pages.LoginPage"
             x:ClassModifier="internal"
             Title="Вход"
             BackgroundColor="{DynamicResource AppBackground}">

    <Grid>
        <VerticalStackLayout Margin="30,0" Spacing="20" VerticalOptions="Center">

            <Image x:Name="AppIcon" Source="app_logo.png" WidthRequest="150" HeightRequest="150" HorizontalOptions="Center" Margin="0,-30,0,0" Opacity="0">
                <Image.Shadow>
                    <Shadow Brush="{DynamicResource PrimaryAccent}" Radius="20" Opacity="0.3" Offset="0,0" />
                </Image.Shadow>
            </Image>

            <Label x:Name="TitleLabel" Text="Вход" FontSize="52" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" Margin="0,0,0,10" Opacity="0" />

            <Border x:Name="FormContainer" Background="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Opacity="0" Padding="10,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="55, *" HeightRequest="65">
                        <Image Source="email_icon.png" WidthRequest="50" HeightRequest="50" Opacity="0.7" HorizontalOptions="Center"/>
                        <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="Email адрес" PlaceholderColor="{DynamicResource TextSecondary}" TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent" FontSize="15" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" Margin="15,0" />

                    <Grid ColumnDefinitions="55, *, 55" HeightRequest="65">
                        <Image Source="lock_icon.png" WidthRequest="50" HeightRequest="50" Opacity="0.7" HorizontalOptions="Center"/>
                        <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Введите пароль" PlaceholderColor="{DynamicResource TextSecondary}" TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent" FontSize="15" IsPassword="True" VerticalOptions="Center" />
                        <ImageButton x:Name="EyeImg" Grid.Column="2" Source="eye_off.png" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" BorderColor="Transparent" Opacity="0.5" Clicked="OnPasswordEyeClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="CommonErrorLabel" TextColor="{DynamicResource ErrorColor}" FontSize="14" HorizontalOptions="Center" Opacity="0" Margin="0,-10,0,0" />

            <Border x:Name="LoginButtonBorder" BackgroundColor="{DynamicResource PrimaryAccent}" StrokeThickness="0" HeightRequest="60" Opacity="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource PrimaryAccent}" Radius="15" Opacity="0.3" Offset="0,5" />
                </Border.Shadow>
                <Button x:Name="MainLoginButton" Text="ВОЙТИ" Clicked="OnLoginClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="20" />
            </Border>

            <Label x:Name="RegisterLabel" Text="Нет аккаунта? Зарегистрироваться" TextColor="{DynamicResource TextSecondary}" FontSize="14" HorizontalOptions="Center" Opacity="0" Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterLabelTapped" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Grid>
</ContentPage>