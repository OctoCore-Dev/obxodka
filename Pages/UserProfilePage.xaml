<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="obxodka.Pages.UserProfilePage"
             x:ClassModifier="internal"
             Title="Профиль"
             BackgroundColor="{DynamicResource AppBackground}">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Margin="20,40,20,20" Spacing="15">

                <Label x:Name="HeaderTitle" Text="Профиль" Style="{DynamicResource HeaderTitleStyle}" Margin="0,0,0,10" Opacity="0"/>

                <Border x:Name="BalanceCard" Style="{DynamicResource GlassCardStyle}" Padding="20" Opacity="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="ДОСТУПНО ВРЕМЕНИ" FontSize="10" TextColor="{DynamicResource TextSecondary}" FontAttributes="Bold" />
                                <Label x:Name="TokenAmountLabel" Text="0T / 00:00" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource StatusBlue}" FontFamily="Consolas"/>
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Source="user_icon.png" WidthRequest="50" HeightRequest="50" HorizontalOptions="End"/>
                        </Grid>
                        <Border HeightRequest="50" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0044" Offset="0.0" />
                                    <GradientStop Color="#660011" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Button Text="ПРОДЛИТЬ ДОСТУП" Clicked="OnBuyTokensClicked" BackgroundColor="Transparent" TextColor="White" FontSize="16" FontAttributes="Bold" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="SettingsCard" Style="{DynamicResource GlassCardStyle}" Padding="15" Opacity="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🎨 ОФОРМЛЕНИЕ" FontSize="11" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10" HeightRequest="80">
                            <Border x:Name="BtnDark" Grid.Column="0" StrokeThickness="2" Stroke="{DynamicResource BorderColor}" BackgroundColor="#0A0A0B">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeSelected" CommandParameter="0"/>
                                </Border.GestureRecognizers>
                                <Label Text="DARK" FontSize="10" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Border>

                            <Border x:Name="BtnLight" Grid.Column="1" StrokeThickness="2" Stroke="{DynamicResource BorderColor}" BackgroundColor="#F2F2F7">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeSelected" CommandParameter="1"/>
                                </Border.GestureRecognizers>
                                <Label Text="LIGHT" FontSize="10" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Border>

                            <Border x:Name="BtnGlass" Grid.Column="2" StrokeThickness="2" Stroke="{DynamicResource BorderColor}" BackgroundColor="#1AFFFFFF">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeSelected" CommandParameter="2"/>
                                </Border.GestureRecognizers>
                                <Label Text="GLASS" FontSize="10" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <Button x:Name="ApplyThemeBtn" Text="ПРИМЕНИТЬ" Clicked="OnApplyThemeClicked" IsEnabled="False" HeightRequest="45" CornerRadius="12" BackgroundColor="{DynamicResource SurfaceDark}" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="AccountCard" Style="{DynamicResource GlassCardStyle}" Padding="15" Opacity="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="👤" VerticalOptions="Center" FontSize="24"/>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="ВАША ПОЧТА" FontSize="9" TextColor="{DynamicResource TextSecondary}" FontAttributes="Bold"/>
                                <Label x:Name="EmailLabel" Text="loading..." TextColor="{DynamicResource TextPrimary}" FontSize="14" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}"/>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="📱 Устройства" Clicked="OnDevicesClicked" BackgroundColor="Transparent" TextColor="{DynamicResource StatusBlue}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" HeightRequest="40" CornerRadius="12" />
                            <Button Grid.Column="1" Text="🔑 Пароль" Clicked="OnChangePasswordClicked" BackgroundColor="Transparent" TextColor="{DynamicResource TextPrimary}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" HeightRequest="40" CornerRadius="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="AdBlockCard" Style="{DynamicResource GlassCardStyle}" Padding="15" Opacity="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="🛡️ БЛОКИРОВКА РЕКЛАМЫ" FontSize="11" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold"/>
                            <Label x:Name="AdBlockStatusLabel" Text="(AdGuard DNS)" FontSize="9" TextColor="{DynamicResource StatusBlue}"/>
                        </VerticalStackLayout>
                        <Switch x:Name="AdBlockSwitch" Grid.Column="1" Toggled="OnAdBlockToggled" OnColor="{DynamicResource StatusBlue}" />
                    </Grid>
                </Border>

                <Border x:Name="SplitTunnelCard" Style="{DynamicResource GlassCardStyle}" Padding="15" Opacity="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="🔀 ИСКЛЮЧЕНИЯ VPN" FontSize="11" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold"/>
                            <Label Text="(Split Tunneling)" FontSize="9" TextColor="{DynamicResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="НАСТРОИТЬ" Clicked="OnSplitTunnelingClicked" BackgroundColor="Transparent" TextColor="{DynamicResource StatusBlue}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" HeightRequest="35" CornerRadius="10" FontSize="10" Padding="15,0" />
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="BottomSection" Spacing="20" Margin="0,10,0,30" Opacity="0">
                    <Button Text="Выйти из аккаунта" Clicked="OnLogoutClicked" BackgroundColor="Transparent" TextColor="{DynamicResource TextSecondary}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" HeightRequest="50" CornerRadius="15" />
                    <Label Text="Удалить аккаунт навсегда" TextColor="{DynamicResource ErrorColor}" FontSize="12" HorizontalOptions="Center" TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeleteAccountClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CC000000" IsVisible="False" Opacity="0">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <ActivityIndicator IsRunning="True" Color="{DynamicResource StatusBlue}" WidthRequest="60" HeightRequest="60"/>
                <Label Text="ПРИМЕНЕНИЕ ТЕМЫ..." TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>