<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="obxodka.Pages.SplashPage"
             x:ClassModifier="internal"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource AppBackground}">

    <Grid>
        <Ellipse x:Name="GlowEllipse" 
                 WidthRequest="250" HeightRequest="250" 
                 Fill="{DynamicResource PrimaryAccent}" Opacity="0" 
                 HorizontalOptions="Center" VerticalOptions="Center">
            <Ellipse.Shadow>
                <Shadow Brush="{DynamicResource PrimaryAccent}" Radius="100" Opacity="1" Offset="0,0" />
            </Ellipse.Shadow>
        </Ellipse>

        <Image x:Name="AppLogo" 
               Source="splash_win.png" 
               WidthRequest="220" HeightRequest="220" 
               Scale="0.7" Opacity="0"
               HorizontalOptions="Center" VerticalOptions="Center">
            <Image.Shadow>
                <Shadow Brush="{DynamicResource PrimaryAccent}" Radius="25" Opacity="0.6" Offset="0,0" />
            </Image.Shadow>
        </Image>

        <VerticalStackLayout VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,80" Spacing="20">
            <ActivityIndicator x:Name="MainLoader" IsRunning="True" 
                               Color="{DynamicResource StatusBlue}" 
                               WidthRequest="40" HeightRequest="40" 
                               HorizontalOptions="Center" Opacity="0"/>

            <Label x:Name="LoadingLabel" 
                   Text="ИНИЦИАЛИЗАЦИЯ..." 
                   TextColor="{DynamicResource TextPrimary}" 
                   FontSize="12" FontAttributes="Bold" 
                   HorizontalOptions="Center" CharacterSpacing="1.5" 
                   Opacity="0"/>

            <Border x:Name="RetryButton" 
                    IsVisible="False" 
                    BackgroundColor="{DynamicResource SurfaceDark}" 
                    Stroke="{DynamicResource BorderColor}" 
                    StrokeThickness="1" 
                    HeightRequest="45" WidthRequest="160" 
                    Opacity="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Button Text="ПОВТОРИТЬ" 
                        FontSize="11" FontAttributes="Bold" 
                        TextColor="{DynamicResource TextPrimary}" 
                        BackgroundColor="Transparent" 
                        Clicked="OnRetryClicked" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>