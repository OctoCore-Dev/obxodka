<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="obxodka.Pages.DevicesPage"
             x:ClassModifier="internal"
             Title="Мои устройства"
             BackgroundColor="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto, *" Margin="20">
        <VerticalStackLayout Grid.Row="0" Margin="0,40,0,30" Spacing="5" HorizontalOptions="Center">
            <Label Text="УСТРОЙСТВА" TextColor="{DynamicResource TextPrimary}" FontFamily="CommissionerExtraBold" FontSize="32" HorizontalOptions="Center">
                <Label.Shadow>
                    <Shadow Brush="{DynamicResource StatusBlue}" Offset="0,0" Radius="15" Opacity="0.3"/>
                </Label.Shadow>
            </Label>
            <BoxView HeightRequest="1" WidthRequest="50" Color="{DynamicResource StatusBlue}" HorizontalOptions="Center" Margin="0,10,0,0"/>
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <CollectionView x:Name="DevicesList" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource SurfaceLight}" StrokeThickness="0" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Label Text="📱" VerticalOptions="Center" HorizontalOptions="Center" FontSize="20"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding DeviceName}" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" FontSize="16" />
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="{DynamicResource SuccessColor}"/>
                                        <Label Text="{Binding LastLoginText}" TextColor="{DynamicResource TextSecondary}" FontSize="11" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="✕" BackgroundColor="{DynamicResource SurfaceLight}" TextColor="{DynamicResource ErrorColor}" FontSize="18" FontAttributes="Bold" CornerRadius="16" WidthRequest="44" HeightRequest="44" CommandParameter="{Binding Hwid}" Clicked="OnRemoveDeviceClicked" VerticalOptions="Center" BorderWidth="1" BorderColor="{DynamicResource BorderColor}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout x:Name="LoadingOverlay" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="{DynamicResource StatusBlue}" WidthRequest="50" HeightRequest="50"/>
                <Label Text="СКАНИРОВАНИЕ СЕТИ..." TextColor="{DynamicResource StatusBlue}" FontSize="10" CharacterSpacing="2" FontAttributes="Bold" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>