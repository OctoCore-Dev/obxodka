<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="obxodka.Pages.SplitTunnelingPage"
             x:Name="ThisPage"
             x:ClassModifier="internal"
             BackgroundColor="#08080c"
             Title="Исключения">

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <StackLayout x:Name="HeaderSection" Grid.Row="0" Padding="20,20,20,10" Opacity="0" Scale="0.8">
            <Label Text="Раздельное туннелирование" FontSize="22" FontAttributes="Bold" TextColor="White" />
            <Label Text="Выбранные приложения будут работать напрямую, игнорируя VPN-туннель." TextColor="Gray" FontSize="13" Margin="0,5,0,0"/>

            <Border BackgroundColor="#1100AAFF" Stroke="#00AAFF" StrokeThickness="1" Margin="0,15,0,0" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Label Text="💡 Важно: после добавления приложения в исключения, перезапустите его." TextColor="#00AAFF" FontSize="12" FontAttributes="Bold"/>
            </Border>
        </StackLayout>

        <Border x:Name="VpnWarningBanner" Grid.Row="1" BackgroundColor="#33FF0044" Stroke="#FF0044" StrokeThickness="1" Margin="20,5,20,15" Padding="15" IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                <Label Text="Отключите VPN для изменения списка." TextColor="#FF0044" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <Grid x:Name="SearchSection" Grid.Row="2" ColumnDefinitions="*, Auto" Margin="20,0,20,15" ColumnSpacing="10" Opacity="0" Scale="0.8">
            <Border Grid.Column="0" BackgroundColor="#11FFFFFF" Stroke="#22FFFFFF" StrokeThickness="1" HeightRequest="50">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <SearchBar x:Name="AppSearchBar" 
                           Placeholder="Поиск приложений..." 
                           TextColor="White" 
                           PlaceholderColor="#777" 
                           CancelButtonColor="#0055ff"
                           TextChanged="OnSearchTextChanged"/>
            </Border>

            <Button x:Name="WindowsAddBtn" 
                    Grid.Column="1" 
                    Text="+ EXE" 
                    FontAttributes="Bold"
                    BackgroundColor="#0055ff" 
                    TextColor="White" 
                    CornerRadius="12" 
                    IsVisible="False"
                    Clicked="OnWindowsAddClicked" />
        </Grid>

        <CollectionView Grid.Row="3" x:Name="AppsList" Margin="20,0" Opacity="0" Scale="0.8">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 16" BackgroundColor="#11FFFFFF" Stroke="#22FFFFFF" StrokeThickness="1" Margin="0,0,0,12" Padding="15">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">

                            <Image Grid.Column="0" Source="{Binding Icon}" WidthRequest="45" HeightRequest="45" VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}" TextColor="White" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding PackageName}" TextColor="#777" FontSize="11" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Switch Grid.Column="2" 
                                    IsToggled="{Binding IsBypassed}" 
                                    OnColor="#0055ff" 
                                    IsEnabled="{Binding BindingContext.IsEditingAllowed, Source={x:Reference ThisPage}}"
                                    Toggled="OnAppToggled" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator x:Name="Loader" Grid.Row="3" IsRunning="True" Color="#0055ff" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>