<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.DeleteAccountView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Grid Padding="{OnIdiom Desktop='32,28', Default='24,20'}">
        <ScrollView
            x:Name="RootScrollView"
            SizeChanged="OnRootScrollViewSizeChanged"
            VerticalScrollBarVisibility="Default">
            <Grid x:Name="ContentGrid">
                <Border
                    Padding="28,24"
                    HorizontalOptions="Center"
                    Style="{StaticResource NeoDangerCard}"
                    VerticalOptions="Center"
                    WidthRequest="{OnIdiom Desktop=520,
                                           Default=340}">
                    <VerticalStackLayout Spacing="16">
                        <mi:MauiIcon
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Warning28}"
                            IconColor="{StaticResource Error}"
                            IconSize="42" />
                        <Label
                            FontFamily="RobotoBold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="ОПАСНАЯ ЗОНА"
                            TextColor="{StaticResource Error}" />
                        <Label
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource LabelMuted}"
                            Text="Это действие навсегда удалит ваш аккаунт и все данные. Это необратимо." />
                        <Label
                            x:Name="DeleteErrorLabel"
                            IsVisible="False"
                            Opacity="0"
                            Style="{StaticResource LabelError}" />
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                            <Border Grid.Column="0" Style="{StaticResource NeoBtnSecondary}">
                                <Button
                                    BackgroundColor="Transparent"
                                    Clicked="OnCancelDeleteClickedAsync"
                                    FontFamily="RobotoMedium"
                                    FontSize="13"
                                    Text="ОТМЕНА"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                Dark={StaticResource TextPrimary}}" />
                            </Border>
                            <Border
                                x:Name="DeleteAccountBorder"
                                Grid.Column="1"
                                Style="{StaticResource NeoBtnDanger}">
                                <Button
                                    x:Name="DeleteAccountButton"
                                    BackgroundColor="Transparent"
                                    Clicked="OnConfirmDeleteClickedAsync"
                                    FontFamily="RobotoBold"
                                    FontSize="13"
                                    Text="УДАЛИТЬ"
                                    TextColor="{StaticResource Error}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
