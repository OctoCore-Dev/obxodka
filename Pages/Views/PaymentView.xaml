<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.PaymentView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Grid Padding="{OnIdiom Desktop='32,24', Phone='16,16,16,100'}" RowDefinitions="Auto, *">
        <VerticalStackLayout
            Grid.Row="0"
            Margin="0,0,0,20"
            HorizontalOptions="Center"
            Spacing="4">
            <Label
                FontFamily="CommissionerExtraBold"
                FontSize="{OnIdiom Desktop=24,
                                   Default=22}"
                HorizontalOptions="Center"
                Text="ТАРИФНЫЕ ПЛАНЫ"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                            Dark={StaticResource TextPrimary}}" />
            <Label
                FontSize="13"
                HorizontalOptions="Center"
                Style="{StaticResource LabelMuted}"
                Text="Выберите удобный пакет часов доступа без ограничений по скорости" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" VerticalOptions="Center">
            <ScrollView
                x:Name="CardsScrollView"
                HorizontalScrollBarVisibility="Never"
                Orientation="Vertical"
                VerticalScrollBarVisibility="Never">
                <Grid
                    x:Name="CardsContainer"
                    ColumnDefinitions="{OnIdiom Desktop='*, *, *',
                                                Phone='*'}"
                    ColumnSpacing="{OnIdiom Desktop=16,
                                            Phone=0}"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="{OnIdiom Desktop=920,
                                                  Default=380}"
                    RowSpacing="{OnIdiom Desktop=0,
                                         Phone=14}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{OnIdiom Desktop=0, Phone=Auto}" />
                        <RowDefinition Height="{OnIdiom Desktop=0, Phone=Auto}" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="Card300"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="22,20"
                        Opacity="0"
                        Style="{StaticResource NeoCard}"
                        TranslationY="28">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontFamily="RobotoBold"
                                FontSize="11"
                                Text="СТАРТОВЫЙ"
                                TextColor="{StaticResource Primary}" />
                            <Label
                                FontFamily="CommissionerExtraBold"
                                FontSize="28"
                                Text="300 ₽"
                                TextColor="{StaticResource Primary}" />
                            <Label
                                FontFamily="RobotoMedium"
                                FontSize="14"
                                Style="{StaticResource LabelValue}"
                                Text="300 часов доступа" />
                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource LabelMuted}"
                                Text="Отличный выбор для знакомства и редких поездок." />

                            <Border
                                x:Name="Btn300Border"
                                Margin="0,8,0,0"
                                HeightRequest="44"
                                Style="{StaticResource NeoBtnPrimary}">
                                <Grid>
                                    <Button
                                        x:Name="Btn300"
                                        BackgroundColor="Transparent"
                                        Clicked="OnBuy300ClickedAsync"
                                        FontFamily="RobotoMedium"
                                        FontSize="13"
                                        Text="Купить за 300 ₽"
                                        TextColor="{StaticResource TextOnPrimary}" />
                                    <ActivityIndicator
                                        x:Name="Loader300"
                                        HeightRequest="22"
                                        HorizontalOptions="Center"
                                        IsRunning="True"
                                        IsVisible="False"
                                        VerticalOptions="Center"
                                        WidthRequest="22"
                                        Color="{StaticResource TextOnPrimary}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        x:Name="Card500"
                        Grid.Row="{OnIdiom Desktop=0,
                                           Phone=1}"
                        Grid.Column="{OnIdiom Desktop=1,
                                              Phone=0}"
                        Padding="22,20"
                        Opacity="0"
                        Stroke="#4000E5FF"
                        StrokeThickness="1.5"
                        Style="{StaticResource NeoCard}"
                        TranslationY="28">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="RobotoBold"
                                    FontSize="11"
                                    Text="ОПТИМАЛЬНЫЙ"
                                    TextColor="#00E5FF" />
                                <Border
                                    Grid.Column="1"
                                    Padding="6,2"
                                    BackgroundColor="#2000E5FF"
                                    Stroke="#00E5FF"
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="1">
                                    <Label
                                        FontFamily="RobotoBold"
                                        FontSize="10"
                                        Text="ХИТ"
                                        TextColor="#00E5FF" />
                                </Border>
                            </Grid>

                            <Label
                                FontFamily="CommissionerExtraBold"
                                FontSize="28"
                                Text="500 ₽"
                                TextColor="#00E5FF" />
                            <Label
                                FontFamily="RobotoMedium"
                                FontSize="14"
                                Style="{StaticResource LabelValue}"
                                Text="700 часов (+200ч бонус)" />
                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource LabelMuted}"
                                Text="Идеально на месяц активного стриминга и игр." />

                            <Border
                                x:Name="Btn500Border"
                                Margin="0,8,0,0"
                                BackgroundColor="#00E5FF"
                                HeightRequest="44"
                                Stroke="#00E5FF"
                                Style="{StaticResource NeoBtnPrimary}">
                                <Grid>
                                    <Button
                                        x:Name="Btn500"
                                        BackgroundColor="Transparent"
                                        Clicked="OnBuy500ClickedAsync"
                                        FontFamily="RobotoBold"
                                        FontSize="13"
                                        Text="Купить за 500 ₽"
                                        TextColor="#0A0A10" />
                                    <ActivityIndicator
                                        x:Name="Loader500"
                                        HeightRequest="22"
                                        HorizontalOptions="Center"
                                        IsRunning="True"
                                        IsVisible="False"
                                        VerticalOptions="Center"
                                        WidthRequest="22"
                                        Color="#0A0A10" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        x:Name="Card1000"
                        Grid.Row="{OnIdiom Desktop=0,
                                           Phone=2}"
                        Grid.Column="{OnIdiom Desktop=2,
                                              Phone=0}"
                        Padding="22,20"
                        Opacity="0"
                        Style="{StaticResource NeoCard}"
                        TranslationY="28">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontFamily="RobotoBold"
                                FontSize="11"
                                Text="МАКСИМУМ (ВЫГОДНЫЙ)"
                                TextColor="#F59E0B" />
                            <Label
                                FontFamily="CommissionerExtraBold"
                                FontSize="28"
                                Text="1000 ₽"
                                TextColor="#F59E0B" />
                            <Label
                                FontFamily="RobotoMedium"
                                FontSize="14"
                                Style="{StaticResource LabelValue}"
                                Text="2000 часов (х2 бонус)" />
                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource LabelMuted}"
                                Text="Максимальная выгода для нескольких устройств." />

                            <Border
                                x:Name="Btn1000Border"
                                Margin="0,8,0,0"
                                BackgroundColor="#F59E0B"
                                HeightRequest="44"
                                Stroke="#F59E0B"
                                Style="{StaticResource NeoBtnPrimary}">
                                <Grid>
                                    <Button
                                        x:Name="Btn1000"
                                        BackgroundColor="Transparent"
                                        Clicked="OnBuy1000ClickedAsync"
                                        FontFamily="RobotoBold"
                                        FontSize="13"
                                        Text="Купить за 1000 ₽"
                                        TextColor="#0A0A10" />
                                    <ActivityIndicator
                                        x:Name="Loader1000"
                                        HeightRequest="22"
                                        HorizontalOptions="Center"
                                        IsRunning="True"
                                        IsVisible="False"
                                        VerticalOptions="Center"
                                        WidthRequest="22"
                                        Color="#0A0A10" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
