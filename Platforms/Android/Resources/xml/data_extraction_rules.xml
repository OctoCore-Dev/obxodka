<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="root" path="no_backup"/>
    </cloud-backup>
    <device-to-device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-to-device-transfer>
</data-extraction-rules>
