# =============================================================================
# Эталонный .gitattributes для C# / .NET / кроссплатформенной разработки (Windows + WSL)
# =============================================================================

# По умолчанию: Git сам определяет текстовые и бинарные файлы
* text=auto

# Файлы C# и решений/проектов .NET -> строго CRLF
*.cs text diff=csharp eol=crlf
*.csx text diff=csharp eol=crlf
*.xaml text eol=crlf
*.axaml text eol=crlf
*.csproj text eol=crlf
*.fsproj text eol=crlf
*.vbproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.config text eol=crlf
*.editorconfig text eol=crlf
.globalconfig text eol=crlf

# Веб, JSON и конфиги -> CRLF
*.json text eol=crlf
*.xml text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.csv text eol=crlf
*.resw text eol=crlf
*.resx text eol=crlf

# Скрипты Windows -> CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Linux и контейнеры -> строго LF
*.sh text eol=lf
Dockerfile* text eol=lf
*.dockerfile text eol=lf
Caddyfile* text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Бинарные ассеты -> сырые бинарники, никогда не менять окончания строк
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.dll binary
*.exe binary
*.pdb binary
*.so binary
*.dylib binary
*.pfx binary
*.crt binary
*.key binary
*.cer binary
*.der binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.tar.gz binary
*.bin binary
*.db binary
*.sqlite binary
*.wasm binary
