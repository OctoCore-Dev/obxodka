<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:obxodka.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="obxodka.Avalonia.Views.MainWindow"
        Title="Obxodka">

    <!-- Главная сетка: колонка 150px под сайдбар и '*' под основной контент -->
    <Grid Background="{DynamicResource PrimaryBackground}" ColumnDefinitions="150, *">
        
        <!-- Вызываем наш отдельный сайдбар -->
        <views:Sidebar Grid.Column="0" />

        <!-- Здесь в будущем будет основной контент (например, Grid с Grid.Column="1") -->
        <ContentControl Grid.Column="1" />

    </Grid>

</Window>