<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="150" d:DesignHeight="500"
             x:Class="obxodka.Avalonia.Views.Sidebar">

    <!-- Сайдбар как отдельная плашка (Внешняя рамка DarkGray) -->
    <Border Margin="26" 
            Padding="4" 
            CornerRadius="16"
            Background="DarkGray"
            ClipToBounds="True">
        
        <!-- Внутренний фон сайдбара (#17171A) -->
        <Border Background="#17171A" CornerRadius="10" ClipToBounds="True">
            <Grid RowDefinitions="Auto, *, Auto" Margin="12">
                
                <!-- Верх: Логотип приложения -->
                <StackPanel Grid.Row="0" Spacing="10" HorizontalAlignment="Center">
                    <Image Source="avares://obxodka.Avalonia/Assets/AppIcon/appiconfg.png" 
                           Width="48" 
                           Height="48" />
                </StackPanel>

                <!-- Середина -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                </StackPanel>

                <!-- Низ -->
                <StackPanel Grid.Row="2">
                </StackPanel>
                
            </Grid>
        </Border>

    </Border>

</UserControl>