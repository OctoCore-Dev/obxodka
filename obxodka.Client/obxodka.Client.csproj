<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>obxodka.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Google.Protobuf" Version="3.36.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\obxodka.Shared\obxodka.Shared.csproj" />
    <ProjectReference Include="..\obxodka.Core\obxodka.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="obxodka.Client" />
    <Using Include="obxodka.Client.Platforms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="obxodka.Maui" />
    <InternalsVisibleTo Include="obxodka.Avalonia" />
    <InternalsVisibleTo Include="obxodka.Client.Tests" />
    <InternalsVisibleTo Include="obxodka.Benchmarks" />
  </ItemGroup>

</Project>
