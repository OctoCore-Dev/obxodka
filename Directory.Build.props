<Project>
  <Import Project="$(MSBuildThisFileDirectory)version.props" Condition="Exists('$(MSBuildThisFileDirectory)version.props')" />
  <PropertyGroup>
    <IsWindows Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'true' or '$(OS)' == 'Windows_NT'">true</IsWindows>
    <WorkspaceCodeRoot Condition="'$(IsWindows)' == 'true'">C:\Users\irovb\Documents\code\</WorkspaceCodeRoot>
    <WorkspaceCodeRoot Condition="'$(WorkspaceCodeRoot)' == '' and '$(HOME)' != ''">$(HOME)/code/</WorkspaceCodeRoot>
    <ProjectCacheSubDir Condition="'$(WorkspaceCodeRoot)' != '' and $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(WorkspaceCodeRoot)'))">$([System.String]::Copy('$(MSBuildProjectDirectory)').Substring('$([System.String]::Copy('$(WorkspaceCodeRoot)').Length)'))</ProjectCacheSubDir>
    <ProjectCacheSubDir Condition="'$(ProjectCacheSubDir)' == ''">$(MSBuildProjectName)</ProjectCacheSubDir>
    <CustomCachePath Condition="'$(IsWindows)' == 'true'">C:\BuildCache\$(ProjectCacheSubDir)</CustomCachePath>
    <CustomCachePath Condition="'$(CustomCachePath)' == '' and '$(HOME)' != ''">$(HOME)/cache/$(ProjectCacheSubDir)</CustomCachePath>
    <CustomCachePath Condition="'$(CustomCachePath)' == ''">C:\BuildCache\$(ProjectCacheSubDir)</CustomCachePath>
    <PackageRoot Condition="'$(IsWindows)' == 'true'">C:\Users\irovb\Documents\Package\</PackageRoot>
    <PackageRoot Condition="'$(PackageRoot)' == '' and '$(HOME)' != ''">$(HOME)/Package/</PackageRoot>
    <PackageRoot Condition="'$(PackageRoot)' == ''">C:\Users\irovb\Documents\Package\</PackageRoot>
  </PropertyGroup>

  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(CustomCachePath)</ArtifactsPath>
    <BaseOutputPath>$(CustomCachePath)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(CustomCachePath)\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(CustomCachePath)\obj\</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version Condition="'$(Version)' == ''">4.8.6</Version>
    <IsTrimmable Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">true</IsTrimmable>
    <EnableTrimAnalyzer Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' != 'true' and '$(PublishTrimmed)' != 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">false</JsonSerializerIsReflectionEnabledByDefault>
    <GITHUB_ACTIONS Condition="'$(GITHUB_ACTIONS)' == ''">false</GITHUB_ACTIONS>
    <PackageMode Condition="'$(PackageMode)' == ''">MSIX</PackageMode>
    <NoWarn>$(NoWarn);SigningCertificateNoCertSpecified;</NoWarn>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
  </PropertyGroup>

  <Target Name="SyncSharedConfigFiles" BeforeTargets="BeforeBuild" Condition="'$(IsWindows)' == 'true' and Exists('C:\Users\irovb\Documents\code\sync_configs.ps1')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;C:\Users\irovb\Documents\code\sync_configs.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;" IgnoreExitCode="true" />
  </Target>
</Project>
