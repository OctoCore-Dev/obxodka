<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreTfm)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>obxodka.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="Microsoft.Extensions.Http"/>
    <PackageReference Include="PacketDotNet"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\obxodka.Shared\obxodka.Shared.csproj"/>
    <EmbeddedResource Include="..\..\..\servers.json" LogicalName="obxodka.servers.json"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="obxodka.Client"/>
    <Using Include="obxodka.Client.Platforms"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="obxodka"/>
    <InternalsVisibleTo Include="obxodka.Maui"/>
    <InternalsVisibleTo Include="obxodka.Avalonia"/>
    <InternalsVisibleTo Include="obxodka.Platform.Windows"/>
    <InternalsVisibleTo Include="obxodka.Platform.Linux"/>
    <InternalsVisibleTo Include="obxodka.Benchmarks"/>
  </ItemGroup>

</Project>
