<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <Color x:Key="BgBase">#0E0E14</Color>
    <Color x:Key="BgSurface">#161622</Color>
    <Color x:Key="BgElevated">#202030</Color>
    <Color x:Key="BgInput">#12121B</Color>
    <Color x:Key="BgOverlay">#B3000000</Color>

    <!-- Borders -->
    <Color x:Key="SolidBorderDark">#282838</Color>
    <Color x:Key="BorderSubtle">#28283C</Color>
    <Color x:Key="BorderMedium">#363650</Color>
    <Color x:Key="BorderStrong">#4A4A68</Color>

    <!-- Primaries -->
    <Color x:Key="Primary">#0078D4</Color>
    <Color x:Key="PrimaryBright">#2B88D8</Color>
    <Color x:Key="PrimaryLight">#4C9CE1</Color>
    <Color x:Key="PrimaryDim">#005A9E</Color>
    <Color x:Key="PrimaryGlow">#004578</Color>
    <Color x:Key="PrimaryLight2">#0067C0</Color>

    <!-- Accents -->
    <Color x:Key="Accent">#00E5FF</Color>
    <Color x:Key="AccentDim">#005F6B</Color>
    <Color x:Key="AccentGlow">#0097A7</Color>
    <Color x:Key="AccentLight">#0284C7</Color>

    <!-- Purples -->
    <Color x:Key="Purple">#9F6FF0</Color>
    <Color x:Key="PurpleDim">#2A1B3D</Color>
    <Color x:Key="PurpleLight">#7C3AED</Color>
    <Color x:Key="Pink">#EC4899</Color>

    <!-- Texts -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#D0FFFFFF</Color>
    <Color x:Key="TextMuted">#90FFFFFF</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>

    <!-- Statuses -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessDim">#1F10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningDim">#1FF59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="ErrorDim">#1FEF4444</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevated}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInput}" />
    <SolidColorBrush x:Key="BgOverlayBrush" Color="{StaticResource BgOverlay}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMedium}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PrimaryBrightBrush" Color="{StaticResource PrimaryBright}" />
    <SolidColorBrush x:Key="PrimaryDimBrush" Color="{StaticResource PrimaryDim}" />
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="{StaticResource PrimaryGlow}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlow}" />

    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource Purple}" />
    <SolidColorBrush x:Key="PurpleDimBrush" Color="{StaticResource PurpleDim}" />
    <SolidColorBrush x:Key="PurpleLightBrush" Color="{StaticResource PurpleLight}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimary}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="SuccessDimBrush" Color="{StaticResource SuccessDim}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="WarningDimBrush" Color="{StaticResource WarningDim}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="ErrorDimBrush" Color="{StaticResource ErrorDim}" />

    <!-- Active sidebar item brush -->
    <SolidColorBrush x:Key="SideNavActiveBrush" Color="#220078D4" />
    <SolidColorBrush x:Key="SideNavHoverBrush" Color="#16FFFFFF" />

</ResourceDictionary>
