<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:obxodka.Avalonia"
             x:Class="obxodka.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://obxodka.Avalonia/Assets/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://obxodka.Avalonia/Assets/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://obxodka.Avalonia/Assets/Styles/Styles.axaml" />
    </Application.Styles>

</Application>
