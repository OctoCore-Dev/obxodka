<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(NetCoreTfm)</TargetFramework>
    <AssemblyName>obxodka.Avalonia</AssemblyName>
    <RootNamespace>obxodka.Avalonia</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);MVVMTK0042</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"/>
    <PackageReference Include="Avalonia.Desktop"/>
    <PackageReference Include="Avalonia.Themes.Fluent"/>
    <PackageReference Include="Avalonia.Fonts.Inter"/>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="Microsoft.Extensions.Http"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\obxodka.Client\obxodka.Client.csproj"/>
    <ProjectReference Include="..\..\core\obxodka.Shared\obxodka.Shared.csproj"/>
    <ProjectReference Include="..\..\core\obxodka.Platform.Linux\obxodka.Platform.Linux.csproj"/>
    <ProjectReference Include="..\..\core\obxodka.Platform.Windows\obxodka.Platform.Windows.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="packaging\obxodka.desktop" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
