<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:obxodka.Avalonia.ViewModels"
             x:Class="obxodka.Avalonia.Views.ProfileView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer Padding="28,24" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
      <TextBlock Text="Профиль" FontFamily="{StaticResource AppFontTitle}" FontSize="26" Foreground="{StaticResource TextPrimaryBrush}"/>

      <Border Classes="neo-card" Padding="20">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="150,*">
            <TextBlock Text="Аккаунт" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding UserEmail}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
          </Grid>
          <Separator Background="{StaticResource BorderSubtleBrush}"/>
          <Grid ColumnDefinitions="150,*">
            <TextBlock Text="Баланс времени" Foreground="{StaticResource TextMutedBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding BalanceHoursText}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
              <TextBlock Text="{Binding BalanceDaysText, StringFormat='({0})'}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
          </Grid>
          <Separator Background="{StaticResource BorderSubtleBrush}"/>
          <Grid ColumnDefinitions="150,*">
            <TextBlock Text="Реферальный код" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding ReferralCode}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
          </Grid>
          <Separator Background="{StaticResource BorderSubtleBrush}"/>
          <Grid ColumnDefinitions="150,*">
            <TextBlock Text="Версия клиента" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding AppVersionText}" Foreground="{StaticResource TextSecondaryBrush}"/>
          </Grid>
        </StackPanel>
      </Border>

      <Button Classes="danger-btn" Content="Выйти из аккаунта" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
