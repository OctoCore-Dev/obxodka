<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:obxodka.Avalonia.ViewModels"
        xmlns:views="using:obxodka.Avalonia.Views"
        xmlns:controls="using:obxodka.Avalonia.Controls"
        xmlns:conv="using:obxodka.Avalonia.Converters"
        x:Class="obxodka.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="obxodka"
        Width="1150"
        Height="750"
        MinWidth="950"
        MinHeight="620"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBaseBrush}"
        Icon="avares://obxodka.Avalonia/Assets/AppIcon/appiconfg.png">

    <Grid>
        <!-- App Grid: Sidebar + Main Content -->
        <Grid ColumnDefinitions="Auto, *">
            <!-- Sidebar (visible unless on auth tab) -->
            <views:DesktopSidebarView Grid.Column="0"
                                      IsVisible="{Binding IsSidebarVisible}" />

            <!-- Main Content Container -->
            <Grid Grid.Column="1">
                <views:VpnView IsVisible="{Binding CurrentTab, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=vpn}" />
                <views:ProfileView IsVisible="{Binding CurrentTab, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=profile}" />
                <views:ConfigurationView IsVisible="{Binding CurrentTab, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=configuration}" />
                <views:DevicesView IsVisible="{Binding CurrentTab, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=devices}" />
                <views:AuthView IsVisible="{Binding CurrentTab, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=auth}" />
            </Grid>
        </Grid>

        <!-- NeoDialog Overlay (Alerts, confirmations) -->
        <controls:NeoDialog />
    </Grid>

</Window>
