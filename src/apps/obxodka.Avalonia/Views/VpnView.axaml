<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:obxodka.Avalonia.ViewModels"
             xmlns:ctrl="using:obxodka.Avalonia.Controls"
             x:Class="obxodka.Avalonia.Views.VpnView"
             x:DataType="vm:MainViewModel">
  <!-- Точная десктопная 2-колоночная сетка 1-в-1 с obxodka.Maui/Pages/Vpn/VpnView.xaml -->
  <Grid Margin="28,24" ColumnDefinitions="*,*" ColumnSpacing="16">

    <!-- ЛЕВАЯ КОЛОНКА: Card1Wrapper (выбор сервера + тройная круглая кнопка 278/240/196 + статус) -->
    <Border Grid.Column="0" Classes="neo-card" Padding="28,28" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14"
            HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- Пилюля выбора сервера (ServerSelectorButton, CornerRadius=22) -->
        <Button Grid.Row="0" Command="{Binding ToggleServerPickerCommand}"
                Padding="16,8" CornerRadius="22"
                Background="{StaticResource BgElevatedBrush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1.2"
                HorizontalAlignment="Center" Cursor="Hand">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="26" Height="18" CornerRadius="3"
                    Background="{StaticResource AccentDimBrush}"
                    BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0.8">
              <PathIcon Data="{StaticResource IconEarth24}" Width="12" Height="12"
                        Foreground="{StaticResource AccentBrush}"/>
            </Border>

            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedServerLocationText}"
                         FontFamily="{StaticResource AppFontBold}" FontSize="13"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         MaxWidth="210" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Padding="5,1" CornerRadius="4"
                        Background="{StaticResource AccentDimBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="0.6">
                  <TextBlock Text="{Binding SelectedServerProviderText}"
                             FontFamily="{StaticResource AppFontMedium}" FontSize="9.5"
                             Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ActivePingText}"
                           FontFamily="{StaticResource AppFontMedium}" FontSize="10.5"
                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>

            <PathIcon Data="{StaticResource IconChevronDown16}" Width="13" Height="13"
                      Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0"/>
          </StackPanel>
        </Button>

        <!-- Тройная концентрическая кнопка подключения 1-в-1 (278 -> 240 -> 196) -->
        <Grid Grid.Row="1" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- Внешнее кольцо свечения -->
          <Border Width="278" Height="278" CornerRadius="139"
                  Background="Transparent"
                  BorderBrush="{Binding ConnectOuterRingBrush}" BorderThickness="1.2"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Среднее кольцо -->
            <Border Width="240" Height="240" CornerRadius="120"
                    Background="Transparent"
                    BorderBrush="{Binding ConnectMiddleRingBrush}" BorderThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- Ядро кнопки 196x196 -->
              <Button Command="{Binding ToggleVpnCommand}"
                      Width="196" Height="196" CornerRadius="98"
                      Background="{StaticResource BgElevatedBrush}"
                      BorderBrush="{Binding ConnectRingBrush}" BorderThickness="1.6"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Cursor="Hand">
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource IconPower24}" Width="46" Height="46"
                            Foreground="{Binding ConnectRingBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding ConnectButtonText}"
                             FontFamily="{StaticResource AppFontBold}" FontSize="16" LetterSpacing="1.2"
                             Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>
          </Border>
        </Grid>

        <!-- Статус подключения и живой протокол снизу -->
        <StackPanel Grid.Row="2" Spacing="6" HorizontalAlignment="Center">
          <TextBlock Text="{Binding VpnStatusText}"
                     FontFamily="{StaticResource AppFontMedium}" FontSize="15"
                     Foreground="{Binding StatusAccentBrush}"
                     HorizontalAlignment="Center" TextAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Border Classes="pill-badge" Padding="8,3">
              <TextBlock Text="{Binding ActiveProtocolText}" FontSize="11" FontFamily="{StaticResource AppFontMedium}"
                         Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Border Classes="pill-badge" Padding="8,3">
              <TextBlock Text="{Binding ActiveMtuText, StringFormat='MTU {0}'}" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
            <Border Classes="pill-badge" Padding="8,3" IsVisible="{Binding IsConnected}">
              <TextBlock Text="{Binding UptimeText}" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ПРАВАЯ КОЛОНКА: 3 карточки Auto / 2* / * 1-в-1 с TopCardsGrid в MAUI -->
    <Grid Grid.Column="1" RowDefinitions="Auto,2*,*" RowSpacing="16">

      <!-- 1. CardIp: 3 пилюли IP + Узел + Пинг -->
      <Border Grid.Row="0" Classes="neo-card" Padding="14,10">
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <!-- Пилюля IP + бейдж v4 -->
          <Border Classes="pill-badge" Margin="4,3">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconShieldCheckmark24}" Width="13" Height="13"
                        Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="{Binding AssignedIpText}" FontFamily="{StaticResource AppFontBold}"
                         FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
              <Border Padding="4,1" CornerRadius="4" IsVisible="{Binding IsConnected}"
                      Background="{StaticResource AccentDimBrush}"
                      BorderBrush="{StaticResource AccentBrush}" BorderThickness="0.6">
                <TextBlock Text="v4" FontFamily="{StaticResource AppFontBold}" FontSize="8.5"
                           Foreground="{StaticResource AccentBrush}"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Пилюля узла -->
          <Border Classes="pill-badge" Margin="4,3">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconServer24}" Width="12" Height="12"
                        Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="{Binding NodeEndpointShortText}" FontFamily="{StaticResource AppFontMedium}"
                         FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                         MaxWidth="170" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>

          <!-- Пилюля пинга (зелёная SuccessDim) -->
          <Border Margin="4,3" Padding="10,5" CornerRadius="14"
                  Background="{StaticResource SuccessDimBrush}"
                  BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ActivePingText}" FontFamily="{StaticResource AppFontBold}"
                         FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
            </StackPanel>
          </Border>
        </WrapPanel>
      </Border>

      <!-- 2. Card2: Живые скорости Отправлено / Получено + большой график трафика -->
      <Border Grid.Row="1" Classes="neo-card" Padding="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid Grid.Row="0" ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconArrowUp24}" Width="12" Height="12"
                          Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Отправлено" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding UploadSpeedText}" FontFamily="{StaticResource AppFontBold}" FontSize="17"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconArrowDown24}" Width="12" Height="12"
                          Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Получено" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding DownloadSpeedText}" FontFamily="{StaticResource AppFontBold}" FontSize="17"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="6">
            <ctrl:TrafficGraphControl x:Name="TrafficGraph"/>
          </Border>
        </Grid>
      </Border>

      <!-- 3. Card5 + Card6: Время и Трафик (2 плитки рядом 1-в-1) -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
        <!-- Плитка «Время» -->
        <Border Grid.Column="0" Classes="neo-card" Padding="14,12">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconClock24}" Width="14" Height="14"
                        Foreground="{StaticResource PrimaryBrush}"/>
              <TextBlock Text="Время" FontFamily="{StaticResource AppFontMedium}" FontSize="11.5"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconTimer24}" Width="22" Height="22"
                        Foreground="{StaticResource AccentBrush}"/>
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding BalanceHoursText}" FontFamily="{StaticResource AppFontBold}" FontSize="18"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding BalanceDaysText}" FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Плитка «Трафик» -->
        <Border Grid.Column="1" Classes="neo-card" Padding="14,12">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconDataArea24}" Width="14" Height="14"
                        Foreground="{StaticResource PrimaryBrush}"/>
              <TextBlock Text="Трафик" FontFamily="{StaticResource AppFontMedium}" FontSize="11.5"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconArrowDown24}" Width="20" Height="20"
                        Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="{Binding TotalTrafficShortText}" FontFamily="{StaticResource AppFontBold}" FontSize="18"
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
