<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:obxodka.Avalonia.ViewModels"
             xmlns:models="using:obxodka.Models"
             x:Class="obxodka.Avalonia.Views.DevicesView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer Padding="28,24" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Устройства" FontFamily="{StaticResource AppFontTitle}" FontSize="26" Foreground="{StaticResource TextPrimaryBrush}"/>
        <Button Grid.Column="1" Classes="subtle-btn" Content="Обновить" Command="{Binding RefreshDevicesCommand}"/>
      </Grid>

      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:DeviceItem">
            <Border Classes="neo-card" Margin="0,0,0,10" Padding="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                  <TextBlock Text="{Binding LastActiveText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="danger-btn" Content="Удалить"
                        IsVisible="{Binding !IsCurrentDevice}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveDeviceCommand}"
                        CommandParameter="{Binding}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
