<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="obxodka.Pages.Account.ProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:account="clr-namespace:obxodka.Pages.Account"
    x:Name="ThisProfileView">
    <Grid
        x:Name="RootLayoutGrid"
        Padding="16,0"
        SafeAreaEdges="None">
        <ScrollView
            x:Name="ProfileScrollView"
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never"
            Orientation="Vertical"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                x:Name="ContentStack"
                Padding="0,24,0,28"
                HorizontalOptions="Fill"
                Spacing="14">

                <Label
                    x:Name="ProfileTitleLabel"
                    Margin="0,0,0,4"
                    HorizontalOptions="Start"
                    Style="{StaticResource PageHeaderTitle}"
                    Text="Профиль" />

                <Grid
                    x:Name="ProfileTopGrid"
                    ColumnDefinitions="*"
                    ColumnSpacing="0"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="14">

                    <Border
                        x:Name="CardProfile"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="20"
                        Style="{StaticResource NeoCard}"
                        VerticalOptions="Fill">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource BgElevated}"
                                HeightRequest="54"
                                Stroke="{DynamicResource BorderMedium}"
                                StrokeShape="RoundRectangle 27"
                                StrokeThickness="1"
                                VerticalOptions="Center"
                                WidthRequest="54">
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Person24}"
                                    IconColor="{DynamicResource Primary}"
                                    IconSize="26"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Image
                                        x:Name="ProfileProviderIcon"
                                        HeightRequest="14"
                                        Source="google_logo.png"
                                        VerticalOptions="Center"
                                        WidthRequest="14" />
                                    <Label
                                        x:Name="ProfileProviderLabel"
                                        CharacterSpacing="1"
                                        FontSize="10"
                                        Style="{StaticResource LabelMuted}"
                                        Text="GOOGLE АККАУНТ"
                                        TextTransform="Uppercase"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    x:Name="ProfileEmailLabel"
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="16"
                                    LineBreakMode="TailTruncation"
                                    Text="email@example.com" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="CardBalance"
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="20"
                        Style="{StaticResource NeoCard}"
                        VerticalOptions="Fill">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <HorizontalStackLayout
                                    Grid.Column="0"
                                    Spacing="20"
                                    VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontSize="10"
                                            Style="{StaticResource LabelMuted}"
                                            Text="БАЛАНС" />
                                        <Label
                                            x:Name="ProfileTokenLabel"
                                            FontFamily="{DynamicResource AppFontBold}"
                                            FontSize="18"
                                            LineBreakMode="TailTruncation"
                                            Text="0ч 00м"
                                            TextColor="{DynamicResource Accent}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        x:Name="SubscriptionContainer"
                                        IsVisible="False"
                                        Spacing="2">
                                        <Label
                                            FontSize="10"
                                            Style="{StaticResource LabelMuted}"
                                            Text="ПОДПИСКА" />
                                        <Label
                                            x:Name="ProfileSubLabel"
                                            FontFamily="{DynamicResource AppFontBold}"
                                            FontSize="14"
                                            Text="до 01.01.2026"
                                            TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Clicked="OnBuyTokensClicked"
                                    HeightRequest="40"
                                    MinimumHeightRequest="0"
                                    Padding="16,0"
                                    Text="Пополнить"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Grid
                                x:Name="AcquiringNoticeRow"
                                Margin="0,4,0,0"
                                ColumnDefinitions="Auto, *"
                                ColumnSpacing="8"
                                IsVisible="{OnPlatform WinUI=True,
                                                       Android=False,
                                                       Default=False}">
                                <mi:MauiIcon
                                    Grid.Column="0"
                                    Icon="{mi:Fluent Icon=Info16}"
                                    IconColor="{DynamicResource Primary}"
                                    IconSize="14"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="11"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="После оплаты банковская обработка (СБП/карты) занимает 2-15 минут. Часы начисляются автоматически." />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label
                    Margin="0,6,0,0"
                    Style="{StaticResource SectionTitle}"
                    Text="ПРИВАТНОСТЬ И ФИЛЬТРАЦИЯ" />

                <Border
                    x:Name="CardAdBlock"
                    Padding="16,14"
                    Style="{StaticResource SettingsRowCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Shield24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="15"
                                    Text="Блокировка рекламы" />
                                <Label
                                    x:Name="AdBlockSubtitleLabel"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="L3 фильтрация рекламы и трекеров" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="AdBlockSwitch"
                                Grid.Column="2"
                                IsEnabled="{Binding IsEditingAllowed, Source={x:Reference ThisProfileView}, x:DataType=account:ProfileView}"
                                Toggled="OnAdBlockToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <Border Margin="0,6,0,0" Style="{StaticResource WarningBanner}">
                            <Label
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="Изменение настройки возможно только при выключенном VPN."
                                TextColor="{DynamicResource Error}"
                                VerticalTextAlignment="Center" />
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsEditingAllowed, Source={x:Reference ThisProfileView}, x:DataType=account:ProfileView}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardTelemetry"
                    Padding="16,14"
                    Style="{StaticResource SettingsRowCard}">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=DataUsage24}"
                            IconColor="{DynamicResource Accent}"
                            IconSize="22"
                            VerticalOptions="Center" />
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="15"
                                Text="Телеметрия" />
                            <Label
                                LineBreakMode="WordWrap"
                                Style="{StaticResource LabelMuted}"
                                Text="Отправлять анонимную статистику ошибок" />
                        </VerticalStackLayout>
                        <Switch
                            x:Name="TelemetrySwitch"
                            Grid.Column="2"
                            Toggled="OnTelemetryToggled"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border
                    x:Name="CardPromo"
                    Padding="18"
                    IsVisible="{OnPlatform WinUI=True,
                                           Default=False}"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Gift24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="15"
                                    Text="Промокод и реферальная программа" />
                                <Label
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Активируйте промокод или пригласите друга (+24 часа бонуса)" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="2"
                                Padding="10,6"
                                BackgroundColor="{DynamicResource BgElevated}"
                                Stroke="{DynamicResource BorderSubtle}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCopyReferralCodeClickedAsync" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label
                                        x:Name="MyReferralCodeLabel"
                                        FontFamily="{DynamicResource AppFontBold}"
                                        FontSize="12"
                                        Text="OBX-..."
                                        TextColor="{DynamicResource Accent}"
                                        VerticalOptions="Center" />
                                    <mi:MauiIcon
                                        Icon="{mi:Fluent Icon=Copy20}"
                                        IconColor="{DynamicResource TextSecondary}"
                                        IconSize="15"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Border
                                Grid.Column="0"
                                Padding="12,0"
                                HeightRequest="42"
                                Style="{StaticResource NeoInput}">
                                <Entry
                                    x:Name="PromoCodeEntry"
                                    BackgroundColor="Transparent"
                                    Completed="OnActivatePromoClickedAsync"
                                    FontSize="14"
                                    Placeholder="Введите промокод или код друга..."
                                    PlaceholderColor="{DynamicResource TextMuted}"
                                    ReturnType="Send"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border
                                x:Name="BtnActivatePromoBorder"
                                Grid.Column="1"
                                Padding="16,0"
                                HeightRequest="42"
                                MinimumWidthRequest="130"
                                Style="{StaticResource NeoBtnPrimary}">
                                <Grid>
                                    <Button
                                        x:Name="BtnActivatePromo"
                                        BackgroundColor="Transparent"
                                        Clicked="OnActivatePromoClickedAsync"
                                        FontFamily="{DynamicResource AppFontBold}"
                                        FontSize="13"
                                        MinimumHeightRequest="0"
                                        Text="Активировать"
                                        TextColor="{DynamicResource TextOnPrimary}" />
                                    <ActivityIndicator
                                        x:Name="LoaderActivatePromo"
                                        HeightRequest="20"
                                        HorizontalOptions="Center"
                                        IsRunning="True"
                                        IsVisible="False"
                                        VerticalOptions="Center"
                                        WidthRequest="20"
                                        Color="{DynamicResource TextOnPrimary}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label
                    Margin="0,6,0,0"
                    Style="{StaticResource SectionTitle}"
                    Text="УПРАВЛЕНИЕ АККАУНТОМ" />

                <Border
                    x:Name="CardLogout"
                    Padding="16,14"
                    IsVisible="False"
                    Style="{StaticResource SettingsRowCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=SignOut24}"
                            IconColor="{DynamicResource Error}"
                            IconSize="22"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="15"
                            Text="Выйти из аккаунта"
                            TextColor="{DynamicResource Error}"
                            VerticalOptions="Center" />
                        <mi:MauiIcon
                            Grid.Column="2"
                            Icon="{mi:Fluent Icon=ChevronRight24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="18"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border
                    x:Name="CardDeleteAccount"
                    Padding="16,14"
                    Style="{StaticResource SettingsRowCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteAccountClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=Delete24}"
                            IconColor="{DynamicResource Error}"
                            IconSize="22"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="15"
                            Text="Удалить аккаунт"
                            TextColor="{DynamicResource Error}"
                            VerticalOptions="Center" />
                        <mi:MauiIcon
                            Grid.Column="2"
                            Icon="{mi:Fluent Icon=ChevronRight24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="18"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
