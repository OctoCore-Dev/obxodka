<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="obxodka.Pages.Account.DevicesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        x:Name="RootLayout"
        Padding="16,20,16,0"
        RowDefinitions="Auto, *"
        RowSpacing="14"
        SafeAreaEdges="None">

        <Label
            Grid.Row="0"
            HorizontalOptions="Start"
            Style="{StaticResource PageHeaderTitle}"
            Text="Устройства"
            VerticalOptions="Center" />

        <Grid
            Grid.Row="1"
            RowDefinitions="*">
            <ActivityIndicator
                x:Name="DevicesLoadingOverlay"
                HorizontalOptions="Center"
                IsRunning="True"
                IsVisible="False"
                VerticalOptions="Center" />
            <Label
                x:Name="DevicesErrorLabel"
                HorizontalOptions="Center"
                IsVisible="False"
                Opacity="0"
                Style="{StaticResource LabelError}"
                VerticalOptions="Center" />
            <ScrollView
                x:Name="DevicesScrollView"
                HorizontalOptions="Fill"
                HorizontalScrollBarVisibility="Never"
                Orientation="Vertical"
                VerticalScrollBarVisibility="Never">
                <Grid
                    x:Name="DevicesGrid"
                    Padding="0,0,0,28"
                    ColumnDefinitions="*"
                    ColumnSpacing="0"
                    HorizontalOptions="Fill"
                    RowSpacing="14"
                    VerticalOptions="Start" />
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
