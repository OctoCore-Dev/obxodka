<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.ThemeStoreView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Grid
        x:Name="RootLayout"
        Padding="{OnIdiom Desktop='32,28',
                          Phone='16,10,16,0',
                          Default='16,20'}"
        RowDefinitions="Auto, *"
        RowSpacing="16"
        SafeAreaEdges="None">

        <Grid
            Grid.Row="0"
            Margin="{OnIdiom Phone='0,8,0,0',
                             Default='0'}"
            ColumnDefinitions="Auto, *, Auto"
            ColumnSpacing="10"
            VerticalOptions="Center">
            <Border
                x:Name="BtnBack"
                Grid.Column="0"
                Padding="{OnIdiom Phone='0',
                                  Default='12,0'}"
                HeightRequest="40"
                Style="{StaticResource NeoCard}"
                VerticalOptions="Center"
                WidthRequest="{OnIdiom Phone=40,
                                       Default=-1}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="8"
                    VerticalOptions="Center">
                    <mi:MauiIcon
                        Icon="{mi:Fluent Icon=ArrowLeft24}"
                        IconColor="{DynamicResource TextPrimary}"
                        IconSize="18"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="BtnBackText"
                        FontFamily="{DynamicResource AppFontMedium}"
                        FontSize="13"
                        Text="Назад"
                        TextColor="{DynamicResource TextPrimary}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Grid
                Grid.Column="1"
                ColumnDefinitions="Auto, *"
                ColumnSpacing="10"
                VerticalOptions="Center">
                <Border
                    x:Name="HeaderIconBadge"
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource PrimaryDim}"
                    HeightRequest="36"
                    StrokeShape="RoundRectangle 18"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="36">
                    <mi:MauiIcon
                        x:Name="HeaderIcon"
                        HorizontalOptions="Center"
                        Icon="{mi:Fluent Icon=Color24}"
                        IconColor="{DynamicResource Primary}"
                        IconSize="20"
                        VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label
                        FontFamily="{DynamicResource AppFontTitle}"
                        FontSize="{OnIdiom Desktop=20,
                                           Phone=16,
                                           Default=18}"
                        LineBreakMode="TailTruncation"
                        Text="Темы оформления"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="11"
                        IsVisible="{OnIdiom Desktop=True,
                                            Default=False}"
                        LineBreakMode="TailTruncation"
                        Style="{StaticResource LabelMuted}"
                        Text="Кастомизация приложения и живые темы" />
                </VerticalStackLayout>
            </Grid>

            <Border
                x:Name="BtnResetTheme"
                Grid.Column="2"
                Padding="{OnIdiom Phone='0',
                                  Default='12,0'}"
                HeightRequest="40"
                Style="{StaticResource NeoCard}"
                VerticalOptions="Center"
                WidthRequest="{OnIdiom Phone=40,
                                       Default=-1}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnResetThemeClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="6"
                    VerticalOptions="Center">
                    <mi:MauiIcon
                        Icon="{mi:Fluent Icon=ArrowReset24}"
                        IconColor="{DynamicResource TextMuted}"
                        IconSize="17"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="BtnResetText"
                        FontFamily="{DynamicResource AppFontMedium}"
                        FontSize="12"
                        Text="Сброс темы"
                        TextColor="{DynamicResource TextMuted}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <ScrollView
            x:Name="ThemeScrollView"
            Grid.Row="1"
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                x:Name="ThemeCardsStack"
                Padding="{OnIdiom Phone='0,0,0,120',
                                  Default='0,0,0,24'}"
                HorizontalOptions="Start"
                Spacing="16">

                <Border
                    x:Name="CardSearch"
                    Padding="14,6"
                    Style="{StaticResource NeoCard}">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Fluent Icon=Search24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="18"
                            VerticalOptions="Center" />
                        <Entry
                            x:Name="SearchEntry"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            Placeholder="Поиск тем (сакура, neon, cyberpunk, dark)..."
                            PlaceholderColor="{DynamicResource TextMuted}"
                            TextChanged="OnSearchTextChanged"
                            TextColor="{DynamicResource TextPrimary}" />
                        <Border
                            x:Name="BtnClearSearch"
                            Grid.Column="2"
                            Padding="4"
                            BackgroundColor="Transparent"
                            HeightRequest="30"
                            IsVisible="False"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="30">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearSearchClicked" />
                            </Border.GestureRecognizers>
                            <mi:MauiIcon
                                Icon="{mi:Fluent Icon=Dismiss24}"
                                IconColor="{DynamicResource TextMuted}"
                                IconSize="16" />
                        </Border>
                    </Grid>
                </Border>

                <Grid
                    x:Name="TabsGrid"
                    ColumnDefinitions="*, *, Auto"
                    ColumnSpacing="10">
                    <Border
                        x:Name="BtnTabCommunity"
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource Primary}"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabCommunityClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="8"
                            VerticalOptions="Center">
                            <mi:MauiIcon
                                x:Name="IconTabCommunity"
                                Icon="{mi:Fluent Icon=Globe24}"
                                IconColor="{DynamicResource TextOnPrimary}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="LabelTabCommunity"
                                FontFamily="{DynamicResource AppFontBold}"
                                FontSize="13"
                                Text="Сообщество"
                                TextColor="{DynamicResource TextOnPrimary}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        x:Name="BtnTabInstalled"
                        Grid.Column="1"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 12"
                        Style="{StaticResource NeoCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabInstalledClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="8"
                            VerticalOptions="Center">
                            <mi:MauiIcon
                                x:Name="IconTabInstalled"
                                Icon="{mi:Fluent Icon=Folder24}"
                                IconColor="{DynamicResource TextMuted}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="LabelTabInstalled"
                                FontFamily="{DynamicResource AppFontBold}"
                                FontSize="13"
                                Text="Установленные"
                                TextColor="{DynamicResource TextMuted}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        x:Name="BtnSync"
                        Grid.Column="2"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 12"
                        Style="{StaticResource NeoCard}"
                        ToolTipProperties.Text="Синхронизировать с GitHub"
                        WidthRequest="42">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSyncClickedAsync" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon
                            x:Name="IconSync"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=ArrowSync24}"
                            IconColor="{DynamicResource TextPrimary}"
                            IconSize="18"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <ScrollView
                    x:Name="FilterChipsScrollView"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <HorizontalStackLayout x:Name="FilterChipsLayout" Spacing="8">
                        <Border
                            x:Name="ChipFilterAll"
                            Padding="14,7"
                            BackgroundColor="{DynamicResource Primary}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterAllClicked" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="LabelFilterAll"
                                FontFamily="{DynamicResource AppFontBold}"
                                FontSize="12"
                                Text="Все"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            x:Name="ChipFilterVideo"
                            Padding="14,7"
                            BackgroundColor="{DynamicResource BgSurface}"
                            Stroke="{DynamicResource BorderSubtle}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterVideoClicked" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="LabelFilterVideo"
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="12"
                                Text="Видео"
                                TextColor="{DynamicResource TextMuted}"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            x:Name="ChipFilterAnim"
                            Padding="14,7"
                            BackgroundColor="{DynamicResource BgSurface}"
                            Stroke="{DynamicResource BorderSubtle}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterAnimClicked" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="LabelFilterAnim"
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="12"
                                Text="Анимация"
                                TextColor="{DynamicResource TextMuted}"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            x:Name="ChipFilterSound"
                            Padding="14,7"
                            BackgroundColor="{DynamicResource BgSurface}"
                            Stroke="{DynamicResource BorderSubtle}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterSoundClicked" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="LabelFilterSound"
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="12"
                                Text="Звук"
                                TextColor="{DynamicResource TextMuted}"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            x:Name="ChipFilterShaders"
                            Padding="14,7"
                            BackgroundColor="{DynamicResource BgSurface}"
                            Stroke="{DynamicResource BorderSubtle}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilterShadersClicked" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="LabelFilterShaders"
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="12"
                                Text="Шейдеры"
                                TextColor="{DynamicResource TextMuted}"
                                VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <Border
                    x:Name="CardVfxSettings"
                    Padding="18,14"
                    Style="{StaticResource NeoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border
                                x:Name="BadgeSounds"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource PrimaryDim}"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <mi:MauiIcon
                                    x:Name="IconSounds"
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Speaker224}"
                                    IconColor="{DynamicResource Primary}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="14"
                                    Text="Звуковые эффекты темы"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Воспроизведение звуков клика и подключения к туннелю" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="SwitchSounds"
                                Grid.Column="2"
                                Toggled="OnSoundsToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Grid
                                Margin="48,0,0,0"
                                ColumnDefinitions="*, Auto"
                                ColumnSpacing="10">
                                <Label
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="12"
                                    Text="Громкость звуковых эффектов"
                                    TextColor="{DynamicResource TextSecondary}"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="LabelSoundVolumeValue"
                                    Grid.Column="1"
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="13"
                                    HorizontalOptions="End"
                                    Text="80%"
                                    TextColor="{DynamicResource Primary}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Slider
                                x:Name="SliderSoundVolume"
                                Margin="48,0,0,0"
                                Maximum="1.0"
                                MaximumTrackColor="{DynamicResource BorderSubtle}"
                                Minimum="0.0"
                                MinimumTrackColor="{DynamicResource Primary}"
                                ThumbColor="{DynamicResource Primary}"
                                ValueChanged="OnSoundVolumeChanged" />
                        </VerticalStackLayout>

                        <Grid
                            Margin="48,0,0,0"
                            ColumnDefinitions="*, Auto"
                            ColumnSpacing="12"
                            IsVisible="False">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="13"
                                    Text="Фоновый эмбиент темы"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Зацикленная атмосфера темы при открытом окне" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="SwitchAmbientSound"
                                Grid.Column="1"
                                Toggled="OnAmbientSoundToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <Grid
                            Margin="48,0,0,0"
                            ColumnDefinitions="*, Auto"
                            ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="13"
                                    Text="Звуки кликов мыши"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Озвучивание нажатий на кнопки и переключатели" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="SwitchClickSounds"
                                Grid.Column="1"
                                Toggled="OnClickSoundsToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            x:Name="SepVfx1"
                            HeightRequest="1"
                            Color="{DynamicResource BorderSubtle}" />

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border
                                x:Name="BadgeParticles"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource PrimaryDim}"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <mi:MauiIcon
                                    x:Name="IconParticles"
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Sparkle24}"
                                    IconColor="{DynamicResource Accent}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="14"
                                    Text="Живая анимация и частицы"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Анимированные частицы (лепестки сакуры, снежинки, звёзды)" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="SwitchParticles"
                                Grid.Column="2"
                                Toggled="OnParticlesToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            x:Name="SepVfxFrames"
                            HeightRequest="1"
                            Color="{DynamicResource BorderSubtle}" />

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border
                                x:Name="BadgeFrames"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource PrimaryDim}"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <mi:MauiIcon
                                    x:Name="IconFrames"
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Image24}"
                                    IconColor="{DynamicResource Primary}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="14"
                                    Text="Декоративные рамки"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Рамка экрана, угловые элементы и обрамление карточек темы" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="SwitchFrames"
                                Grid.Column="2"
                                Toggled="OnFramesToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            x:Name="SepVfx2"
                            HeightRequest="1"
                            Color="{DynamicResource BorderSubtle}" />

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border
                                x:Name="BadgeVideo"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource PrimaryDim}"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <mi:MauiIcon
                                    x:Name="IconVideo"
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Video24}"
                                    IconColor="{DynamicResource Primary}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="14"
                                    Text="Видео-фон темы"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Воспроизводить живой видео-ролик на фоне (вместо картинки)" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="SwitchVideoBackground"
                                Grid.Column="2"
                                Toggled="OnVideoBackgroundToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            x:Name="SepVfx3"
                            HeightRequest="1"
                            Color="{DynamicResource BorderSubtle}" />

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border
                                x:Name="BadgeAlwaysPlay"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource PrimaryDim}"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <mi:MauiIcon
                                    x:Name="IconAlwaysPlay"
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Flash24}"
                                    IconColor="{DynamicResource Accent}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="14"
                                    Text="Всегда активные эффекты и видео"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Не ставить видео и эффекты на паузу при потере фокуса или сворачивании окна" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="SwitchAlwaysPlayVideo"
                                Grid.Column="2"
                                Toggled="OnAlwaysPlayVideoToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            x:Name="SepVfxParallax"
                            HeightRequest="1"
                            Color="{DynamicResource BorderSubtle}" />

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border
                                x:Name="BadgeParallax"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource PrimaryDim}"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <mi:MauiIcon
                                    x:Name="IconParallax"
                                    HorizontalOptions="Center"
                                    Icon="{mi:Fluent Icon=Glance24}"
                                    IconColor="{DynamicResource PrimaryBright}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="14"
                                    Text="Параллакс и движение обоев"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label
                                    FontSize="11"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Тонкое смещение фоновой картинки за курсором мыши" />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="SwitchParallax"
                                Grid.Column="2"
                                Toggled="OnParallaxToggled"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            x:Name="SepVfx4"
                            HeightRequest="1"
                            Color="{DynamicResource BorderSubtle}" />

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border
                                    x:Name="BadgeOpacity"
                                    Grid.Column="0"
                                    BackgroundColor="{DynamicResource PrimaryDim}"
                                    HeightRequest="36"
                                    StrokeShape="RoundRectangle 18"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <mi:MauiIcon
                                        x:Name="IconOpacity"
                                        HorizontalOptions="Center"
                                        Icon="{mi:Fluent Icon=Color24}"
                                        IconColor="{DynamicResource Primary}"
                                        IconSize="18"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{DynamicResource AppFontBold}"
                                        FontSize="14"
                                        Text="Прозрачность карточек"
                                        TextColor="{DynamicResource TextPrimary}" />
                                    <Label
                                        FontSize="11"
                                        Style="{StaticResource LabelMuted}"
                                        Text="Регулировка прозрачности интерфейса, чтобы видеть фон темы" />
                                </VerticalStackLayout>
                                <Label
                                    x:Name="LabelCardOpacityValue"
                                    Grid.Column="2"
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="14"
                                    HorizontalOptions="End"
                                    Text="85%"
                                    TextColor="{DynamicResource Primary}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Slider
                                x:Name="SliderCardOpacity"
                                Margin="48,0,0,0"
                                Maximum="1.0"
                                MaximumTrackColor="{DynamicResource BorderSubtle}"
                                Minimum="0.2"
                                MinimumTrackColor="{DynamicResource Primary}"
                                ThumbColor="{DynamicResource Primary}"
                                ValueChanged="OnCardOpacityChanged" />
                        </VerticalStackLayout>

                        <BoxView
                            x:Name="SepVfx5"
                            HeightRequest="1"
                            Color="{DynamicResource BorderSubtle}" />

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border
                                    x:Name="BadgeGlow"
                                    Grid.Column="0"
                                    BackgroundColor="{DynamicResource PrimaryDim}"
                                    HeightRequest="36"
                                    StrokeShape="RoundRectangle 18"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <mi:MauiIcon
                                        x:Name="IconGlow"
                                        HorizontalOptions="Center"
                                        Icon="{mi:Fluent Icon=WeatherMoon24}"
                                        IconColor="{DynamicResource Accent}"
                                        IconSize="18"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{DynamicResource AppFontBold}"
                                        FontSize="14"
                                        Text="Интенсивность неонового свечения"
                                        TextColor="{DynamicResource TextPrimary}" />
                                    <Label
                                        FontSize="11"
                                        Style="{StaticResource LabelMuted}"
                                        Text="Регулировка яркости неоновой ауры и квантового кристалла" />
                                </VerticalStackLayout>
                                <Label
                                    x:Name="LabelGlowIntensityValue"
                                    Grid.Column="2"
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="14"
                                    HorizontalOptions="End"
                                    Text="100%"
                                    TextColor="{DynamicResource Accent}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Slider
                                x:Name="SliderGlowIntensity"
                                Margin="48,0,0,0"
                                Maximum="2.0"
                                MaximumTrackColor="{DynamicResource BorderSubtle}"
                                Minimum="0.0"
                                MinimumTrackColor="{DynamicResource Accent}"
                                ThumbColor="{DynamicResource Accent}"
                                ValueChanged="OnGlowIntensityChanged" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator
                    x:Name="CatalogLoadingIndicator"
                    HorizontalOptions="Center"
                    IsRunning="True"
                    IsVisible="True"
                    Color="{DynamicResource Primary}" />

                <Label
                    x:Name="LabelStatus"
                    Margin="0,8"
                    FontSize="13"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    IsVisible="False"
                    Style="{StaticResource LabelMuted}" />

                <VerticalStackLayout
                    x:Name="ThemesContainer"
                    HorizontalOptions="Start"
                    Spacing="14" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid
            x:Name="ThemePreviewModalOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="{OnIdiom Desktop='-32,-28',
                             Phone='-16,-10,-16,0',
                             Default='-16,-20'}"
            BackgroundColor="{DynamicResource BgOverlay}"
            HorizontalOptions="Fill"
            InputTransparent="True"
            IsVisible="False"
            Opacity="0"
            VerticalOptions="Fill">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnClosePreviewModalClicked" />
            </Grid.GestureRecognizers>

            <Border
                x:Name="ThemePreviewModalCard"
                Margin="20"
                Padding="22"
                HorizontalOptions="Center"
                MaximumWidthRequest="520"
                Stroke="{DynamicResource BorderMedium}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="1.2"
                Style="{StaticResource NeoCard}"
                VerticalOptions="Center"
                WidthRequest="{OnIdiom Desktop=480,
                                       Phone=340,
                                       Default=440}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    x:Name="PreviewModalTitleLabel"
                                    FontFamily="{DynamicResource AppFontTitle}"
                                    FontSize="18"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="PreviewModalVersionLabel"
                                    FontFamily="{DynamicResource AppFontMedium}"
                                    FontSize="12"
                                    TextColor="{DynamicResource TextMuted}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label
                                x:Name="PreviewModalAuthorLabel"
                                FontFamily="{DynamicResource AppFontMedium}"
                                FontSize="12"
                                TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="6"
                            BackgroundColor="{DynamicResource BgElevated}"
                            Stroke="{DynamicResource BorderMedium}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            VerticalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClosePreviewModalClicked" />
                            </Border.GestureRecognizers>
                            <mi:MauiIcon
                                Icon="{mi:Fluent Icon=Dismiss16}"
                                IconColor="{DynamicResource TextSecondary}"
                                IconSize="14" />
                        </Border>
                    </Grid>

                    <Border
                        HeightRequest="{OnIdiom Desktop=220,
                                                Phone=160,
                                                Default=200}"
                        Stroke="{DynamicResource BorderSubtle}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1">
                        <Grid BackgroundColor="{DynamicResource BgElevated}">
                            <Image
                                x:Name="PreviewModalBannerImage"
                                Aspect="AspectFill"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                        </Grid>
                    </Border>

                    <Label
                        x:Name="PreviewModalDescLabel"
                        FontFamily="{DynamicResource AppFontRegular}"
                        FontSize="13"
                        TextColor="{DynamicResource TextSecondary}" />

                    <HorizontalStackLayout
                        x:Name="PreviewModalSwatchesLayout"
                        IsVisible="False"
                        Spacing="8" />

                    <FlexLayout
                        x:Name="PreviewModalBadgesLayout"
                        AlignItems="Center"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap" />

                    <Border
                        x:Name="BtnPreviewModalAction"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 12"
                        Style="{StaticResource NeoBtnPrimary}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPreviewModalActionClickedAsync" />
                        </Border.GestureRecognizers>
                        <Label
                            x:Name="LabelPreviewModalAction"
                            FontFamily="{DynamicResource AppFontBold}"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="Применить тему"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
