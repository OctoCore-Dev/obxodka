<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.DesktopSidebarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:obxodka.Helpers"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:views="clr-namespace:obxodka.Views">
    <Border
        x:Name="DesktopSidebar"
        Margin="16,16,0,16"
        Padding="16,24"
        helpers:UIAnimations.AnimateEntrance="False"
        Opacity="0"
        Style="{StaticResource NeoCard}"
        TranslationX="-36"
        WidthRequest="84">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnSidebarTapped" />
        </Border.GestureRecognizers>
        <Grid RowDefinitions="Auto, *, Auto" RowSpacing="0">
            <Grid
                Grid.Row="0"
                Margin="0,0,0,32"
                ColumnDefinitions="50, *"
                VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoTapped" />
                </Grid.GestureRecognizers>

                <Image
                    x:Name="AppLogoImage"
                    Grid.Column="0"
                    Aspect="AspectFit"
                    HeightRequest="32"
                    HorizontalOptions="Center"
                    Source="app_logo.png"
                    VerticalOptions="Center"
                    WidthRequest="32" />
                <Label
                    x:Name="AppLogoText"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    FontFamily="{DynamicResource AppFontBold}"
                    FontSize="24"
                    LineBreakMode="NoWrap"
                    Opacity="0"
                    Text="OBXODKA"
                    TextColor="{DynamicResource TextPrimary}"
                    VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="8">

                <Border x:Name="SideNavVpn" Style="{StaticResource SideNavItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavVpnTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                    </Border.GestureRecognizers>
                    <Grid Padding="0,8" ColumnDefinitions="50, *">
                        <mi:MauiIcon
                            x:Name="NavVpnIcon"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Shield24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="22"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="LabelVpn"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="14"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Text="VPN"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="SideNavProfile" Style="{StaticResource SideNavItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfileTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                    </Border.GestureRecognizers>
                    <Grid Padding="0,8" ColumnDefinitions="50, *">
                        <mi:MauiIcon
                            x:Name="NavProfileIcon"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Person24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="22"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="LabelProfile"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="14"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Text="Профиль"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="SideNavConfiguration" Style="{StaticResource SideNavItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavConfigurationTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                    </Border.GestureRecognizers>
                    <Grid Padding="0,8" ColumnDefinitions="50, *">
                        <mi:MauiIcon
                            x:Name="NavConfigurationIcon"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Settings24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="22"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="LabelConfiguration"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="14"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Text="Конфигурация"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="SideNavDevices" Style="{StaticResource SideNavItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavDevicesTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                    </Border.GestureRecognizers>
                    <Grid Padding="0,8" ColumnDefinitions="50, *">
                        <mi:MauiIcon
                            x:Name="NavDevicesIcon"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=PhoneDesktop24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="22"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="LabelDevices"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="14"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Text="Устройства"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="SideNavSplit" Style="{StaticResource SideNavItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavSplitTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                    </Border.GestureRecognizers>
                    <Grid Padding="0,8" ColumnDefinitions="50, *">
                        <mi:MauiIcon
                            x:Name="NavSplitIcon"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=AppsList24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="22"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="LabelSplit"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="14"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Text="Разделение трафика"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <BoxView
                    Margin="12,8,12,8"
                    HeightRequest="1"
                    Color="{DynamicResource BorderSubtle}" />

                <Border x:Name="NavBug" Style="{StaticResource SideNavItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavBugTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                    </Border.GestureRecognizers>
                    <Grid Padding="0,8" ColumnDefinitions="50, *">
                        <mi:MauiIcon
                            x:Name="NavBugIcon"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Bug24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="LabelBug"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="14"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Text="Отправка бага"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="NavReviews" Style="{StaticResource SideNavItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavReviewsTapped" />
                        <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                    </Border.GestureRecognizers>
                    <Grid Padding="0,8" ColumnDefinitions="50, *">
                        <mi:MauiIcon
                            x:Name="NavReviewsIcon"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Star24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="LabelReviews"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontFamily="{DynamicResource AppFontMedium}"
                            FontSize="14"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Text="Отзывы"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="2"
                Margin="0,16,0,0"
                Spacing="16">

                <Border
                    x:Name="VpnStatusCard"
                    Padding="0,8"
                    helpers:UIAnimations.AnimateEntrance="False"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    Style="{StaticResource NeoCard}">
                    <Grid ColumnDefinitions="50, *">
                        <BoxView
                            x:Name="VpnStatusDot"
                            Grid.Column="0"
                            CornerRadius="5"
                            HeightRequest="10"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="10"
                            Color="{DynamicResource TextMuted}" />
                        <Label
                            x:Name="VpnStatusLabel"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontSize="13"
                            HorizontalOptions="Start"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Style="{StaticResource LabelMuted}"
                            Text="Отключен"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border
                    x:Name="LogoutButtonBorder"
                    HeightRequest="44"
                    Style="{StaticResource NeoBtnDanger}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                        <PointerGestureRecognizer PointerEntered="OnPointerEnteredAsync" PointerExited="OnPointerExitedAsync" />
                    </Border.GestureRecognizers>
                    <Grid Padding="0,10" ColumnDefinitions="50, *">
                        <mi:MauiIcon
                            x:Name="LogoutIcon"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=ArrowExit20}"
                            IconColor="{DynamicResource Error}"
                            IconSize="20"
                            Opacity="1"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="LogoutText"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontFamily="{DynamicResource AppFontBold}"
                            FontSize="13"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="NoWrap"
                            Opacity="0"
                            Text="ВЫХОД"
                            TextColor="{DynamicResource Error}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border
                    x:Name="VersionBadgeBorder"
                    Padding="6,3"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVersionBadgeTappedAsync" />
                    </Border.GestureRecognizers>
                    <Label
                        x:Name="AppVersionLabel"
                        FontSize="11"
                        HorizontalOptions="Center"
                        LineBreakMode="NoWrap"
                        Opacity="0"
                        Style="{StaticResource LabelMuted}"
                        Text="v5.0.0" />
                </Border>
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
