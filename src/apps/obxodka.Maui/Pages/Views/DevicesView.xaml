<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:shared="clr-namespace:obxodka.Models;assembly=obxodka.Shared">
    <Grid
        x:Name="RootLayout"
        Padding="{OnIdiom Desktop='32,28',
                          Phone='16,20,16,0',
                          Default='16,20'}"
        RowDefinitions="Auto, *"
        RowSpacing="16"
        SafeAreaEdges="None">

        <Label
            Grid.Row="0"
            FontFamily="{DynamicResource AppFontTitle}"
            FontSize="{OnIdiom Desktop=22,
                               Default=24}"
            HorizontalOptions="Center"
            Text="Устройства"
            TextColor="{DynamicResource TextPrimary}"
            VerticalOptions="Center" />

        <Grid
            x:Name="ContentGrid"
            Grid.Row="1"
            RowDefinitions="*">
            <ActivityIndicator
                x:Name="DevicesLoadingOverlay"
                HorizontalOptions="Center"
                IsRunning="True"
                IsVisible="False"
                VerticalOptions="Center" />
            <Label
                x:Name="DevicesErrorLabel"
                HorizontalOptions="Center"
                IsVisible="False"
                Opacity="0"
                Style="{StaticResource LabelError}"
                VerticalOptions="Center" />
            <ScrollView
                x:Name="DevicesScrollView"
                HorizontalOptions="Fill"
                HorizontalScrollBarVisibility="Never"
                Orientation="Vertical"
                VerticalScrollBarVisibility="Never">
                <Grid
                    x:Name="DevicesGrid"
                    Padding="{OnIdiom Phone='0,0,0,130',
                                      Default='0'}"
                    ColumnDefinitions="{OnIdiom Desktop='*, *',
                                                Default='*'}"
                    ColumnSpacing="28"
                    HorizontalOptions="Start"
                    RowSpacing="24"
                    VerticalOptions="Start" />
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
