<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.ConfigurationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Grid
        x:Name="RootLayoutGrid"
        Padding="{OnIdiom Desktop='28,16',
                          Phone='16,0,16,0',
                          Default='24,24'}"
        SafeAreaEdges="None">
        <ScrollView
            x:Name="ConfigScrollView"
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never"
            Orientation="Vertical"
            VerticalScrollBarVisibility="Never">
            <Grid
                x:Name="MainContentGrid"
                Padding="{OnIdiom Desktop='0',
                                  Phone='0,50,0,140'}"
                HorizontalOptions="Start"
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
                RowSpacing="{OnIdiom Desktop=12,
                                     Phone=18}">

                <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                    <Label
                        Grid.Column="0"
                        FontFamily="{DynamicResource AppFontTitle}"
                        FontSize="{OnIdiom Desktop=22,
                                           Default=24}"
                        Text="Конфигурация"
                        TextColor="{DynamicResource TextPrimary}" />
                    <Label
                        x:Name="CurrentSelectionLabel"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        FontFamily="{DynamicResource AppFontBold}"
                        FontSize="14"
                        Text="[ obxodka Stream • HTTP/2 ]"
                        TextColor="{DynamicResource Accent}"
                        VerticalOptions="Center" />
                </Grid>

                <Label
                    Grid.Row="1"
                    FontSize="13"
                    LineBreakMode="WordWrap"
                    Style="{StaticResource LabelMuted}">
                    <Label.Text>
                        Оптимизированный транспорт: obxodka Stream через HTTP/2 на 443 порту с обфускацией и защитой от цензуры.
                    </Label.Text>
                </Label>

                <Grid
                    x:Name="ProtocolHeaderGrid"
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    ColumnDefinitions="*">
                    <Label
                        FontFamily="{DynamicResource AppFontBold}"
                        FontSize="15"
                        Text="Протокол и транспорт"
                        TextColor="{DynamicResource TextPrimary}" />
                </Grid>

                <Border
                    x:Name="ProtocolInfoCard"
                    Grid.Row="3"
                    Padding="{OnIdiom Desktop='16,14',
                                      Phone='16'}"
                    Style="{StaticResource NeoCard}">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource AccentDim}"
                            HeightRequest="44"
                            Stroke="{DynamicResource Accent}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            VerticalOptions="Center"
                            WidthRequest="44">
                            <mi:MauiIcon
                                HorizontalOptions="Center"
                                Icon="{mi:Fluent Icon=ShieldCheckmark24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="24"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{DynamicResource AppFontBold}"
                                FontSize="{OnIdiom Desktop=14,
                                                   Default=15}"
                                Text="obxodka Stream (HTTP/2 TLS 443)" />
                            <Label
                                FontSize="{OnIdiom Desktop=11,
                                                   Default=12}"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource LabelMuted}"
                                Text="Сверхбыстрый защищённый дуплексный поток с нулевой задержкой и динамической маскировкой" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="2"
                            Padding="8,4"
                            BackgroundColor="{DynamicResource SuccessDim}"
                            Stroke="{DynamicResource Success}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{DynamicResource AppFontBold}"
                                FontSize="10"
                                Text="АКТИВЕН"
                                TextColor="{DynamicResource Success}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid
                    x:Name="SecurityHeaderGrid"
                    Grid.Row="4"
                    Margin="0,4,0,0"
                    ColumnDefinitions="*">
                    <Label
                        FontFamily="{DynamicResource AppFontBold}"
                        FontSize="15"
                        Text="Надёжность и Безопасность"
                        TextColor="{DynamicResource TextPrimary}" />
                </Grid>

                <Grid
                    Grid.Row="5"
                    ColumnDefinitions="{OnIdiom Desktop='*, *',
                                                Phone='*'}"
                    ColumnSpacing="{OnIdiom Desktop=12,
                                            Phone=0}"
                    RowSpacing="{OnIdiom Desktop=10,
                                         Phone=12}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="AutoReconnectCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="{OnIdiom Desktop='12,10',
                                          Phone='16'}"
                        HeightRequest="{OnIdiom Desktop=66,
                                                Default=-1}"
                        Style="{StaticResource NeoCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=ArrowSync24}"
                                IconColor="{DynamicResource Success}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Авто-переподключение" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Восстанавливает при смене сети." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="AutoReconnectToggle"
                                Grid.Column="2"
                                IsToggled="True"
                                Toggled="OnAutoReconnectToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="KillSwitchCard"
                        Grid.Row="{OnIdiom Desktop=0,
                                           Phone=1}"
                        Grid.Column="{OnIdiom Desktop=1,
                                              Phone=0}"
                        Padding="{OnIdiom Desktop='12,10',
                                          Phone='16'}"
                        HeightRequest="{OnIdiom Desktop=66,
                                                Default=-1}"
                        Style="{StaticResource NeoCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=ShieldDismiss24}"
                                IconColor="{DynamicResource Error}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Kill Switch (Защита)" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Блокирует трафик при обрыве." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="KillSwitchToggle"
                                Grid.Column="2"
                                IsToggled="False"
                                Toggled="OnKillSwitchToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="RunOnStartupCard"
                        Grid.Row="{OnIdiom Desktop=1,
                                           Phone=4}"
                        Grid.Column="0"
                        Grid.ColumnSpan="{OnIdiom Desktop=2,
                                                  Phone=1}"
                        Padding="{OnIdiom Desktop='12,10',
                                          Phone='16'}"
                        HeightRequest="{OnIdiom Desktop=66,
                                                Default=-1}"
                        IsVisible="{OnIdiom Desktop=True,
                                            Phone=False}"
                        Style="{StaticResource NeoCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Rocket24}"
                                IconColor="{DynamicResource PrimaryBright}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Запуск со стартом Windows" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Автоматический запуск при входе в систему." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="RunOnStartupToggle"
                                Grid.Column="2"
                                IsToggled="False"
                                Toggled="OnRunOnStartupToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="SpeedTestCard"
                        Grid.Row="{OnIdiom Desktop=2,
                                           Phone=2}"
                        Grid.Column="0"
                        Grid.ColumnSpan="{OnIdiom Desktop=2,
                                                  Phone=1}"
                        Padding="{OnIdiom Desktop='12,10',
                                          Phone='16'}"
                        HeightRequest="{OnIdiom Desktop=66,
                                                Default=-1}"
                        Style="{StaticResource NeoCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                            <mi:MauiIcon
                                x:Name="SpeedGaugeIcon"
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Gauge24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Тест скорости сети" />
                                <Label
                                    x:Name="SpeedTestResultLabel"
                                    FontSize="{OnIdiom Desktop=11,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Замер скорости и отклика." />
                            </VerticalStackLayout>
                            <Border
                                x:Name="SpeedTestBtnBorder"
                                Grid.Column="2"
                                Padding="10,6"
                                BackgroundColor="{DynamicResource PrimaryDim}"
                                Stroke="{DynamicResource Primary}"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRunSpeedTestClickedAsync" />
                                </Border.GestureRecognizers>
                                <Label
                                    x:Name="SpeedTestBtnText"
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="11"
                                    Text="ТЕСТ"
                                    TextColor="{DynamicResource PrimaryBright}"
                                    VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ThemesSettingsCard"
                        Grid.Row="{OnIdiom Desktop=3,
                                           Phone=3}"
                        Grid.Column="0"
                        Grid.ColumnSpan="{OnIdiom Desktop=2,
                                                  Phone=1}"
                        Padding="{OnIdiom Desktop='12,10',
                                          Phone='16'}"
                        HeightRequest="{OnIdiom Desktop=66,
                                                Default=-1}"
                        Style="{StaticResource NeoCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThemesSettingsTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Color24}"
                                IconColor="{DynamicResource Pink}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Темы оформления и стили" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Каталог тем, прозрачность, видео-фон и эффекты." />
                            </VerticalStackLayout>
                            <mi:MauiIcon
                                Grid.Column="2"
                                Icon="{mi:Fluent Icon=ChevronRight24}"
                                IconColor="{DynamicResource TextMuted}"
                                IconSize="18"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
