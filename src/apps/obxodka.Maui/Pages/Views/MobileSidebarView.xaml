<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="obxodka.Views.MobileSidebarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Border
        x:Name="MobileBottomBar"
        Margin="{OnIdiom Phone='16,0,16,20',
                         Default='16,0,16,16'}"
        Padding="6,6"
        BackgroundColor="{DynamicResource BgElevated}"
        HeightRequest="68"
        Opacity="0"
        Stroke="{DynamicResource BorderMedium}"
        StrokeThickness="1"
        TranslationY="80">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="24" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow
                Brush="#000000"
                Opacity="0.45"
                Radius="18"
                Offset="0,6" />
        </Border.Shadow>

        <Grid ColumnDefinitions="*, *, *, *, *">

            <Border
                x:Name="BottomNavVpn"
                Grid.Column="0"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavVpnTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="3"
                    VerticalOptions="Center">
                    <BoxView
                        x:Name="PillVpn"
                        CornerRadius="2"
                        HeightRequest="3"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Opacity="0"
                        Scale="0.5"
                        WidthRequest="16"
                        Color="{DynamicResource Primary}" />
                    <mi:MauiIcon
                        x:Name="BottomNavVpnIcon"
                        HorizontalOptions="Center"
                        Icon="{mi:Fluent Icon=Shield24}"
                        IconColor="{DynamicResource TextMuted}"
                        IconSize="24" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="BottomNavProfile"
                Grid.Column="1"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavProfileTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="3"
                    VerticalOptions="Center">
                    <BoxView
                        x:Name="PillProfile"
                        CornerRadius="2"
                        HeightRequest="3"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Opacity="0"
                        Scale="0.5"
                        WidthRequest="16"
                        Color="{DynamicResource Primary}" />
                    <mi:MauiIcon
                        x:Name="BottomNavProfileIcon"
                        HorizontalOptions="Center"
                        Icon="{mi:Fluent Icon=Person24}"
                        IconColor="{DynamicResource TextMuted}"
                        IconSize="24" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="BottomNavDevices"
                Grid.Column="2"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavDevicesTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="3"
                    VerticalOptions="Center">
                    <BoxView
                        x:Name="PillDevices"
                        CornerRadius="2"
                        HeightRequest="3"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Opacity="0"
                        Scale="0.5"
                        WidthRequest="16"
                        Color="{DynamicResource Primary}" />
                    <mi:MauiIcon
                        x:Name="BottomNavDevicesIcon"
                        HorizontalOptions="Center"
                        Icon="{mi:Fluent Icon=PhoneDesktop24}"
                        IconColor="{DynamicResource TextMuted}"
                        IconSize="24" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="BottomNavSplit"
                Grid.Column="3"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavSplitTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="3"
                    VerticalOptions="Center">
                    <BoxView
                        x:Name="PillSplit"
                        CornerRadius="2"
                        HeightRequest="3"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Opacity="0"
                        Scale="0.5"
                        WidthRequest="16"
                        Color="{DynamicResource Primary}" />
                    <mi:MauiIcon
                        x:Name="BottomNavSplitIcon"
                        HorizontalOptions="Center"
                        Icon="{mi:Fluent Icon=AppsList24}"
                        IconColor="{DynamicResource TextMuted}"
                        IconSize="24" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="BottomNavConfiguration"
                Grid.Column="4"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavConfigurationTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="3"
                    VerticalOptions="Center">
                    <BoxView
                        x:Name="PillBattery"
                        CornerRadius="2"
                        HeightRequest="3"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Opacity="0"
                        Scale="0.5"
                        WidthRequest="16"
                        Color="{DynamicResource Primary}" />
                    <mi:MauiIcon
                        x:Name="BottomNavConfigurationIcon"
                        HorizontalOptions="Center"
                        Icon="{mi:Fluent Icon=Settings24}"
                        IconColor="{DynamicResource TextMuted}"
                        IconSize="24" />
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Border>
</ContentView>

