<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="obxodka.Pages.Navigation.MobileSidebarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Border
        x:Name="MobileBottomBar"
        Margin="14,0,14,16"
        Padding="8,6"
        BackgroundColor="{DynamicResource BgSurface}"
        HeightRequest="66"
        HorizontalOptions="Fill"
        MaximumWidthRequest="460"
        Opacity="0"
        Stroke="{DynamicResource BorderMedium}"
        StrokeThickness="{DynamicResource CardBorderThickness}"
        TranslationY="64">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="26" />
        </Border.StrokeShape>

        <Grid ColumnDefinitions="*, *, *, *, *" ColumnSpacing="2">

            <Border
                x:Name="BottomNavVpn"
                Grid.Column="0"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavVpnTapped" />
                </Border.GestureRecognizers>
                <Grid
                    RowDefinitions="Auto, Auto"
                    RowSpacing="2"
                    VerticalOptions="Center">
                    <Border
                        x:Name="PillVpn"
                        Grid.Row="0"
                        BackgroundColor="Transparent"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0"
                        WidthRequest="50">
                        <mi:MauiIcon
                            x:Name="BottomNavVpnIcon"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Shield24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        x:Name="LabelVpn"
                        Grid.Row="1"
                        FontFamily="{DynamicResource AppFontMedium}"
                        FontSize="10.5"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="VPN"
                        TextColor="{DynamicResource TextMuted}" />
                </Grid>
            </Border>

            <Border
                x:Name="BottomNavProfile"
                Grid.Column="1"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavProfileTapped" />
                </Border.GestureRecognizers>
                <Grid
                    RowDefinitions="Auto, Auto"
                    RowSpacing="2"
                    VerticalOptions="Center">
                    <Border
                        x:Name="PillProfile"
                        Grid.Row="0"
                        BackgroundColor="Transparent"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0"
                        WidthRequest="50">
                        <mi:MauiIcon
                            x:Name="BottomNavProfileIcon"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Person24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        x:Name="LabelProfile"
                        Grid.Row="1"
                        FontFamily="{DynamicResource AppFontMedium}"
                        FontSize="10.5"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="Профиль"
                        TextColor="{DynamicResource TextMuted}" />
                </Grid>
            </Border>

            <Border
                x:Name="BottomNavDevices"
                Grid.Column="2"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavDevicesTapped" />
                </Border.GestureRecognizers>
                <Grid
                    RowDefinitions="Auto, Auto"
                    RowSpacing="2"
                    VerticalOptions="Center">
                    <Border
                        x:Name="PillDevices"
                        Grid.Row="0"
                        BackgroundColor="Transparent"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0"
                        WidthRequest="50">
                        <mi:MauiIcon
                            x:Name="BottomNavDevicesIcon"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=PhoneDesktop24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        x:Name="LabelDevices"
                        Grid.Row="1"
                        FontFamily="{DynamicResource AppFontMedium}"
                        FontSize="10.5"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="Девайсы"
                        TextColor="{DynamicResource TextMuted}" />
                </Grid>
            </Border>

            <Border
                x:Name="BottomNavSplit"
                Grid.Column="3"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavSplitTapped" />
                </Border.GestureRecognizers>
                <Grid
                    RowDefinitions="Auto, Auto"
                    RowSpacing="2"
                    VerticalOptions="Center">
                    <Border
                        x:Name="PillSplit"
                        Grid.Row="0"
                        BackgroundColor="Transparent"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0"
                        WidthRequest="50">
                        <mi:MauiIcon
                            x:Name="BottomNavSplitIcon"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=AppsList24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        x:Name="LabelSplit"
                        Grid.Row="1"
                        FontFamily="{DynamicResource AppFontMedium}"
                        FontSize="10.5"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="Туннель"
                        TextColor="{DynamicResource TextMuted}" />
                </Grid>
            </Border>

            <Border
                x:Name="BottomNavConfiguration"
                Grid.Column="4"
                Style="{StaticResource BottomNavItem}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavConfigurationTapped" />
                </Border.GestureRecognizers>
                <Grid
                    RowDefinitions="Auto, Auto"
                    RowSpacing="2"
                    VerticalOptions="Center">
                    <Border
                        x:Name="PillConfiguration"
                        Grid.Row="0"
                        BackgroundColor="Transparent"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0"
                        WidthRequest="50">
                        <mi:MauiIcon
                            x:Name="BottomNavConfigurationIcon"
                            HorizontalOptions="Center"
                            Icon="{mi:Fluent Icon=Settings24}"
                            IconColor="{DynamicResource TextMuted}"
                            IconSize="20"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        x:Name="LabelConfiguration"
                        Grid.Row="1"
                        FontFamily="{DynamicResource AppFontMedium}"
                        FontSize="10.5"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="Опции"
                        TextColor="{DynamicResource TextMuted}" />
                </Grid>
            </Border>

        </Grid>
    </Border>
</ContentView>
