<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="obxodka.Pages.Settings.ConfigurationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Grid
        x:Name="RootLayoutGrid"
        Padding="16,0"
        SafeAreaEdges="None">
        <ScrollView
            x:Name="ConfigScrollView"
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never"
            Orientation="Vertical"
            VerticalScrollBarVisibility="Never">
            <Grid
                x:Name="MainContentGrid"
                Padding="0,24,0,28"
                HorizontalOptions="Fill"
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
                RowSpacing="14">

                <FlexLayout
                    Grid.Row="0"
                    AlignItems="Center"
                    Direction="Row"
                    JustifyContent="Start"
                    Wrap="Wrap">
                    <Label
                        Margin="0,0,12,4"
                        Style="{StaticResource PageHeaderTitle}"
                        Text="Конфигурация" />
                    <Border
                        Margin="0,0,0,4"
                        Style="{StaticResource BadgePill}">
                        <Label
                            x:Name="CurrentSelectionLabel"
                            FontFamily="{DynamicResource AppFontBold}"
                            FontSize="12"
                            Text="obxodka Stream • HTTP/2"
                            TextColor="{DynamicResource Accent}"
                            VerticalOptions="Center" />
                    </Border>
                </FlexLayout>

                <Label
                    Grid.Row="1"
                    FontSize="13"
                    LineBreakMode="WordWrap"
                    Style="{StaticResource LabelMuted}">
                    <Label.Text>
                        Оптимизированный транспорт: obxodka Stream через HTTP/2 на 443 порту с обфускацией и защитой от цензуры.
                    </Label.Text>
                </Label>

                <Grid
                    x:Name="ProtocolHeaderGrid"
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    ColumnDefinitions="*">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        Text="ПРОТОКОЛ И ТРАНСПОРТ" />
                </Grid>

                <Border
                    x:Name="ProtocolInfoCard"
                    Grid.Row="3"
                    Padding="16,14"
                    Style="{StaticResource NeoCard}">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource AccentDim}"
                            HeightRequest="44"
                            Stroke="{DynamicResource Accent}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            VerticalOptions="Center"
                            WidthRequest="44">
                            <mi:MauiIcon
                                HorizontalOptions="Center"
                                Icon="{mi:Fluent Icon=ShieldCheckmark24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="24"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{DynamicResource AppFontBold}"
                                FontSize="{OnIdiom Desktop=14,
                                                   Default=15}"
                                Text="obxodka Stream (HTTP/2 TLS 443)" />
                            <Label
                                FontSize="{OnIdiom Desktop=11,
                                                   Default=12}"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource LabelMuted}"
                                Text="Сверхбыстрый защищённый дуплексный поток с нулевой задержкой и динамической маскировкой" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="2"
                            Padding="8,4"
                            BackgroundColor="{DynamicResource SuccessDim}"
                            Stroke="{DynamicResource Success}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{DynamicResource AppFontBold}"
                                FontSize="10"
                                Text="АКТИВЕН"
                                TextColor="{DynamicResource Success}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid
                    x:Name="SecurityHeaderGrid"
                    Grid.Row="4"
                    Margin="0,6,0,0"
                    ColumnDefinitions="*">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        Text="НАДЁЖНОСТЬ И БЕЗОПАСНОСТЬ" />
                </Grid>

                <Grid
                    x:Name="SecuritySettingsGrid"
                    Grid.Row="5"
                    ColumnDefinitions="*"
                    ColumnSpacing="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="AutoReconnectCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="16,14"
                        MinimumHeightRequest="66"
                        Style="{StaticResource SettingsRowCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=ArrowSync24}"
                                IconColor="{DynamicResource Success}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13.5,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Авто-переподключение" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11.5,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Восстанавливает при смене сети." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="AutoReconnectToggle"
                                Grid.Column="2"
                                IsToggled="True"
                                Toggled="OnAutoReconnectToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="KillSwitchCard"
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="16,14"
                        MinimumHeightRequest="66"
                        Style="{StaticResource SettingsRowCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=ShieldDismiss24}"
                                IconColor="{DynamicResource Error}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13.5,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Kill Switch (Защита)" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11.5,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Блокирует трафик при обрыве." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="KillSwitchToggle"
                                Grid.Column="2"
                                IsToggled="False"
                                Toggled="OnKillSwitchToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ForceCloudflareCard"
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="16,14"
                        MinimumHeightRequest="66"
                        Style="{StaticResource SettingsRowCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=GlobeShield24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13.5,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Только через Cloudflare" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11.5,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Принудительный WebSocket CDN." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="ForceCloudflareToggle"
                                Grid.Column="2"
                                IsToggled="False"
                                Toggled="OnForceCloudflareToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="BlockIpv6Card"
                        Grid.Row="3"
                        Grid.Column="0"
                        Padding="16,14"
                        MinimumHeightRequest="66"
                        Style="{StaticResource SettingsRowCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Shield24}"
                                IconColor="{DynamicResource PrimaryBright}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13.5,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Режим только IPv4" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11.5,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Блокирует IPv6 и утечки Teredo." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="BlockIpv6Toggle"
                                Grid.Column="2"
                                IsToggled="False"
                                Toggled="OnBlockIpv6Toggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="RuAutoBypassCard"
                        Grid.Row="4"
                        Grid.Column="0"
                        Padding="16,14"
                        IsVisible="{OnPlatform WinUI=True,
                                               Default=False}"
                        MinimumHeightRequest="66"
                        Style="{StaticResource SettingsRowCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Globe24}"
                                IconColor="{DynamicResource Success}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13.5,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Полный обход РФ" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11.5,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Пускать домены .ru и РФ-сервисы мимо VPN (Split Tunnel)." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="RuAutoBypassToggle"
                                Grid.Column="2"
                                IsToggled="True"
                                Toggled="OnRuAutoBypassToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="RunOnStartupCard"
                        Grid.Row="5"
                        Grid.Column="0"
                        Padding="16,14"
                        IsVisible="{OnPlatform WinUI=True,
                                               Default=False}"
                        MinimumHeightRequest="66"
                        Style="{StaticResource SettingsRowCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Rocket24}"
                                IconColor="{DynamicResource PrimaryBright}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13.5,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Запуск со стартом Windows" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11.5,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Автоматический запуск при входе в систему." />
                            </VerticalStackLayout>
                            <Switch
                                x:Name="RunOnStartupToggle"
                                Grid.Column="2"
                                IsToggled="False"
                                Toggled="OnRunOnStartupToggled"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="SpeedTestCard"
                        Grid.Row="6"
                        Grid.Column="0"
                        Padding="16,14"
                        MinimumHeightRequest="66"
                        Style="{StaticResource SettingsRowCard}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                x:Name="SpeedGaugeIcon"
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Gauge24}"
                                IconColor="{DynamicResource Accent}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13.5,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Тест скорости сети" />
                                <Label
                                    x:Name="SpeedTestResultLabel"
                                    FontSize="{OnIdiom Desktop=11.5,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Замер скорости и отклика." />
                            </VerticalStackLayout>
                            <Border
                                x:Name="SpeedTestBtnBorder"
                                Grid.Column="2"
                                Padding="12,6"
                                BackgroundColor="{DynamicResource BgElevated}"
                                Stroke="{DynamicResource Primary}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRunSpeedTestClickedAsync" />
                                </Border.GestureRecognizers>
                                <Label
                                    x:Name="SpeedTestBtnText"
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="11.5"
                                    Text="ТЕСТ"
                                    TextColor="{DynamicResource Primary}"
                                    VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ThemesSettingsCard"
                        Grid.Row="7"
                        Grid.Column="0"
                        Padding="16,14"
                        MinimumHeightRequest="66"
                        Style="{StaticResource SettingsRowCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThemesSettingsTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Fluent Icon=Color24}"
                                IconColor="{DynamicResource Pink}"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{DynamicResource AppFontBold}"
                                    FontSize="{OnIdiom Desktop=13.5,
                                                       Default=15}"
                                    LineBreakMode="TailTruncation"
                                    Text="Темы оформления" />
                                <Label
                                    FontSize="{OnIdiom Desktop=11.5,
                                                       Default=12}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMuted}"
                                    Text="Каталог тем и стили." />
                            </VerticalStackLayout>
                            <mi:MauiIcon
                                Grid.Column="2"
                                Icon="{mi:Fluent Icon=ChevronRight24}"
                                IconColor="{DynamicResource TextMuted}"
                                IconSize="18"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
