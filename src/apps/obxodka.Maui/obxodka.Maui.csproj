<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <_IsSkippedLinuxMaui Condition="$([MSBuild]::IsOSPlatform('linux')) and '$(EnableMauiLinux)' != 'true' and !$(TargetFramework.Contains('-android'))">true</_IsSkippedLinuxMaui>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsSkippedLinuxMaui)' == 'true'">
    <TargetFramework>$(NetCoreTfm)</TargetFramework>
    <UseMaui>false</UseMaui>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
  </PropertyGroup>

  <!-- Общие настройки MAUI -->
  <PropertyGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true'">
    <Configurations>Debug;Release</Configurations>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) and '$(RuntimeIdentifier)' == '' and '$(BuildWindowsOnly)' != 'true'">$(NetWindowsSdkTfm);$(NetAndroidTfm)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) and ('$(RuntimeIdentifier)' != '' or '$(BuildWindowsOnly)' == 'true')">$(NetWindowsSdkTfm)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">$(NetAndroidTfm)</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows')) and !$([MSBuild]::IsOSPlatform('linux'))">$(NetMacCatalystTfm);$(NetIosTfm);$(NetAndroidTfm)</TargetFrameworks>
    <OutputType Condition="!$(TargetFramework.Contains('-windows'))">Exe</OutputType>
    <OutputType Condition="$(TargetFramework.Contains('-windows'))">WinExe</OutputType>
    <RootNamespace>obxodka</RootNamespace>
    <ApplicationTitle>Obxodka</ApplicationTitle>
    <ApplicationId>com.octocore.obxodka</ApplicationId>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- Windows (WinUI 3 / MSIX) -->
  <PropertyGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true' and $(TargetFramework.Contains('-windows'))">
    <WindowsPackageType>$(PackageMode)</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>

  <!-- Android -->
  <PropertyGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true' and $(TargetFramework.Contains('-android'))">
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'Debug'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(Configuration)' != 'Debug'">android-arm;android-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>30.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <AndroidZipAlignment>16</AndroidZipAlignment>
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
    <AndroidPackageFormat Condition="'$(Configuration)' != 'Release'">apk</AndroidPackageFormat>
    <AndroidLinkTool Condition="'$(Configuration)' == 'Release'">r8</AndroidLinkTool>
    <AndroidEnableShrinking Condition="'$(Configuration)' == 'Release'">true</AndroidEnableShrinking>
    <AndroidR8ObfuscationMode Condition="'$(Configuration)' == 'Release'">private-members</AndroidR8ObfuscationMode>
    <AndroidStripNativeLibraries Condition="'$(Configuration)' == 'Release'">true</AndroidStripNativeLibraries>
    <JavaMaximumHeapSize Condition="'$(GITHUB_ACTIONS)' != 'true'">8G</JavaMaximumHeapSize>
    <JavaMaximumHeapSize Condition="'$(GITHUB_ACTIONS)' == 'true'">4G</JavaMaximumHeapSize>
  </PropertyGroup>

  <!-- iOS и MacCatalyst -->
  <PropertyGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true' and ($(TargetFramework.Contains('-ios')) or $(TargetFramework.Contains('-maccatalyst')))">
    <SupportedOSPlatformVersion>16.1</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>16.1</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true'">
    <MauiIcon Condition="$(TargetFramework.Contains('-android'))" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.65" Color="#FFFFFF"/>
    <MauiIcon Condition="!$(TargetFramework.Contains('-android'))" Include="Resources\AppIcon\appiconfg.svg"/>
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="Transparent"/>
    <MauiImage Include="Resources\Images\**\*"/>
    <MauiFont Include="Resources\Fonts\**\*"/>
    <MauiXaml Update="Pages\**\*.xaml" Generator="MSBuild:Compile"/>
  </ItemGroup>

  <ItemGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true'">
    <PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent"/>
    <PackageReference Include="Microsoft.Extensions.Http"/>
    <PackageReference Include="Microsoft.Maui.Controls"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug"/>
    <PackageReference Include="Plugin.InAppBilling"/>
    <PackageReference Include="SkiaSharp.Views.Maui.Controls"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="CommunityToolkit.Maui"/>
    <PackageReference Include="CommunityToolkit.Maui.MediaElement"/>
    <PackageReference Include="WinUIEx" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"/>
    <PackageReference Include="System.Management" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"/>
  </ItemGroup>

  <ItemGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx"/>
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx"/>
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData"/>
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx"/>
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx"/>
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx"/>
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx"/>
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process"/>
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner"/>
    <ProguardConfiguration Include="Platforms\Android\proguard.cfg"/>
  </ItemGroup>

  <ItemGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true' and $(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="..\..\core\obxodka.Platform.Windows\obxodka.Platform.Windows.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(_IsSkippedLinuxMaui)' != 'true'">
    <ProjectReference Include="..\..\core\obxodka.Client\obxodka.Client.csproj"/>
    <ProjectReference Include="..\..\core\obxodka.Shared\obxodka.Shared.csproj"/>
  </ItemGroup>

  <Target Name="_ValidateSigningCertificate" Condition="'$(AppxPackageSigningEnabled)' == 'false'"/>

  <Target Name="SyncManifestVersion" BeforeTargets="BeforeBuild;BeforeRebuild;BeforePublish;_GenerateAppxManifest;PrepareForBuild" Condition="'$(IsWindows)' == 'true' and $(TargetFramework.Contains('-windows')) and Exists('Platforms\Windows\Package.appxmanifest')">
    <XmlPoke XmlInputPath="Platforms\Windows\Package.appxmanifest" Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;" Query="/m:Package/m:Identity/@Version" Value="$(AppxPackageVersion)"/>
  </Target>

  <Target Name="Build" Condition="'$(_IsSkippedLinuxMaui)' == 'true'">
    <Message Importance="high" Text="🐧 Linux detected: obxodka.Maui skipped successfully."/>
  </Target>
  <Target Name="Publish" Condition="'$(_IsSkippedLinuxMaui)' == 'true'"/>

  <Target Name="_EnsureProguardProjectReferencesExists" BeforeTargets="_CompileToDalvik" Condition="$(TargetFramework.Contains('-android'))">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_ProguardProjectConfiguration)'))" Condition="'$(_ProguardProjectConfiguration)' != '' and !Exists('$(_ProguardProjectConfiguration)')"/>
    <Touch Files="$(_ProguardProjectConfiguration)" AlwaysCreate="true" Condition="'$(_ProguardProjectConfiguration)' != '' and !Exists('$(_ProguardProjectConfiguration)')"/>
  </Target>

  <!-- Автономный .NET 11 C# оптимизатор R8 (tools/AndroidR8Optimizer.cs):
       сканирует слинкованные .dll (System.Reflection.Metadata), нативные .so и acw-map,
       генерирует точечные JNI-правила и (при AndroidStrictR8Obfuscation=true) снимает глобальный -keep class ** -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(AndroidLinkTool)' == 'r8' and $(TargetFramework.Contains('-android'))">
    <AndroidStrictR8Obfuscation Condition="'$(AndroidStrictR8Obfuscation)' == ''">true</AndroidStrictR8Obfuscation>
  </PropertyGroup>

  <Target Name="_OptimizeAndroidR8Rules"
          AfterTargets="_CalculateProguardConfigurationFiles"
          BeforeTargets="_CompileToDalvik"
          Condition="'$(Configuration)' == 'Release' and '$(AndroidLinkTool)' == 'r8' and $(TargetFramework.Contains('-android'))">
    <PropertyGroup>
      <_R8OptimizerScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../tools/AndroidR8Optimizer.cs'))</_R8OptimizerScript>
      <_AutoJniProguardFile>$(IntermediateOutputPath)proguard/proguard_jni_auto.cfg</_AutoJniProguardFile>
      <_StrictXamarinProguardFile>$(IntermediateOutputPath)proguard/proguard_xamarin_strict.cfg</_StrictXamarinProguardFile>
      <_R8DllDirs>$(IntermediateOutputPath)afterlink,$(IntermediateOutputPath)linked</_R8DllDirs>
      <_R8SoDirs>$(IntermediateOutputPath)app_shared_libraries,$(IntermediateOutputPath)android-arm64/stripped,$(IntermediateOutputPath)android-arm/stripped,$(IntermediateOutputPath)lp</_R8SoDirs>
      <_R8ProjRefs>$(_ProguardProjectConfiguration),$(IntermediateOutputPath)../$(Configuration.ToLowerInvariant())_$(TargetFramework)_android-arm64/proguard/proguard_project_references.cfg,$(IntermediateOutputPath)../$(Configuration.ToLowerInvariant())_$(TargetFramework)_android-arm/proguard/proguard_project_references.cfg</_R8ProjRefs>
      <_R8StrictArg Condition="'$(AndroidStrictR8Obfuscation)' == 'true'">--output-xamarin-strict &quot;$(_StrictXamarinProguardFile)&quot; --mapping-file &quot;$(AndroidProguardMappingFile)&quot;</_R8StrictArg>
    </PropertyGroup>

    <Exec Command="dotnet run --file &quot;$(_R8OptimizerScript)&quot; -p:ImportDirectoryBuildProps=false -p:ImportDirectoryBuildTargets=false -p:ImportDirectoryPackagesProps=false -- --generate --dll-dirs &quot;$(_R8DllDirs)&quot; --so-dirs &quot;$(_R8SoDirs)&quot; --acw-map &quot;$(_AcwMapFile)&quot; --project-refs &quot;$(_R8ProjRefs)&quot; --output-jni &quot;$(_AutoJniProguardFile)&quot; $(_R8StrictArg)"
          ConsoleToMSBuild="false"/>

    <ItemGroup Condition="Exists('$(_AutoJniProguardFile)')">
      <_ProguardConfiguration Include="$(_AutoJniProguardFile)"/>
      <FileWrites Include="$(_AutoJniProguardFile)"/>
    </ItemGroup>

    <ItemGroup Condition="'$(AndroidStrictR8Obfuscation)' == 'true' and Exists('$(_StrictXamarinProguardFile)')">
      <_ProguardConfiguration Remove="@(_ProguardConfiguration)" Condition="$([System.String]::Copy('%(Filename)%(Extension)').Equals('proguard_xamarin.cfg', System.StringComparison.OrdinalIgnoreCase))"/>
      <_ProguardConfiguration Include="$(_StrictXamarinProguardFile)"/>
      <FileWrites Include="$(_StrictXamarinProguardFile)"/>
    </ItemGroup>
  </Target>

  <!-- Упаковка нативных отладочных символов (.so.dbg) в BUNDLE-METADATA AAB для Google Play Console -->
  <Target Name="_AddNativeDebugSymbolsToBundle"
          AfterTargets="_CreateApplicationSharedLibraries"
          BeforeTargets="_BuildApkEmbed"
          Condition="'$(Configuration)' == 'Release' and '$(AndroidPackageFormat)' == 'aab' and $(TargetFramework.Contains('-android'))">
    <ItemGroup>
      <_NativeDbgSymbol Include="$(_AndroidApplicationSharedLibraryPath)arm64-v8a/libxamarin-app.dbg.so"
                        Condition="Exists('$(_AndroidApplicationSharedLibraryPath)arm64-v8a/libxamarin-app.dbg.so')"
                        MetaPath="com.android.tools.build.debugsymbols/arm64-v8a/libxamarin-app.so.dbg"/>
      <_NativeDbgSymbol Include="$(_AndroidApplicationSharedLibraryPath)armeabi-v7a/libxamarin-app.dbg.so"
                        Condition="Exists('$(_AndroidApplicationSharedLibraryPath)armeabi-v7a/libxamarin-app.dbg.so')"
                        MetaPath="com.android.tools.build.debugsymbols/armeabi-v7a/libxamarin-app.so.dbg"/>
      <AndroidAppBundleMetaDataFile Include="@(_NativeDbgSymbol->'%(MetaPath):%(FullPath)')"/>
    </ItemGroup>
  </Target>

</Project>
