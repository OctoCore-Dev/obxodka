<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('linux')) and '$(EnableMauiLinux)' != 'true' and !$(TargetFramework.Contains('-android'))">
    <TargetFramework>$(NetTargetFramework)</TargetFramework>
    <UseMaui>false</UseMaui>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true' or $(TargetFramework.Contains('-android'))">
    <WindowsPackageType>$(PackageMode)</WindowsPackageType>
    <Configurations>Debug;Release</Configurations>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) and '$(RuntimeIdentifier)' == ''">$(WindowsTargetFramework);$(AndroidTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) and '$(RuntimeIdentifier)' != ''">$(WindowsTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">$(AndroidTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows')) and !$([MSBuild]::IsOSPlatform('linux'))">$(MacCatalystTargetFramework);$(IosTargetFramework);$(AndroidTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>obxodka.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <DefaultItemExcludes>$(DefaultItemExcludes);obxodka.Shared\**;obxodka.Client.Tests\**;obxodka.UITests\**;obxodka.Benchmarks\**;diagnostics\**</DefaultItemExcludes>
  </PropertyGroup>

	<PropertyGroup Condition="(!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true') and $(TargetFramework.Contains('-windows'))">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
		<ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
	</PropertyGroup>

	<PropertyGroup Condition="(!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true' or $(TargetFramework.Contains('-android'))) and $(TargetFramework.Contains('-android'))">
		<RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
		<RunAOTCompilation Condition="'$(Configuration)' == 'Release' and '$(DotNetMajorVersion)' != '11'">true</RunAOTCompilation>
		<RunAOTCompilation Condition="'$(Configuration)' != 'Release' and '$(DotNetMajorVersion)' != '11'">false</RunAOTCompilation>
		<AndroidEnableProfiledAot Condition="'$(Configuration)' == 'Release' and '$(DotNetMajorVersion)' != '11'">true</AndroidEnableProfiledAot>
		<AndroidEnableProfiledAot Condition="'$(Configuration)' != 'Release' and '$(DotNetMajorVersion)' != '11'">false</AndroidEnableProfiledAot>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<UseNativeHttpHandler>true</UseNativeHttpHandler>
		<JavaMaximumHeapSize Condition="'$(GITHUB_ACTIONS)' != 'true'">8G</JavaMaximumHeapSize>
		<JavaMaximumHeapSize Condition="'$(GITHUB_ACTIONS)' == 'true'">4G</JavaMaximumHeapSize>
		<AndroidLinkTool Condition="'$(Configuration)' == 'Release'">r8</AndroidLinkTool>
		<AndroidEnableShrinking Condition="'$(Configuration)' == 'Release'">true</AndroidEnableShrinking>
	</PropertyGroup>

    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true' or $(TargetFramework.Contains('-android'))">
        <ApplicationTitle>Obxodka</ApplicationTitle>
        <ApplicationId>com.octocore.obxodka</ApplicationId>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

	<PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true' or $(TargetFramework.Contains('-android'))">
		<TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">29.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">16.1</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-ios'))">16.1</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">16.1</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">16.1</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.19041.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.19041.0</TargetPlatformMinVersion>
        <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
        <AndroidPackageFormat Condition="'$(Configuration)' != 'Release'">apk</AndroidPackageFormat>
        <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
        <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
        <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
        <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
        <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
        <GenerateTestArtifacts>False</GenerateTestArtifacts>
        <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    </PropertyGroup>

	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true' or $(TargetFramework.Contains('-android'))">
        <MauiIcon Condition="$(TargetFramework.Contains('-android'))" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.65" Color="#FFFFFF" />
        <MauiIcon Condition="!$(TargetFramework.Contains('-android'))" Include="Resources\AppIcon\appiconfg.svg" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="Transparent" />
		<MauiImage Include="Resources\Images\**\*" Exclude="Resources\Images\Previews\**\*" />
		<MauiFont Include="Resources\Fonts\**\*" />
		<MauiAsset Include="Resources\Raw\**\*" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiXaml Update="Pages\**\*.xaml" Generator="MSBuild:Compile" />
	</ItemGroup>

<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true' or $(TargetFramework.Contains('-android'))">
    <PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Plugin.InAppBilling" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" />
    <PackageReference Include="WinUIEx" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="System.Management" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
</ItemGroup>

  <ItemGroup Condition="(!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true' or $(TargetFramework.Contains('-android'))) and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" />
    <ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
  </ItemGroup>

	<ItemGroup Condition="(!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true') and $(TargetFramework.Contains('-windows'))">
        <Content Include="Platforms\Windows\Engine\**\*">
            <PackagePath>Engine</PackagePath>
            <Link>Engine\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('linux')) or '$(EnableMauiLinux)' == 'true' or $(TargetFramework.Contains('-android'))">
	  <ProjectReference Include="..\..\core\obxodka.Client\obxodka.Client.csproj" />
	  <ProjectReference Include="..\..\core\obxodka.Shared\obxodka.Shared.csproj" />
	</ItemGroup>

	<Target Name="_ValidateSigningCertificate" Condition="'$(AppxPackageSigningEnabled)' == 'false'" />

	<Target Name="SyncManifestVersion" BeforeTargets="BeforeBuild;BeforeRebuild;BeforePublish;_GenerateAppxManifest;PrepareForBuild" Condition="'$(IsWindows)' == 'true' and $(TargetFramework.Contains('-windows')) and Exists('Platforms\Windows\Package.appxmanifest')">
		<XmlPoke XmlInputPath="Platforms\Windows\Package.appxmanifest" Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;" Query="/m:Package/m:Identity/@Version" Value="$(AppxPackageVersion)" />
	</Target>

	<Target Name="Build" Condition="$([MSBuild]::IsOSPlatform('linux')) and '$(EnableMauiLinux)' != 'true' and !$(TargetFramework.Contains('-android'))">
		<Message Importance="high" Text="🐧 Linux detected: obxodka.Maui skipped successfully." />
	</Target>
	<Target Name="Publish" Condition="$([MSBuild]::IsOSPlatform('linux')) and '$(EnableMauiLinux)' != 'true' and !$(TargetFramework.Contains('-android'))" />
	<Target Name="_EnsureProguardProjectReferencesExists" BeforeTargets="_CompileToDalvik" Condition="$(TargetFramework.Contains('-android'))">
		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_ProguardProjectConfiguration)'))" Condition="'$(_ProguardProjectConfiguration)' != '' and !Exists('$(_ProguardProjectConfiguration)')" />
		<Touch Files="$(_ProguardProjectConfiguration)" AlwaysCreate="true" Condition="'$(_ProguardProjectConfiguration)' != '' and !Exists('$(_ProguardProjectConfiguration)')" />
	</Target>

</Project>





