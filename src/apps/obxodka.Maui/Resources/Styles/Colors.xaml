<?xml version="1.0" encoding="UTF-8"?>

<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BgBase">#202020</Color>
    <Color x:Key="BgSurface">#2B2B2B</Color>
    <Color x:Key="BgElevated">#323232</Color>
    <Color x:Key="BgInput">#252525</Color>
    <Color x:Key="BgOverlay">#A6000000</Color>

    <Color x:Key="SolidBorderDark">#3A3A3A</Color>

    <Color x:Key="Primary">#0078D4</Color>
    <Color x:Key="PrimaryBright">#60CDFF</Color>
    <Color x:Key="PrimaryLight">#4CC2FF</Color>
    <Color x:Key="PrimaryDim">#2660CDFF</Color>
    <Color x:Key="PrimaryGlow">#4060CDFF</Color>
    <Color x:Key="PrimaryLight2">#0067C0</Color>

    <Color x:Key="Accent">#60CDFF</Color>
    <Color x:Key="AccentDim">#2660CDFF</Color>
    <Color x:Key="AccentGlow">#4D60CDFF</Color>
    <Color x:Key="AccentLight">#4CC2FF</Color>

    <Color x:Key="Purple">#A78BFA</Color>
    <Color x:Key="PurpleDim">#26A78BFA</Color>
    <Color x:Key="PurpleLight">#8B5CF6</Color>
    <Color x:Key="Pink">#F472B6</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#D2D2D2</Color>
    <Color x:Key="TextMuted">#9E9E9E</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextOnSuccess">#FFFFFF</Color>

    <Color x:Key="BorderSubtle">#383838</Color>
    <Color x:Key="BorderMedium">#484848</Color>
    <Color x:Key="BorderStrong">#5E5E5E</Color>

    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessDim">#2410B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningDim">#24F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="ErrorDim">#24EF4444</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">#00000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Primary}" />
    <SolidColorBrush x:Key="PrimaryBrightBrush" Color="{DynamicResource PrimaryBright}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource Accent}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}" />
    <SolidColorBrush x:Key="BgBaseBrush" Color="{DynamicResource BgBase}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{DynamicResource BgSurface}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtle}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource Success}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource Error}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <OnPlatform x:Key="CardCornerRadius" x:TypeArguments="CornerRadius">
        <On Platform="Android" Value="16" />
        <On Platform="iOS" Value="16" />
        <On Platform="WinUI" Value="10" />
    </OnPlatform>
    <x:Double x:Key="CardBorderThickness">1</x:Double>

</ResourceDictionary>
