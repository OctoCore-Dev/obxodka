<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="obxodka.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:obxodka.Pages"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{DynamicResource AppBackground}" HeightRequest="150">
            <Image
                HeightRequest="64"
                HorizontalOptions="Center"
                Opacity="0.8"
                Source="user_icon.png"
                VerticalOptions="Center"
                WidthRequest="64" />
            <Label
                Margin="0,0,0,15"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Text="obxodka"
                TextColor="{DynamicResource StatusBlue}"
                VerticalOptions="End" />
        </Grid>
    </Shell.FlyoutHeader>

</Shell>