<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="obxodka.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:obxodka.Pages"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="150" BackgroundColor="{DynamicResource AppBackground}">
            <Image Source="user_icon.png" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="64" HeightRequest="64" Opacity="0.8"/>
            <Label Text="obxodka" TextColor="{DynamicResource StatusBlue}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,15" />
        </Grid>
    </Shell.FlyoutHeader>

</Shell>