<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="obxodka.Resources.Styles.Themes.GlassTheme">

    <Color x:Key="AppBackground">#0F1015</Color>
    <Color x:Key="SurfaceDark">#15FFFFFF</Color>
    <Color x:Key="SurfaceLight">#25FFFFFF</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#EBEBF5</Color>

    <Color x:Key="PrimaryAccent">#0A84FF</Color>
    <Color x:Key="SecondaryAccent">#5E5CE6</Color>
    <Color x:Key="StatusBlue">#00AAFF</Color>
    <Color x:Key="ErrorColor">#FF453A</Color>
    <Color x:Key="SuccessColor">#32D74B</Color>

    <Color x:Key="BorderColor">#30FFFFFF</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1AFFFFFF" Offset="0.0" />
        <GradientStop Color="#05FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#50FFFFFF" Offset="0.0" />
        <GradientStop Color="#10FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>