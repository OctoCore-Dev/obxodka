<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="obxodka.Resources.Styles.Themes.LightTheme">

    <Color x:Key="AppBackground">#F2F2F7</Color>
    <Color x:Key="SurfaceDark">#FFFFFF</Color>
    <Color x:Key="SurfaceLight">#E5E5EA</Color>

    <Color x:Key="TextPrimary">#000000</Color>
    <Color x:Key="TextSecondary">#8E8E93</Color>

    <Color x:Key="PrimaryAccent">#FF0044</Color>
    <Color x:Key="SecondaryAccent">#FF88AA</Color>
    <Color x:Key="StatusBlue">#007AFF</Color>
    <Color x:Key="ErrorColor">#FF3B30</Color>
    <Color x:Key="SuccessColor">#34C759</Color>

    <Color x:Key="BorderColor">#E5E5E5</Color>
    <Color x:Key="ShadowColor">#15000000</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="CardBorderBrush" Color="#D1D1D6" />

</ResourceDictionary>