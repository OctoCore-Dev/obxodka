root = true

# ==============================================================================
# УНИВЕРСАЛЬНЫЙ .NET 11 / C# 15 MASTER .EDITORCONFIG (Стандарт Microsoft)
# Назначение: форматирование, синтаксис языка, правила именования и исключения по путям.
# Уровни серьёзности анализаторов (CAxxxx / IDExxxx / RSxxxx / ILxxxx) хранятся строго в .globalconfig (SSOT).
# ==============================================================================

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 140

# ------------------------------------------------------------------------------
# Веб / Фронтенд / Razor
# ------------------------------------------------------------------------------
[*.{razor,html,htm,css,scss,js,ts,jsx,tsx}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{razor,html,htm}]
html_attribute_quotes = double
html_tag_case = lower
html_attribute_case = lower
html_space_before_self_closing_slash = true

[*.razor]
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# ------------------------------------------------------------------------------
# Документация, JSON, YAML, скрипты, MSBuild и XAML
# ------------------------------------------------------------------------------
[*.{md,txt}]
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
tab_width = 2
end_of_line = lf

[*.{sh,bash,zsh}]
indent_size = 2
end_of_line = lf

[Dockerfile*]
end_of_line = lf

[*.{xml,csproj,props,targets,slnx,resx,config}]
indent_size = 2
tab_width = 2

[*.{xaml,axaml}]
indent_size = 4
xaml_attribute_multi_line_threshold = 2
xaml_attribute_formatting_rule = always_on_new_line_if_more_than_threshold
xaml_put_ending_bracket_on_new_line = false
xaml_sort_attributes = true
xaml_collapse_empty_tags = true
xaml_space_inside_markup_extension = false
xaml_space_before_self_closing_slash = true

# ==============================================================================
# C#: ФОРМАТИРОВАНИЕ, СТИЛЬ ЯЗЫКА И ИМЕНОВАНИЕ (Стандарт Microsoft dotnet/runtime)
# ==============================================================================
[*.cs]

# 1. Скобки в стиле Allman и отступы (Стандарт Microsoft)
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# 2. Пробелы
csharp_space_after_cast = false
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

# 3. Директивы using и пространства имён
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:error
csharp_style_namespace_declarations = file_scoped:error

# 4. Современный синтаксис C# 13/14/15
csharp_prefer_braces = true:error
csharp_prefer_simple_using_statement = true:error
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_prefer_primary_constructors = true:warning
csharp_style_prefer_collection_expression = true:warning
csharp_style_prefer_simple_default_expression = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# Члены с телом-выражением (короткие однострочники — через =>, многострочные — через блок)
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Сопоставление с образцом (pattern matching) и работа с null
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_extended_property_pattern = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_tuple_swap = true:suggestion
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_compound_assignment = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true:warning

# Срезы, UTF-8 литералы, readonly struct и лояльность к fluent API
csharp_style_prefer_local_over_anonymous_function = true:suggestion
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_style_prefer_utf8_string_literals = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning
csharp_style_prefer_method_group_conversion = true:suggestion
csharp_style_inlined_variable_declaration = true:warning
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:warning
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

# Квалификация this., встроенные типы, инициализаторы и порядок модификаторов
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public, private, protected, internal, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, volatile, async:warning

# Скобки в выражениях (без лишнего визуального шума)
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:silent
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:silent
dotnet_style_parentheses_in_other_binary_operators = never_if_unnecessary:silent
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:silent

# 5. Соглашения об именовании (СТРОГО ОТ БОЛЕЕ ЧАСТНОГО К ОБЩЕМУ -> НОЛЬ КОНФЛИКТОВ)
# 5.1 Константы (любая область видимости): PascalCase
dotnet_naming_rule.constants_pascal.symbols = constants_sym
dotnet_naming_rule.constants_pascal.style = pascal_case_style
dotnet_naming_rule.constants_pascal.severity = error
dotnet_naming_symbols.constants_sym.applicable_kinds = field
dotnet_naming_symbols.constants_sym.required_modifiers = const

# 5.2 Приватные статические поля (не константы): s_camelCase
dotnet_naming_rule.static_private_fields.symbols = static_private_sym
dotnet_naming_rule.static_private_fields.style = static_private_style
dotnet_naming_rule.static_private_fields.severity = error
dotnet_naming_symbols.static_private_sym.applicable_kinds = field
dotnet_naming_symbols.static_private_sym.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.static_private_sym.required_modifiers = static
dotnet_naming_style.static_private_style.required_prefix = s_
dotnet_naming_style.static_private_style.capitalization = camel_case

# 5.3 Приватные поля экземпляра: _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields_sym
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_symbols.private_fields_sym.applicable_kinds = field
dotnet_naming_symbols.private_fields_sym.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# 5.4 Интерфейсы: IPascalCase
dotnet_naming_rule.interfaces_prefix_i.symbols = interface_sym
dotnet_naming_rule.interfaces_prefix_i.style = interface_style
dotnet_naming_rule.interfaces_prefix_i.severity = error
dotnet_naming_symbols.interface_sym.applicable_kinds = interface
dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

# 5.5 Параметры обобщённых типов (Generics): TPascalCase
dotnet_naming_rule.type_parameters.symbols = type_params_sym
dotnet_naming_rule.type_parameters.style = type_param_style
dotnet_naming_rule.type_parameters.severity = error
dotnet_naming_symbols.type_params_sym.applicable_kinds = type_parameter
dotnet_naming_style.type_param_style.required_prefix = T
dotnet_naming_style.type_param_style.capitalization = pascal_case

# 5.6 Асинхронные методы: PascalCaseAsync
dotnet_naming_rule.async_methods_suffix.symbols = async_methods_sym
dotnet_naming_rule.async_methods_suffix.style = async_style
dotnet_naming_rule.async_methods_suffix.severity = warning
dotnet_naming_symbols.async_methods_sym.applicable_kinds = method
dotnet_naming_symbols.async_methods_sym.required_modifiers = async
dotnet_naming_style.async_style.required_suffix = Async
dotnet_naming_style.async_style.capitalization = pascal_case

# 5.7 Публичные, внутренние и защищённые члены: PascalCase
dotnet_naming_rule.public_members_pascal.symbols = public_members_sym
dotnet_naming_rule.public_members_pascal.style = pascal_case_style
dotnet_naming_rule.public_members_pascal.severity = error
dotnet_naming_symbols.public_members_sym.applicable_kinds = class, struct, record, enum, property, method, event, delegate, field
dotnet_naming_symbols.public_members_sym.applicable_accessibilities = public, internal, protected, protected_internal
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# 5.8 Локальные переменные и параметры: camelCase
dotnet_naming_rule.locals_camel.symbols = locals_sym
dotnet_naming_rule.locals_camel.style = camel_case_style
dotnet_naming_rule.locals_camel.severity = warning
dotnet_naming_symbols.locals_sym.applicable_kinds = parameter, local
dotnet_naming_style.camel_case_style.capitalization = camel_case

# ==============================================================================
# ИСКЛЮЧЕНИЯ ПО ПУТЯМ (Миграции БД, Win32 Interop, Тесты и Бенчмарки)
# ==============================================================================
[**/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[**/*Win32*.cs]
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1712.severity = none
dotnet_diagnostic.SYSLIB1092.severity = none
dotnet_diagnostic.SYSLIB1095.severity = none

[**/*Tests*/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.IDE0060.severity = suggestion
dotnet_diagnostic.RS0030.severity = warning

[**/*Benchmarks*/**.cs]
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA2007.severity = none
