root = true

# ==============================================================================
# ОБЩИЕ ПРАВИЛА ФОРМАТИРОВАНИЯ ДЛЯ ВСЕХ ФАЙЛОВ
# ==============================================================================
[*]
indent_style                  = space
indent_size                   = 4
tab_width                     = 4
end_of_line                   = crlf
charset                       = utf-8
trim_trailing_whitespace      = true
insert_final_newline          = true
max_line_length               = 140

# ==============================================================================
# ВЕБ И РАЗМЕТКА (Razor, HTML, CSS, JS, TS)
# ==============================================================================
[*.{razor,html,htm,css,scss,js,ts,jsx,tsx}]
indent_size                   = 4
indent_style                  = space
tab_width                     = 4
trim_trailing_whitespace      = true
insert_final_newline          = true
max_line_length               = 140

[*.{razor,html,htm}]
html_attribute_quotes                    = double
html_tag_case                            = lower
html_attribute_case                      = lower
html_space_before_self_closing_slash     = true

[*.razor]
csharp_indent_block_contents             = true
csharp_indent_braces                     = false
csharp_indent_case_contents              = true
csharp_indent_case_contents_when_block   = true
csharp_indent_switch_labels              = true
csharp_indent_labels                     = flush_left
csharp_new_line_before_open_brace        = all
csharp_new_line_before_else              = true
csharp_new_line_before_catch             = true
csharp_new_line_before_finally           = true

# ==============================================================================
# ДОКУМЕНТАЦИЯ И ТЕКСТОВЫЕ ФАЙЛЫ
# ==============================================================================
[*.{md,txt}]
trim_trailing_whitespace      = false

# ==============================================================================
# СТРУКТУРИРОВАННЫЕ ДАННЫЕ (JSON)
# ==============================================================================
[*.json]
indent_size                   = 2
indent_style                  = space
charset                       = utf-8
trim_trailing_whitespace      = true
insert_final_newline          = true

# ==============================================================================
# СТРУКТУРИРОВАННЫЕ ДАННЫЕ (YAML / YML, GITHUB ACTIONS & CONFIGS)
# ==============================================================================
[*.{yml,yaml}]
indent_style                  = space
indent_size                   = 2
tab_width                     = 2
end_of_line                   = lf
charset                       = utf-8
trim_trailing_whitespace      = true
insert_final_newline          = true
max_line_length               = 140

[.github/**/*.{yml,yaml}]
indent_style                  = space
indent_size                   = 2
tab_width                     = 2
end_of_line                   = lf
charset                       = utf-8
trim_trailing_whitespace      = true
insert_final_newline          = true
max_line_length               = 140

# ==============================================================================
# ПРОЕКТНЫЕ ФАЙЛЫ MSBUILD И XML
# ==============================================================================
[*.{xml,csproj,props,targets,resx}]
indent_size                   = 2
indent_style                  = space
dotnet_diagnostic.NU1605.severity = error
dotnet_diagnostic.NU1507.severity = error
build_check.BC0102.severity       = none
dotnet_diagnostic.BC0102.severity = none
build_check.BC0201.severity       = none
dotnet_diagnostic.BC0201.severity = none
build_check.BC0202.severity       = none
dotnet_diagnostic.BC0202.severity = none

# ==============================================================================
# ИНТЕРФЕЙСНЫЕ ФАЙЛЫ XAML И AVALONIA
# ==============================================================================
[*.{xaml,axaml}]
indent_size                              = 4
indent_style                             = space
tab_width                                = 4
trim_trailing_whitespace                 = true
insert_final_newline                     = true
xaml_attribute_multi_line_threshold      = 2
xaml_attribute_formatting_rule           = always_on_new_line_if_more_than_threshold
xaml_put_ending_bracket_on_new_line      = false
xaml_sort_attributes                     = true
xaml_collapse_empty_tags                 = true
xaml_space_inside_markup_extension       = false
xaml_space_before_self_closing_slash     = true

[*.xaml.cs]
dotnet_naming_rule.ban_public_pages.symbols               = public_classes_sym
dotnet_naming_rule.ban_public_pages.style                 = banned_public_style
dotnet_naming_rule.ban_public_pages.severity              = error
dotnet_naming_symbols.public_classes_sym.applicable_kinds = class
dotnet_naming_symbols.public_classes_sym.applicable_accessibilities = public
dotnet_naming_style.banned_public_style.capitalization    = pascal_case

# ==============================================================================
# ИСКЛЮЧЕНИЯ: СГЕНЕРИРОВАННЫЙ КОД И СТОРОННИЕ БИБЛИОТЕКИ
# ==============================================================================
[wwwroot/monaco/**.{js,css,html}]
generated_code = true

[**/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CA1861.severity   = none

# Исключения для P/Invoke Win32 структур (требуются точные имена Win32 API)
[**/*Win32*.cs]
dotnet_diagnostic.IDE1006.severity     = none
dotnet_diagnostic.CA1707.severity      = none
dotnet_diagnostic.CA1712.severity      = none
dotnet_diagnostic.SYSLIB1092.severity  = none
dotnet_diagnostic.SYSLIB1095.severity  = none

[**Pages/**.cs]
dotnet_diagnostic.IDE0040.severity     = error
dotnet_diagnostic.IDE0044.severity     = error

[**Tests/**.cs]
dotnet_diagnostic.CA1822.severity      = suggestion
dotnet_diagnostic.IDE0060.severity     = suggestion

# ==============================================================================
# ПРАВИЛА ДЛЯ C# (C# 14 / .NET 10)
# ==============================================================================
[*.cs]

# ------------------------------------------------------------------------------
# 1. ФОРМАТИРОВАНИЕ И ОТСТУПЫ C#
# ------------------------------------------------------------------------------
csharp_indent_case_contents                = true
csharp_indent_switch_labels                = true
csharp_indent_labels                       = flush_left
csharp_indent_block_contents               = true
csharp_indent_braces                       = false
csharp_indent_case_contents_when_block     = true
csharp_preserve_single_line_statements     = false
csharp_preserve_single_line_blocks         = true

# Переносы строк (Allman Style)
csharp_new_line_before_open_brace                      = all
csharp_new_line_before_else                            = true
csharp_new_line_before_catch                           = true
csharp_new_line_before_finally                         = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types     = true
csharp_new_line_between_query_expression_clauses      = true

# Пробелы
csharp_space_after_cast                                                = false
csharp_space_after_comma                                               = true
csharp_space_after_dot                                                 = false
csharp_space_after_keywords_in_control_flow_statements                 = true
csharp_space_after_semicolon_in_for_statement                          = true
csharp_space_around_binary_operators                                   = before_and_after
csharp_space_around_declaration_statements                             = false
csharp_space_before_colon_in_inheritance_clause                        = true
csharp_space_after_colon_in_inheritance_clause                         = true
csharp_space_before_comma                                              = false
csharp_space_before_dot                                                = false
csharp_space_before_open_square_brackets                               = false
csharp_space_before_semicolon_in_for_statement                         = false
csharp_space_between_empty_square_brackets                             = false
csharp_space_between_method_call_empty_parameter_list_parentheses       = false
csharp_space_between_method_call_name_and_opening_parenthesis           = false
csharp_space_between_method_call_parameter_list_parentheses             = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses= false
csharp_space_between_method_declaration_name_and_open_parenthesis       = false
csharp_space_between_method_declaration_parameter_list_parentheses     = false
csharp_space_between_parentheses                                       = false
csharp_space_between_square_brackets                                   = false

# Директивы using
dotnet_sort_system_directives_first        = true
dotnet_separate_import_directive_groups    = false

# ------------------------------------------------------------------------------
# 2. СОВРЕМЕННЫЙ СИНТАКСИС C# 14 / .NET 10 (ЯЗЫКОВЫЕ ПРАВИЛА)
# ------------------------------------------------------------------------------
# File-scoped namespaces и фигурные скобки
csharp_style_namespace_declarations                    = file_scoped:error
csharp_prefer_braces                                   = true:error
csharp_prefer_simple_using_statement                   = true:error

# Использование var
csharp_style_var_when_type_is_apparent                 = true:error
csharp_style_var_for_built_in_types                    = true:error
csharp_style_var_elsewhere                             = true:error

# Первичные конструкторы и выражения коллекций (Primary Constructors & Collection Expressions)
csharp_style_prefer_primary_constructors               = true:error
csharp_style_prefer_collection_expression              = true:error

# Expression-bodied члены
csharp_style_expression_bodied_methods                 = when_on_single_line:error
csharp_style_expression_bodied_constructors            = when_on_single_line:error
csharp_style_expression_bodied_operators               = when_on_single_line:error
csharp_style_expression_bodied_properties              = true:error
csharp_style_expression_bodied_accessors               = true:error
csharp_style_expression_bodied_indexers                = true:error
csharp_style_expression_bodied_lambdas                 = true:error
csharp_style_expression_bodied_local_functions         = when_on_single_line:error

# Сопоставление с образцом (Pattern Matching)
csharp_style_prefer_pattern_matching                   = true:error
csharp_style_prefer_not_pattern                        = true:error
csharp_style_prefer_switch_expression                  = true:error
csharp_style_prefer_extended_property_pattern          = true:error
csharp_style_prefer_null_check_over_type_check         = true:error
csharp_style_pattern_matching_over_as_with_null_check  = true:error
csharp_style_pattern_matching_over_is_with_cast_check  = true:error

# Null-операторы и присваивания
dotnet_style_null_propagation                          = true:error
dotnet_style_coalesce_expression                       = true:error
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
csharp_style_throw_expression                          = true:error
csharp_style_prefer_tuple_swap                         = true:error
dotnet_style_prefer_auto_properties                    = true:error
dotnet_style_prefer_compound_assignment                = true:error
dotnet_style_prefer_simplified_boolean_expressions     = true:error
dotnet_style_prefer_simplified_interpolation           = true:error

# Функции, срезы, UTF-8 литералы и структуры
csharp_style_prefer_local_over_anonymous_function      = true:error
csharp_style_prefer_index_operator                     = true:error
csharp_style_prefer_range_operator                     = true:error
csharp_style_prefer_utf8_string_literals               = true:error
csharp_style_prefer_readonly_struct                    = true:error
csharp_style_prefer_readonly_struct_member             = true:error
csharp_style_prefer_method_group_conversion            = true:error
csharp_style_inlined_variable_declaration              = true:error
csharp_style_deconstructed_variable_declaration        = true:error
csharp_style_unused_value_assignment_preference        = discard_variable:error
csharp_style_unused_value_expression_statement_preference = discard_variable:error

# Квалификация доступа и инициализаторы
dotnet_style_qualification_for_field                   = false:error
dotnet_style_qualification_for_property                = false:error
dotnet_style_qualification_for_method                  = false:error
dotnet_style_qualification_for_event                   = false:error
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access         = true:error
dotnet_style_object_initializer                        = true:error
dotnet_style_collection_initializer                    = true:error
dotnet_style_explicit_tuple_names                      = true:error
dotnet_style_prefer_inferred_tuple_names               = true:error
dotnet_style_prefer_inferred_anonymous_type_member_names= true:error
dotnet_style_readonly_field                            = true:error
dotnet_style_require_accessibility_modifiers           = always:error

# Порядок модификаторов
csharp_preferred_modifier_order = public, private, protected, internal, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, volatile, async:error

# ------------------------------------------------------------------------------
# 3. СТРОГИЕ СОГЛАШЕНИЯ ОБ ИМЕНОВАНИИ MICROSOFT & NET 10
# ------------------------------------------------------------------------------
# Приватные поля экземпляра: _camelCase
dotnet_naming_rule.private_fields_underscore.symbols               = private_fields_sym
dotnet_naming_rule.private_fields_underscore.style                 = underscore_camel_style
dotnet_naming_rule.private_fields_underscore.severity              = error
dotnet_naming_symbols.private_fields_sym.applicable_kinds          = field
dotnet_naming_symbols.private_fields_sym.applicable_accessibilities= private, private_protected
dotnet_naming_style.underscore_camel_style.required_prefix         = _
dotnet_naming_style.underscore_camel_style.capitalization          = camel_case

# Статичные приватные поля: s_camelCase
dotnet_naming_rule.static_private_fields.symbols                   = static_private_sym
dotnet_naming_rule.static_private_fields.style                     = static_private_style
dotnet_naming_rule.static_private_fields.severity                  = error
dotnet_naming_symbols.static_private_sym.applicable_kinds          = field
dotnet_naming_symbols.static_private_sym.applicable_accessibilities= private, private_protected
dotnet_naming_symbols.static_private_sym.required_modifiers        = static
dotnet_naming_style.static_private_style.required_prefix           = s_
dotnet_naming_style.static_private_style.capitalization            = camel_case

# Интерфейсы: I + PascalCase
dotnet_naming_rule.interfaces_prefix_i.symbols                     = interface_sym
dotnet_naming_rule.interfaces_prefix_i.style                       = interface_style
dotnet_naming_rule.interfaces_prefix_i.severity                    = error
dotnet_naming_symbols.interface_sym.applicable_kinds               = interface
dotnet_naming_style.interface_style.required_prefix                = I
dotnet_naming_style.interface_style.capitalization                 = pascal_case

# Параметры типов (Generics): T + PascalCase
dotnet_naming_rule.type_parameters.symbols                         = type_params_sym
dotnet_naming_rule.type_parameters.style                           = type_param_style
dotnet_naming_rule.type_parameters.severity                        = error
dotnet_naming_symbols.type_params_sym.applicable_kinds             = type_parameter
dotnet_naming_style.type_param_style.required_prefix               = T
dotnet_naming_style.type_param_style.capitalization                = pascal_case

# Константы: PascalCase
dotnet_naming_rule.constants_pascal.symbols                        = constants_sym
dotnet_naming_rule.constants_pascal.style                          = pascal_case_style
dotnet_naming_rule.constants_pascal.severity                       = error
dotnet_naming_symbols.constants_sym.applicable_kinds               = field
dotnet_naming_symbols.constants_sym.required_modifiers             = const
dotnet_naming_style.pascal_case_style.capitalization               = pascal_case

# Публичные и защищенные члены: PascalCase
dotnet_naming_rule.public_members_pascal.symbols                   = public_members_sym
dotnet_naming_rule.public_members_pascal.style                     = pascal_case_style
dotnet_naming_rule.public_members_pascal.severity                  = error
dotnet_naming_symbols.public_members_sym.applicable_kinds          = class, struct, record, enum, property, method, event, delegate, field
dotnet_naming_symbols.public_members_sym.applicable_accessibilities= public, internal, protected, protected_internal

# Асинхронные методы: суффикс Async + PascalCase
dotnet_naming_rule.async_methods_suffix.symbols                    = async_methods_sym
dotnet_naming_rule.async_methods_suffix.style                      = async_style
dotnet_naming_rule.async_methods_suffix.severity                   = error
dotnet_naming_symbols.async_methods_sym.applicable_kinds           = method
dotnet_naming_symbols.async_methods_sym.required_modifiers         = async
dotnet_naming_style.async_style.required_suffix                    = Async
dotnet_naming_style.async_style.capitalization                     = pascal_case

# Локальные переменные и параметры: camelCase
dotnet_naming_rule.locals_camel.symbols                            = locals_sym
dotnet_naming_rule.locals_camel.style                              = camel_case_style
dotnet_naming_rule.locals_camel.severity                           = error
dotnet_naming_symbols.locals_sym.applicable_kinds                  = parameter, local
dotnet_naming_style.camel_case_style.capitalization                = camel_case

# ------------------------------------------------------------------------------
# 4. ОБЩИЕ КАТЕГОРИИ АНАЛИЗАТОРОВ (ROSLYN DIAGNOSTICS)
# ------------------------------------------------------------------------------
dotnet_analyzer_diagnostic.severity                                = warning
dotnet_analyzer_diagnostic.category-Performance.severity           = error
dotnet_analyzer_diagnostic.category-Reliability.severity           = error
dotnet_analyzer_diagnostic.category-Security.severity              = error

# ------------------------------------------------------------------------------
# 5. СТИЛЬ КОДА И СОВРЕМЕННЫЙ СИНТАКСИС (IDE-ДИАГНОСТИКИ)
# ------------------------------------------------------------------------------
dotnet_diagnostic.IDE0001.severity = error     # Упрости имя типа
dotnet_diagnostic.IDE0002.severity = error     # Упрости доступ к члену
dotnet_diagnostic.IDE0003.severity = error     # Удали лишнюю квалификацию this/base
dotnet_diagnostic.IDE0004.severity = error     # Удали ненужное приведение типов
dotnet_diagnostic.IDE0005.severity = none      # Неиспользуемые using (компилятор/форматтер очищает сам)
dotnet_diagnostic.IDE0007.severity = error     # Использовать var
dotnet_diagnostic.IDE0008.severity = none      # Не форсировать явные типы вместо var
dotnet_diagnostic.IDE0010.severity = warning   # Заполни case в switch
dotnet_diagnostic.IDE0011.severity = error     # Добавь фигурные скобки
dotnet_diagnostic.IDE0017.severity = error     # Упрости инициализацию объекта
dotnet_diagnostic.IDE0018.severity = error     # Объяви переменную по месту (inline out var)
dotnet_diagnostic.IDE0019.severity = error     # Используй pattern matching вместо 'as' + null check
dotnet_diagnostic.IDE0020.severity = error     # Используй pattern matching вместо 'is' + cast
dotnet_diagnostic.IDE0021.severity = error     # Expression body для конструкторов
dotnet_diagnostic.IDE0022.severity = error     # Expression body для методов
dotnet_diagnostic.IDE0023.severity = error     # Expression body для операторов приведения
dotnet_diagnostic.IDE0024.severity = error     # Expression body для операторов
dotnet_diagnostic.IDE0025.severity = error     # Expression body для свойств
dotnet_diagnostic.IDE0026.severity = error     # Expression body для индексеров
dotnet_diagnostic.IDE0027.severity = error     # Expression body для аксессоров
dotnet_diagnostic.IDE0028.severity = error     # Упрости инициализацию коллекции
dotnet_diagnostic.IDE0029.severity = error     # Используй ?? вместо ternar null check
dotnet_diagnostic.IDE0030.severity = error     # Используй ?? вместо ternar null check для nullable
dotnet_diagnostic.IDE0031.severity = error     # Используй null propagation (?.)
dotnet_diagnostic.IDE0032.severity = error     # Используй авто-свойство
dotnet_diagnostic.IDE0034.severity = error     # Упрости выражение 'default'
dotnet_diagnostic.IDE0036.severity = error     # Соблюдай порядок модификаторов
dotnet_diagnostic.IDE0037.severity = error     # Используй выводимое имя кортежа
dotnet_diagnostic.IDE0038.severity = error     # Используй pattern matching для проверки типа
dotnet_diagnostic.IDE0039.severity = error     # Используй локальную функцию вместо делегата/лямбды
dotnet_diagnostic.IDE0040.severity = error     # Всегда указывай модификаторы доступа
dotnet_diagnostic.IDE0041.severity = error     # Используй 'is null' вместо '== null'
dotnet_diagnostic.IDE0042.severity = error     # Деконструируй объявление переменной
dotnet_diagnostic.IDE0044.severity = error     # Сделай поле readonly
dotnet_diagnostic.IDE0045.severity = error     # Используй тернарный оператор для присваивания
dotnet_diagnostic.IDE0046.severity = error     # Используй тернарный оператор для возврата
dotnet_diagnostic.IDE0047.severity = warning   # Удали лишние скобки
dotnet_diagnostic.IDE0048.severity = warning   # Добавь скобки для ясности приоритета
dotnet_diagnostic.IDE0051.severity = error     # Удали неиспользуемые приватные члены
dotnet_diagnostic.IDE0052.severity = error     # Удали непрочитанные приватные члены
dotnet_diagnostic.IDE0053.severity = error     # Expression body для лямбд
dotnet_diagnostic.IDE0054.severity = error     # Используй составное присваивание (+=, -=)
dotnet_diagnostic.IDE0056.severity = error     # Используй оператор индекса с конца (^1)
dotnet_diagnostic.IDE0057.severity = error     # Используй оператор диапазона (..)
dotnet_diagnostic.IDE0058.severity = warning   # Значение выражения никогда не используется
dotnet_diagnostic.IDE0059.severity = error     # Бесполезное присваивание значения переменной
dotnet_diagnostic.IDE0060.severity = warning   # Неиспользуемый параметр метода
dotnet_diagnostic.IDE0061.severity = error     # Expression body для локальных функций
dotnet_diagnostic.IDE0062.severity = error     # Сделай локальную функцию static
dotnet_diagnostic.IDE0063.severity = error     # Используй простой using statement (using var)
dotnet_diagnostic.IDE0065.severity = error     # Директивы using обязаны быть в начале файла
dotnet_diagnostic.IDE0066.severity = error     # Используй switch expression вместо switch statement
dotnet_diagnostic.IDE0070.severity = error     # Используй HashCode.Combine
dotnet_diagnostic.IDE0071.severity = error     # Упрости интерполяцию строк
dotnet_diagnostic.IDE0072.severity = warning   # Заполни ветви switch expression
dotnet_diagnostic.IDE0073.severity = none      # Заголовок файла не требуется
dotnet_diagnostic.IDE0074.severity = error     # Используй составное coalesce присваивание (??=)
dotnet_diagnostic.IDE0075.severity = error     # Упрости условное выражение
dotnet_diagnostic.IDE0078.severity = error     # Используй pattern matching
dotnet_diagnostic.IDE0079.severity = error     # Удали неиспользуемые директивы подавления #pragma
dotnet_diagnostic.IDE0080.severity = error     # Удали лишний оператор подавления '!'
dotnet_diagnostic.IDE0082.severity = error     # Преобразуй 'typeof' в 'nameof'
dotnet_diagnostic.IDE0083.severity = error     # Используй pattern 'not'
dotnet_diagnostic.IDE0090.severity = error     # Упрости 'new' выражение (target-typed new)
dotnet_diagnostic.IDE0100.severity = error     # Удали избыточную проверку равенства
dotnet_diagnostic.IDE0110.severity = error     # Удали избыточный логический оператор
dotnet_diagnostic.IDE0120.severity = error     # Упрости LINQ-выражение
dotnet_diagnostic.IDE0130.severity = none      # Пространство имен не обязано совпадать с папкой
dotnet_diagnostic.IDE0150.severity = error     # Предпочти проверку 'null' проверке типа
dotnet_diagnostic.IDE0160.severity = error     # Используй file-scoped namespace
dotnet_diagnostic.IDE0161.severity = none      # Не использовать block-scoped namespace
dotnet_diagnostic.IDE0170.severity = error     # Используй pattern свойства
dotnet_diagnostic.IDE0180.severity = error     # Используй кортеж для обмена значений (a, b) = (b, a)
dotnet_diagnostic.IDE0200.severity = error     # Удали избыточное лямбда-выражение
dotnet_diagnostic.IDE0220.severity = warning   # Добавь явное приведение типов в foreach
dotnet_diagnostic.IDE0230.severity = error     # Используй UTF-8 строковый литерал (u8)
